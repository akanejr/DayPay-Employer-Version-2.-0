+.dp-rem-dont { margin-top: var(--gap-stack); font-size: var(--fs-body); line-height: var(--lh-row); color: var(--text-4); text-align: center; }
+
+/* ============================================================
+   PHASE 5 — the worker's workplace record (read-only view mode)
+   ------------------------------------------------------------
+   The banner is the honest version of a locked door: the calendar
+   for a linked worker shows the employer's verified days and cannot
+   be tapped into, so the reason is stated where the tapping would
+   have happened rather than discovered by a dead button.
+   ============================================================ */
+.wp-banner {
+  margin: var(--sp-4) var(--sp-4) 0;
+  padding: var(--sp-3) var(--sp-4);
+  border: 1px solid var(--border);
+  border-left: 3px solid var(--daypay-green);
+  border-radius: var(--radius);
+  background: var(--green-wash);
+  display: flex; flex-direction: column; gap: var(--sp-2);
+}
+.wp-banner-top { display: flex; align-items: center; gap: var(--sp-2); }
+.wp-banner-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--daypay-green); flex: none; }
+.wp-banner-title { font-size: var(--fs-sm); font-weight: 600; color: var(--text); letter-spacing: -0.01em; }
+.wp-banner-chip {
+  margin-left: auto; flex: none;
+  font-size: var(--fs-2xs); font-weight: 600; color: var(--green-ink);
+  background: var(--bg); border: 1px solid var(--border);
+  border-radius: 999px; padding: 2px var(--sp-2);
+}
+.wp-banner-chip-err { color: var(--danger); }
+.wp-banner-body { margin: 0; font-size: var(--fs-xs); font-weight: 500; color: var(--text-2); line-height: var(--lh-body); }
+.wp-banner-actions { display: flex; align-items: center; gap: var(--sp-3); flex-wrap: wrap; }
+.wp-banner-btn {
+  border: 0; border-radius: 9px; padding: var(--sp-2) var(--sp-3);
+  font-family: var(--font-sans); font-weight: 600;
+  font-size: var(--fs-xs); background: var(--green-ink); color: var(--bg); cursor: pointer;
+  transition: filter 0.13s ease;
+}
+.wp-banner-btn:hover { filter: brightness(1.08); }
+.wp-banner-note { font-size: var(--fs-2xs); font-weight: 600; color: var(--amber); }
+.wp-banner-kept {
+  margin: 0; padding-top: var(--sp-2);
+  border-top: 1px dashed var(--border);
+  font-size: var(--fs-2xs); font-weight: 500; color: var(--text-3); line-height: var(--lh-body);
+}
+
+/* A record that could not be loaded is not an empty record. It gets a card
+   that says which, and a way to try again. */
+.wp-fail {
+  margin: var(--sp-4) var(--sp-4) 0;
+  padding: var(--sp-4);
+  border: 1px solid var(--border-strong); border-radius: var(--radius);
+  background: var(--bg-elevated-2);
+  display: flex; flex-direction: column; gap: var(--sp-2); align-items: flex-start;
+}
+.wp-fail-quiet { align-items: center; text-align: center; }
+.wp-fail-title { font-size: var(--fs-sm); font-weight: 600; color: var(--text); }
+.wp-fail-body { margin: 0; font-size: var(--fs-xs); font-weight: 500; color: var(--text-3); line-height: var(--lh-body); }
+
+/* A day the worker has recorded but the employer has not yet confirmed: the
+   difference between "written down" and "agreed", visible without opening
+   anything. */
+.cell.is-unconfirmed { box-shadow: inset 0 0 0 1px var(--amber); }
+
+[data-glass="on"] .wp-banner { -webkit-backdrop-filter: blur(20px) saturate(160%); backdrop-filter: blur(20px) saturate(160%); }
+
+/* ── The app-level crash screen ──────────────────────────────────────────────
+   Shown by AppErrorBoundary when a render throws and React can no longer draw
+   the tree. It lives in this file, not employer.css, because main.jsx imports
+   this sheet before anything else: an employee who never opens the employer
+   workspace still gets a styled screen rather than bare HTML.
+
+   Same tokens as the rest of the app, so it follows the theme into dark mode
+   instead of being the one white page in a dark product. */
+.dp-crash {
+  min-height: 100dvh;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: var(--sp-5);
+  background: var(--bg-sunken);
+}
+.dp-crash-card {
+  width: 100%;
+  max-width: 480px;
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-top: 3px solid var(--danger);
+  border-radius: var(--radius);
+  padding: var(--sp-5);
+  box-shadow: var(--shadow, 0 8px 28px rgba(11, 27, 50, 0.10));
+}
+.dp-crash-mark {
+  width: 32px; height: 32px;
+  border-radius: 50%;
+  background: var(--danger);
+  color: #ffffff;
+  font-weight: 600;
+  font-size: var(--fs-md);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  margin-bottom: var(--sp-3);
+}
+.dp-crash-title {
+  margin: 0 0 var(--sp-2);
+  font-size: var(--fs-lg);
+  font-weight: 700;
+  color: var(--text);
+  letter-spacing: -0.01em;
+}
+.dp-crash-body {
+  margin: 0 0 var(--sp-4);
+  font-size: var(--fs-sm);
+  line-height: var(--lh-body);
+  color: var(--text-2);
+}
+.dp-crash-detail {
+  margin: 0 0 var(--sp-4);
+  padding: var(--sp-3);
+  background: var(--bg-sunken);
+  border: 1px solid var(--border-light);
+  border-radius: 10px;
+  font-family: var(--font-mono);
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-2);
+  white-space: pre-wrap;
+  word-break: break-word;
+  max-height: 180px;
+  overflow: auto;
+}
+.dp-crash-actions {
+  display: flex;
+  gap: var(--sp-3);
+  margin-bottom: var(--sp-3);
+}
+/* .btn-primary and .btn-secondary are flex:1 for a modal footer. Here they sit
+   in their own row and should take only the width they need. */
+.dp-crash-actions .btn-primary,
+.dp-crash-actions .btn-secondary { flex: none; padding: 0 var(--sp-5); }
+.dp-crash-hint {
+  margin: 0;
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-3);
+}
+
+/* ── The connector classes ────────────────────────────────────────────────────
+   One step of the spacing scale, applied to one block. They are what replaced the
+   inline `style` margins that had accumulated across the employer and tracker
+   screens: 75 of them, at 4, 5, 6, 7, 8, 9, 10, 11, 12, 14, 16 and 18px. Each is
+   named for its size and defined as the token of that size, so the class list and
+   the scale cannot drift apart, and each old value moved to the NEAREST step of
+   the scale (where a value sat exactly between two, it took the larger — air is
+   safer than a collision, which is the rule the rest of this file follows).
+
+   A zero is not here on purpose: `marginTop: 0` cancels something, which is a
+   statement about a component and not a spacing decision. */
+.dp-mt-4  { margin-top: var(--sp-1); }
+.dp-mt-8  { margin-top: var(--sp-2); }
+.dp-mt-12 { margin-top: var(--sp-3); }
+.dp-mt-16 { margin-top: var(--sp-4); }
+.dp-mt-20 { margin-top: var(--sp-4h); }
+.dp-mb-4  { margin-bottom: var(--sp-1); }
+.dp-mb-8  { margin-bottom: var(--sp-2); }
+.dp-mb-12 { margin-bottom: var(--sp-3); }
+.dp-mb-16 { margin-bottom: var(--sp-4); }
+.dp-mb-20 { margin-bottom: var(--sp-4h); }
+.dp-ml-4  { margin-left: var(--sp-1); }
+.dp-ml-8  { margin-left: var(--sp-2); }
+.dp-mr-8  { margin-right: var(--sp-2); }
+.dp-gap-4  { gap: var(--sp-1); }
+.dp-gap-8  { gap: var(--sp-2); }
+.dp-gap-12 { gap: var(--sp-3); }
