+  font-size: var(--fs-sm); font-weight: 600;
+  text-decoration: underline; text-underline-offset: 3px; cursor: pointer; padding: var(--sp-2) 0 0; text-align: left;
+}
+.link-btn:hover { color: var(--text); }
+
+/* ── Phase 10: the account-type choice ──────────────────────────────────────
+   The first screen a new account sees. Every colour here is a theme variable,
+   so the dark theme needs no second rule — which is the same reason the rest
+   of the app does it this way. */
+.acct-choice { display: grid; gap: var(--sp-3); }
+.acct-card {
+  display: grid; gap: var(--sp-1); text-align: left; width: 100%;
+  padding: var(--sp-4); border-radius: 12px;
+  background: var(--bg-elevated); border: 1px solid var(--border);
+  cursor: pointer; font: inherit; color: inherit;
+  transition: border-color .15s ease, background .15s ease;
+}
+.acct-card:hover { border-color: var(--daypay-green); background: var(--bg-cell-hover); }
+.acct-card:focus-visible { outline: 2px solid var(--daypay-green); outline-offset: 2px; }
+.acct-card-title { font-size: var(--fs-md); font-weight: 600; color: var(--text); }
+.acct-card-sub { font-size: var(--fs-xs); font-weight: 500; color: var(--text-3); line-height: var(--lh-body); }
+.acct-card-next { margin-top: var(--gap-stack); font-size: var(--fs-meta); font-weight: var(--fw-value); line-height: var(--lh-row); letter-spacing: 0.01em; color: var(--green-ink);}
+.acct-chosen { display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-3); margin-bottom: var(--sp-3); }
+.acct-chosen-label { font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.01em; color: var(--green-ink);}
+.acct-changed { padding: 0; }
+.success-banner {
+  padding: var(--sp-3) var(--sp-4); background: var(--green-wash); border: 1px solid var(--border-light);
+  border-radius: 10px; color: var(--green-ink); font-size: var(--fs-sm); font-weight: 500; margin-top: var(--sp-2); line-height: var(--lh-body);
+}
+
+/* welcome row — flattened */
+.welcome-banner {
+  display: flex; align-items: center; gap: var(--sp-3); margin: var(--sp-4) var(--sp-4) 0;
+  padding: 2px 0 var(--sp-4); background: transparent; border: 0;
+  border-bottom: 1px solid var(--border-light);
+  border-radius: 0; box-shadow: none;
+}
+.welcome-avatar {
+  width: 38px; height: 38px; border-radius: 12px; background: var(--daypay-navy); color: #ffffff;
+  display: grid; place-items: center; font-weight: 600; font-size: var(--fs-md); flex: none;
+}
+[data-theme="dark"] .welcome-avatar { background: #EDF1F7; color: var(--daypay-navy); }
+.welcome-text { display: flex; flex-direction: column; gap: var(--gap-stack); min-width: 0; }
+.welcome-name { font-size: var(--fs-md); font-weight: 600; color: var(--text); letter-spacing: -0.01em; }
+.welcome-sub { font-size: var(--fs-xs); color: var(--text-3); font-weight: 500; }
+.spin { width: 12px; height: 12px; border: 2px solid var(--border-strong); border-top-color: var(--text-2); border-radius: 50%; display: inline-block; animation: spin 0.7s linear infinite; }
+@keyframes spin { to { transform: rotate(360deg); } }
+
+/* ---------- hamburger menu ---------- */
+.header-right { position: relative; }
+.hamburger-btn {
+  width: 38px; min-height: var(--tap); border-radius: 10px; position: relative;
+  border: 1px solid transparent; background: transparent;
+  color: var(--text); display: grid; place-items: center;
+  cursor: pointer; transition: all 0.18s;
+}
+.hamburger-btn:hover { background: var(--bg-elevated); border-color: var(--border); }
+.hamburger-btn::after { content: ""; position: absolute; inset: -3px; }
+.hamburger-dropdown {
+  position: absolute;
+  top: calc(100% + 10px);
+  right: 0;
+  width: 248px;
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  box-shadow: var(--shadow-lg);
+  padding: var(--sp-2);
+  z-index: 50;
+}
+/* (dropdownIn retired in v22 — cascade dd-in/dd-out below are the one source) */
+.hamburger-user {
+  display: flex; align-items: center; gap: var(--sp-2);
+  padding: var(--sp-2) var(--sp-3); margin-bottom: var(--sp-1);
+  background: var(--bg); border: 1px solid var(--border-light);
+  border-radius: 10px;
+}
+.hamburger-item {
+  display: flex; align-items: center; gap: var(--sp-3);
+  width: 100%; padding: var(--sp-3) var(--sp-3); border-radius: 9px;
+  border: 0; background: transparent;
+  color: var(--text-2);
+  font-size: var(--fs-sm); font-weight: 500; cursor: pointer;
+  transition: background 0.13s, color 0.13s; text-align: left;
+}
+.hamburger-item:hover { background: var(--bg-elevated-2); color: var(--text); }
+.hamburger-icon { display: grid; place-items: center; color: var(--text-3); }
+.hamburger-item:hover .hamburger-icon { color: var(--text); }
+.hamburger-sync { padding: var(--sp-2) var(--sp-3) var(--sp-1); border-top: 1px solid var(--border-light); margin-top: var(--sp-2); }
+
+/* ---------- splash (structure + timing unchanged) ---------- */
+.daypay-splash {
+  position: fixed;
+  inset: 0;
+  z-index: 9999;
+  background: var(--bg);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  animation: splashFadeOut 0.4s ease 5s forwards;
+}
+/* v23.4 — solo splash: animated logo + wordmark + motto, nothing else.
+   One-shot choreography (~1.4s): the slip settles in, the green peek
+   slides in from behind it, then wordmark and motto rise up — a calm
+   hold for the rest of the 5s. No looping motion. */
+.splash-solo {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: var(--sp-4);
+  padding: var(--sp-5);
+}
+.splash-solo-logo { overflow: visible; }
+.splash-solo-logo .ssq-white,
+.splash-solo-logo .ssq-green { transform-box: fill-box; transform-origin: center; }
+.ssq-white { opacity: 0; animation: ssqIn 440ms cubic-bezier(0.22,1,0.36,1) 80ms forwards; }
+.ssq-green { opacity: 0; animation: ssqPeek 520ms cubic-bezier(0.22,1,0.36,1) 300ms forwards; }
+@keyframes ssqIn {
+  from { opacity: 0; transform: scale(0.88); }
+  to { opacity: 1; transform: scale(1); }
+}
+@keyframes ssqPeek {
+  from { opacity: 0; transform: translate(16px, 16px); }
+  to { opacity: 1; transform: translate(0, 0); }
+}
+.splash-solo-word {
+  font-size: var(--fs-display); font-weight: 800; letter-spacing: -0.02em;
+  opacity: 0; animation: soloUp 460ms cubic-bezier(0.22,1,0.36,1) 700ms forwards;
+}
+.splash-tagline {
+  font-weight: 500; font-size: var(--fs-md);
+  color: var(--text-2);
+  letter-spacing: 0.01em; text-align: center;
+}
+.splash-solo .splash-tagline {
+  opacity: 0; animation: soloUp 460ms cubic-bezier(0.22,1,0.36,1) 920ms forwards;
+}
+@keyframes soloUp {
+  from { opacity: 0; transform: translateY(8px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+@media (prefers-reduced-motion: reduce) {
+  .splash-solo-logo .ssq-white, .splash-solo-logo .ssq-green,
+  .splash-solo-word, .splash-solo .splash-tagline { animation: none; opacity: 1; transform: none; }
+}
+
+/* ---------- small screens ---------- */
+@media (max-width: 380px) {
+  .header { padding: var(--sp-3) var(--sp-4); }
+  .seg-wrap { padding: var(--sp-4) var(--sp-4) 0; }
+  .summary-card, .year-totals { padding-left: var(--sp-4); padding-right: var(--sp-4); }
+  .summary-top, .yt-main { padding: 20px var(--sp-4) var(--sp-4); }
+  .cell { padding: var(--sp-2) var(--sp-1); }
+  .date-num { font-size: var(--fs-xs); }
+  .msb-desc { display: none; }
+}
+
+/* ============================================================
+   ACCESSIBILITY — reduced motion
+   ============================================================ */
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: 0.001s !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.001s !important;
+  }
+  .dp-enter { animation: none; }
+  .daypay-splash { animation: splashFadeOut 0.4s ease 4.6s forwards; }
+}
+
+/* Payday countdown + projection (salaried month tracking) */
+.payday-panel {
+  margin-top: var(--sp-4);
+  padding: var(--sp-4) var(--sp-4) var(--sp-3);
+  background: var(--bg);
+  border: 1px solid var(--border-light);
+  border-radius: var(--radius);
+}
+[data-theme="dark"] .payday-panel { background: var(--bg-sunken); }
+.payday-top { display: grid; grid-template-columns: 1.25fr 1fr; gap: var(--sp-3); }
+.payday-block { display: flex; flex-direction: column; gap: var(--sp-1); min-width: 0; }
+.payday-block + .payday-block { border-left: 1px solid var(--border-light); padding-left: var(--sp-3); }
+.payday-num { font-size: var(--fs-xl); font-weight: 700; letter-spacing: -0.02em; color: var(--text); line-height: var(--lh-tight); white-space: nowrap; }
+.payday-projected { color: var(--green-ink); }
+.payday-cap { font-size: var(--fs-2xs); font-weight: 600; letter-spacing: 0.01em; color: var(--text-3);}
+.payday-hint { margin-top: var(--sp-2); padding-top: var(--sp-2); border-top: 1px solid var(--border-light); font-size: var(--fs-xs); color: var(--text-3); font-weight: 500; }
+@media (max-width: 380px) { .payday-num { font-size: var(--fs-lg); } }
+
+/* Leave & absence — dashed slip = not a worked day; navy = paid, slate = unpaid */
+.stamp-leave::before {
+  width: 13px; height: 13px; left: 50%; top: 50%;
+  transform: translate(-50%,-50%);
+  border: 2px dashed var(--slip-navy);
+  background: var(--slip-paper);
+}
+.stamp-leave.unpaid::before { border-color: var(--text-4); background: transparent; }
+.cell.worked.is-leave .date-num { color: var(--text-2); font-weight: 700; }
+.cell.worked.is-leave-unpaid .date-num { color: var(--text-3); }
+.mini-stamp.lv { background: var(--bg-elevated-2); color: var(--text-2); border: 1px solid var(--border); }
+.mini-stamp.start { background: var(--daypay-navy); color: #FFFFFF; border: 1px solid var(--daypay-navy); }
+.mini-stamp.start::before { background: var(--daypay-green); }
+.mini-stamp.lv::before { border: 1.5px dashed var(--slip-navy); background: transparent; width: 5px; height: 5px; }
+.mini-stamp.lv-u { background: var(--bg-elevated-2); color: var(--text-3); border: 1px solid var(--border); }
+.mini-stamp.lv-u::before { border: 1.5px dashed var(--text-4); background: transparent; width: 5px; height: 5px; }
+.leave-divider { margin: var(--sp-2) 2px 0; font-size: var(--fs-2xs); font-weight: 600; letter-spacing: 0.01em; color: var(--text-3);}
+
+/* ============================================================
+   SHARE PAYSLIP DROPDOWN (WhatsApp + PDF export)
+   ============================================================ */
+.share-dropdown {
+  position: absolute;
+  bottom: calc(100% + var(--sp-2));
+  left: 0;
+  width: 100%;
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  box-shadow: var(--shadow-lg);
+  padding: var(--sp-2);
+  z-index: 50;
+  animation: shareIn 0.22s cubic-bezier(0.16,1,0.3,1);
+}
+@keyframes shareIn {
+  from { opacity: 0; transform: translateY(6px) scale(0.97); }
+  to { opacity: 1; transform: translateY(0) scale(1); }
+}
+.share-option {
+  display: flex; align-items: center; gap: var(--sp-3);
+  width: 100%; padding: var(--sp-3) var(--sp-3); border-radius: 10px;
+  border: 0; background: transparent;
+  color: var(--text-2); font-family: var(--font-sans);
+  font-size: var(--fs-sm); font-weight: 500; cursor: pointer;
+  transition: all 0.15s; text-align: left;
+}
+.share-option:hover { background: var(--bg-elevated-2); color: var(--text); }
+.share-option-icon {
+  width: 34px; height: 34px; border-radius: 9px;
+  display: grid; place-items: center; flex: none;
+}
+.share-option-icon.wa { background: var(--daypay-green-light); color: var(--daypay-green); }
+[data-theme="dark"] .share-option-icon.wa { background: #0C1F14; color: #4ADE80; }
+.share-option-icon.pdf { background: var(--bg-elevated-2); color: var(--daypay-navy); }
+[data-theme="dark"] .share-option-icon.pdf { background: #1a233a; color: #EDF1F7; }
+.share-option-text { display: flex; flex-direction: column; gap: var(--gap-stack); min-width: 0; }
+.share-option-text strong { color: var(--text); font-size: var(--fs-sm); font-weight: 600; }
+.share-option-text em { font-style: normal; font-size: var(--fs-xs); color: var(--text-3); line-height: var(--lh-snug); }
+
+/* ============================================================
+   LEAVE TYPES MANAGER (Settings)
+   ============================================================ */
+.lt-list { display: flex; flex-direction: column; gap: var(--sp-2); margin-top: var(--sp-2); }
+.lt-row { display: flex; align-items: center; gap: var(--sp-2); background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: var(--sp-2) var(--sp-2) var(--sp-2) var(--sp-3); }
+.lt-name { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--text); font-family: var(--font-sans); font-size: var(--fs-sm); font-weight: 500; }
+.lt-name::placeholder { color: var(--text-4); font-weight: 500; }
+.lt-pay { display: flex; align-items: center; gap: var(--sp-1); flex: none; }
+.lt-mode { width: var(--tap); min-height: var(--tap); border-radius: 9px; border: 1px solid var(--border); background: var(--bg-elevated); color: var(--text-3); font-family: var(--font-sans); font-size: var(--fs-sm); font-weight: 600; cursor: pointer; transition: all 0.15s; }
+.lt-mode.on { background: var(--daypay-navy); color: #ffffff; border-color: var(--daypay-navy); }
+[data-theme="dark"] .lt-mode.on { background: #EDF1F7; color: var(--daypay-navy); border-color: #EDF1F7; }
+.lt-value { width: 66px; min-height: var(--tap); border-radius: 9px; border: 1px solid var(--border); background: var(--bg-elevated); color: var(--text); text-align: right; padding: 0 var(--sp-2); font-family: var(--font-sans); font-size: var(--fs-sm); font-weight: 600; font-variant-numeric: tabular-nums; outline: none; }
+.lt-value:focus { border-color: var(--daypay-navy); box-shadow: 0 0 0 3px rgba(11,27,50,0.08); }
+[data-theme="dark"] .lt-value { background: #1a233a; }
+.lt-del { width: var(--tap); height: var(--tap); border-radius: 9px; border: 1px solid transparent; background: transparent; color: var(--text-3); cursor: pointer; display: grid; place-items: center; transition: all 0.15s; }
+.lt-del:hover { color: var(--danger); background: rgba(220,38,38,0.06); border-color: rgba(220,38,38,0.3); }
+.lt-add { width: 100%; min-height: var(--tap); border-radius: 10px; border: 1px dashed var(--border-strong); background: transparent; color: var(--text-3); font-family: var(--font-sans); font-size: var(--fs-sm); font-weight: 600; cursor: pointer; transition: all 0.15s; }
+.lt-add:hover { color: var(--daypay-navy); border-color: var(--daypay-navy); }
+[data-theme="dark"] .lt-add:hover { color: #EDF1F7; }
+
+/* ============================================================
+   SETTINGS PAGE — dedicated screen with grouped cards (v7)
+   ============================================================ */
+.sp-page {
+  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
+  width: 100%; max-width: 480px; margin: 0 auto;
+  min-height: 0; z-index: 900;
+  box-shadow: 0 0 60px rgba(11,27,50,.22);
+  animation: spFullIn 340ms cubic-bezier(0.22,1,0.36,1);
+}
+@keyframes spFullIn {
+  from { transform: translateX(102%); }
+  to { transform: translateX(0); }
+}
+.sp-header {
+  position: sticky; top: 0; z-index: 20;
+  display: flex; align-items: center; gap: var(--sp-3);
+  padding: var(--sp-3) var(--sp-4);
+  border-bottom: 1px solid var(--border-light);
+  background: rgba(255,255,255,0.88);
+  backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
+}
+[data-theme="dark"] .sp-header { background: rgba(8,12,22,0.88); }
+.sp-back {
+  /* 38px was short of the token, and it is the only way out of a category page
+     (Phase 17). */
+  width: var(--tap); height: var(--tap); border-radius: 11px; border: 1px solid var(--border);
+  background: var(--bg-elevated); color: var(--text); cursor: pointer;
+  display: grid; place-items: center; transition: all 0.15s; flex: none;
+}
+.sp-back:hover { border-color: var(--border-strong); }
+.sp-title { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--gap-stack); }
+.sp-title-main { font-size: var(--fs-page); font-weight: var(--fw-value); line-height: var(--lh-title); letter-spacing: -0.02em; color: var(--text); }
+.sp-title-sub { font-family: var(--font-mono); font-size: var(--fs-meta); font-weight: var(--fw-body); line-height: var(--lh-row); letter-spacing: 0.01em; color: var(--text-3);}
+
+.sp-scroll { flex: 1; padding: var(--sp-4) var(--sp-4) var(--sp-2); display: flex; flex-direction: column; gap: var(--sp-3); overflow-y: auto; overscroll-behavior: contain; }
+/* v22 fix: cards must never shrink to fit the scroll area — .sp-card has
+   overflow:hidden (border-radius clipping), which drops their flex min-height
+   to 0, so on short/mobile viewports they squashed instead of scrolling.
+   Keep every section at its natural height; the column scrolls. */
+.sp-scroll > * { flex-shrink: 0; }
+/* A section heading: 13px on the role scale (it was 12), 1.4 leading, and the
+   same 12px above the card it labels as every other section in the product. */
+.sp-section-label { font-family: var(--font-sans); font-size: var(--fs-section); font-weight: var(--fw-value); line-height: var(--lh-row); letter-spacing: 0.01em; color: var(--text-3); margin: var(--sp-4) 2px var(--sp-2); }
+.sp-card { background: var(--bg-elevated); border: 1px solid var(--border-light); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow: hidden; }
+
+/* profile card */
+.sp-profile { display: flex; align-items: center; gap: var(--sp-3); padding: var(--sp-4); }
+.sp-avatar { width: 46px; height: 46px; font-size: var(--fs-lg); flex: none; }
+.sp-avatar-ghost { background: var(--bg-sunken); color: var(--text-3); border: 1px dashed var(--border-strong); display: grid; place-items: center; border-radius: 14px; }
+.sp-profile-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--sp-1); }
+.sp-profile-name { font-size: var(--fs-md); font-weight: 600; color: var(--text); }
+.sp-name-input { border: 0; outline: 0; background: transparent; color: var(--text); font-family: var(--font-sans); font-size: var(--fs-md); font-weight: 600; letter-spacing: -0.01em; padding: 0 0 2px; width: 100%; border-bottom: 1.5px dashed var(--border-strong); }
+.sp-name-input:focus { border-bottom-color: var(--daypay-navy); }
+.sp-email { font-family: var(--font-mono); font-size: var(--fs-2xs); color: var(--text-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+/* Phase 17 — the workplace card's own two lines. The words carry the meaning; the
+   colour only says which of the two it is, and both are text a screen reader
+   announces (role=alert / role=status on the elements that use them). */
+.sp-wp-note { margin: var(--sp-2) 2px 0; font-size: var(--fs-xs); font-weight: 600; line-height: var(--lh-body); }
+.sp-wp-note.is-ok { color: var(--green-ink); }
+.sp-wp-note.is-err { color: var(--danger); }
+
+.sp-save-name { flex: none; min-height: var(--tap); padding: 0 var(--sp-4); border-radius: 9px; border: 1px solid var(--daypay-navy); background: transparent; color: var(--daypay-navy); font-family: var(--font-sans); font-size: var(--fs-xs); font-weight: 600; cursor: pointer; transition: all 0.15s; }
+.sp-save-name:hover:enabled { background: var(--daypay-navy); color: #ffffff; }
+.sp-save-name:disabled { opacity: 0.4; cursor: default; }
+[data-theme="dark"] .sp-save-name { border-color: #EDF1F7; color: #EDF1F7; }
+[data-theme="dark"] .sp-save-name:hover:enabled { background: #EDF1F7; color: var(--daypay-navy); }
+.sp-signin { flex: none; min-height: var(--tap); padding: 0 var(--sp-4); border-radius: 10px; font-size: var(--fs-xs); }
+
+/* icon rows */
+.sp-row { display: flex; align-items: center; gap: var(--sp-3); padding: var(--sp-3) var(--sp-4); }
+.sp-row + .sp-row { border-top: 1px solid var(--border-light); }
+.sp-icon { width: 34px; height: 34px; border-radius: 10px; background: var(--bg-sunken); color: var(--text-2); display: grid; place-items: center; flex: none; }
+.sp-row-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--gap-stack); }
+.sp-row-title { font-size: var(--fs-sm); font-weight: 600; color: var(--text); }
+.sp-row-sub { font-size: var(--fs-xs); font-weight: 500; color: var(--text-3); line-height: var(--lh-snug); }
+.sp-input-wrap { display: flex; align-items: center; gap: var(--sp-1); flex: none; background: var(--bg-sunken); border: 1px solid transparent; border-radius: 10px; padding: var(--sp-2) var(--sp-3); transition: all 0.15s; }
+.sp-input-wrap:focus-within { border-color: var(--daypay-navy); background: var(--bg-elevated); box-shadow: 0 0 0 3px rgba(11,27,50,0.08); }
+[data-theme="dark"] .sp-input-wrap:focus-within { border-color: #7C8AA5; box-shadow: 0 0 0 3px rgba(124,138,165,0.15); }
+.sp-input-prefix { font-size: var(--fs-xs); font-weight: 600; color: var(--text-3); }
+.sp-input { border: 0; outline: 0; background: transparent; width: 86px; text-align: right; font-family: var(--font-mono); font-size: var(--fs-sm); font-weight: 500; color: var(--text); font-variant-numeric: tabular-nums; padding: 0; }
+.sp-input::placeholder { color: var(--text-4); }
+.sp-input-day { padding: var(--sp-2) var(--sp-3); }
+.sp-input-day .sp-input { width: 44px; }
+
+/* key-value rows */
+.sp-kv { display: flex; justify-content: space-between; align-items: center; gap: var(--sp-3); padding: var(--pad-row-y) var(--pad-row-x); font-size: var(--fs-row); font-weight: var(--fw-body); line-height: var(--lh-row); color: var(--text-2); }
+.sp-kv + .sp-kv { border-top: 1px solid var(--border-light); }
+.sp-kv-val { font-family: var(--font-mono); font-size: var(--fs-xs); font-weight: 500; color: var(--text); text-align: right; }
+
+/* leave card */
+.sp-lt-card { padding: var(--sp-4); }
+.sp-lt-card .lt-list { margin-top: 0; }
+
+.sp-hint { margin: -2px 2px 0; font-size: var(--fs-xs); line-height: var(--lh-body); color: var(--text-3); font-weight: 500; }
+.sp-notes { display: flex; flex-direction: column; gap: var(--sp-1); padding: 2px var(--sp-1) 0; font-size: var(--fs-xs); font-weight: 500; color: var(--text-3); line-height: var(--lh-body); }
+.sp-storage { text-align: center; font-family: var(--font-mono); font-size: var(--fs-2xs); font-weight: 500; color: var(--text-4); letter-spacing: 0.02em; line-height: var(--lh-body); padding: var(--sp-3) var(--sp-2) var(--sp-1); }
+
+/* sticky save bar */
+.sp-savebar {
+  position: sticky; bottom: 0; z-index: 20;
+  display: flex; align-items: center; gap: var(--sp-3);
+  padding: var(--sp-3) var(--sp-4) calc(var(--sp-3) + env(safe-area-inset-bottom, 0px));
+  border-top: 1px solid var(--border-light);
+  background: rgba(255,255,255,0.92);
+  backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
+}
+[data-theme="dark"] .sp-savebar { background: rgba(8,12,22,0.9); }
+.sp-savebar-note { flex: 1; font-family: var(--font-mono); font-size: var(--fs-2xs); font-weight: 500; letter-spacing: 0.01em; color: var(--text-3);}
+.sp-save-btn { flex: none; min-height: var(--tap); padding: 0 var(--sp-5); border-radius: 12px; font-size: var(--fs-sm); }
+
+/* ============================================================
+   MONTH-SO-FAR (v9) — trimmed grid + future-day logging
+   ============================================================ */
+.future-log-btn {
+  margin-top: var(--sp-2); width: 100%; min-height: var(--tap); border-radius: 12px;
+  border: 1.5px dashed var(--border-strong); background: transparent; color: var(--text-3);
+  font-family: var(--font-sans); font-size: var(--fs-sm); font-weight: 600; cursor: pointer;
+  display: flex; align-items: center; justify-content: center; gap: var(--sp-2); transition: all 0.15s;
+}
+.future-log-btn:hover { color: var(--daypay-navy); border-color: var(--daypay-navy); }
+[data-theme="dark"] .future-log-btn:hover { color: #EDF1F7; border-color: #7C8AA5; }
+.future-log-count { font-family: var(--font-mono); font-size: var(--fs-2xs); color: var(--text-4); letter-spacing: 0.04em; font-weight: 500; }
+
+.future-chips-block {
+  margin-top: var(--sp-2); background: var(--bg-elevated); border: 1px solid var(--border-light);
+  border-radius: var(--radius-lg); padding: var(--sp-3); box-shadow: var(--shadow-sm);
+  animation: dpEnter 0.28s cubic-bezier(0.16,1,0.3,1);
+}
+.future-chips-label { font-family: var(--font-mono); font-size: var(--fs-2xs); font-weight: 500; letter-spacing: 0.01em; color: var(--text-3); margin-bottom: var(--sp-2);}
+.future-chips { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
+.future-chip {
+  width: var(--tap); height: 47px; border-radius: 11px; border: 1px solid var(--border);
+  background: var(--bg); color: var(--text-2); cursor: pointer;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px;
+  transition: all 0.15s;
+}
+.future-chip:hover { border-color: var(--daypay-navy); color: var(--text); background: var(--bg-cell-hover); }
+.future-chip .fc-wd { font-family: var(--font-mono); font-size: var(--fs-2xs); font-weight: 500; color: var(--text-4); }
+.future-chip .fc-num { font-family: var(--font-mono); font-size: var(--fs-sm); font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }
+.future-chip.weekend { border-color: rgba(21,128,61,0.4); background: var(--green-wash); }
+.future-chip.weekend .fc-wd { color: var(--daypay-green); }
+
+.upcoming-note {
+  display: flex; align-items: center; gap: var(--sp-3);
+  background: var(--bg-elevated); border: 1.5px dashed var(--border-strong);
+  border-radius: var(--radius-lg); padding: var(--sp-5) var(--sp-4);
+  color: var(--text-3); font-size: var(--fs-xs); font-weight: 500; line-height: var(--lh-body);
+}
+
+/* ============================================================
+   DayPay motion layer — micro-interactions & success feedback.
+   Visual only: reacts to classes applied by confirmed save
+   paths (dp-just) and the toast system. No layout side effects.
+   ============================================================ */
+
+/* 1 · Cell press — immediate tactile response */
+
+/* 2 · Just-recorded — gentle green wash under the cell */
+.cell.dp-just { animation: dpWash 0.6s ease-out; }
+@keyframes dpWash {
+  0%   { box-shadow: inset 0 0 0 999px var(--green-wash); }
+  100% { box-shadow: inset 0 0 0 999px transparent; }
+}
+
+/* 3 · Slip settles with a restrained spring */
+.cell.dp-just .stamp { animation: dpStampLift 0.5s cubic-bezier(0.34,1.4,0.64,1); }
+@keyframes dpStampLift {
+  0%   { opacity: 0; transform: translateX(-50%) translateY(8px) scale(0.6); }
+  60%  { opacity: 1; transform: translateX(-50%) translateY(-2px) scale(1.05); }
+  100% { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
+}
+
+/* 4 · WEEKEND OT — the green slip peeks out from behind the navy slip */
+.cell.dp-just .stamp-2x::before {
+  animation: dpPeekOut 0.45s cubic-bezier(0.16,1,0.3,1) 0.12s backwards;
+}
+@keyframes dpPeekOut {
+  from { transform: translate(6px, 6px); }  /* tucked behind the front slip */
+  to   { transform: translate(0, 0); }      /* resting peek position */
+}
+
+/* 5 · Weekday OT — subtle green accent on the amber slip */
+.cell.dp-just .stamp-ot::before { animation: dpOtAccent 0.65s ease 0.1s; }
+@keyframes dpOtAccent {
+  0%, 55% { border-color: var(--daypay-green); }
+  100%    { border-color: var(--amber); }
+}
+
+/* 6 · Success cards — drop in under the header, never covering the calendar */
+.dp-toast {
+  position: fixed;
+  top: calc(64px + env(safe-area-inset-top, 0px));
+  left: 50%;
+  transform: translateX(-50%);
+  width: min(calc(100vw - 24px), 456px);
+  display: flex; align-items: center; gap: var(--sp-3);
+  padding: var(--sp-3) var(--sp-4); border-radius: 16px;
+  background: #0B1B32; color: #fff;
+  box-shadow: 0 14px 34px rgba(11,27,50,0.34), inset 0 0 0 1px rgba(255,255,255,0.08);
+  font-family: var(--font-sans);
+  pointer-events: auto; /* v19-B: tap the card to dismiss it early */
+  z-index: 9500;
+  animation: dpToastLife 2600ms cubic-bezier(0.16,1,0.3,1) forwards;
+}
+.dp-toast-weekend { animation-duration: 3000ms; padding: var(--sp-4) var(--sp-5); }
+.dp-toast-month { animation-duration: 4000ms; }
+.dp-toast-text { display: flex; flex-direction: column; gap: var(--gap-stack); min-width: 0; }
+.dp-toast strong { font-size: var(--fs-lg); font-weight: 700; letter-spacing: -0.01em; line-height: var(--lh-tight); }
+.dp-toast em { font-style: normal; font-size: var(--fs-sm); line-height: 1.25; color: #4ADE80; font-variant-numeric: tabular-nums; }
+.dp-toast-weekend strong { color: #4ADE80; font-size: var(--fs-lg); }
+.dp-toast-month strong, .dp-toast-year strong { font-size: var(--fs-lg); }
+@keyframes dpToastLife {
+  0%   { opacity: 0; transform: translateX(-50%) translateY(-10px) scale(0.97); }
+  8%   { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
+  90%  { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
+  100% { opacity: 0; transform: translateX(-50%) translateY(-8px) scale(0.98); }
+}
+
+/* single green slip — simple confirmations (work / OT / holiday / month / year) */
+.dp-toast-slip { width: 12px; height: 12px; border-radius: 3.5px; flex: none; background: #16A34A; }
+
+/* two-slip Peeking Slip glyph — weekend OT only */
+.dp-toast-slips { position: relative; width: 26px; height: 26px; flex: none; }
+.dp-toast-slips::before {
+  content: ''; position: absolute; right: 1px; bottom: 1px;
+  width: 16px; height: 16px; border-radius: 4.5px; background: #16A34A;
+  animation: dpSlipPeek 0.5s cubic-bezier(0.16,1,0.3,1) 0.12s backwards;
+}
+.dp-toast-slips::after {
+  content: ''; position: absolute; left: 1px; top: 1px;
+  width: 16px; height: 16px; border-radius: 4.5px; border: 2.5px solid #fff;
+}
+@keyframes dpSlipPeek {
+  from { transform: translate(6px, 6px); }
+  to   { transform: translate(0, 0); }
+}
+
+/* tiny rising slips — weekend OT only, restrained */
+.dp-toast-sparks { position: absolute; top: -6px; right: 10px; width: 18px; height: 18px; }
+.dp-toast-sparks i {
+  position: absolute; bottom: 0; width: 5px; height: 5px; border-radius: 1.5px;
+  background: #16A34A; opacity: 0;
+  animation: dpSpark 900ms ease-out forwards;
+}
+.dp-toast-sparks i:nth-child(1) { right: 0;    animation-delay: 180ms; }
+.dp-toast-sparks i:nth-child(2) { right: 7px;  animation-delay: 320ms; background: #4ADE80; }
+.dp-toast-sparks i:nth-child(3) { right: 2px;  animation-delay: 460ms; }
+@keyframes dpSpark {
+  0%   { opacity: 0; transform: translateY(0); }
+  25%  { opacity: 0.9; }
+  100% { opacity: 0; transform: translateY(-20px); }
+}
+
+/* 7 · Reduced motion — info stays, movement goes */
+@media (prefers-reduced-motion: reduce) {
+  .cell:not(:disabled):active { transform: none; }
+  .cell.dp-just { animation: none; }
+  .cell.dp-just .stamp,
+  .cell.dp-just .stamp-2x::before,
+  .cell.dp-just .stamp-ot::before { animation: none !important; }
+  .dp-toast { animation: dpToastLifeRM 2600ms ease forwards; }
+  .dp-toast-weekend { animation-duration: 3000ms; }
+  .dp-toast-slips::before,
+  .dp-toast-sparks i { animation: none !important; }
+  .dp-toast-sparks i { display: none; }
+  @keyframes dpToastLifeRM {
+    0%   { opacity: 0; }
+    8%   { opacity: 1; }
+    90%  { opacity: 1; }
+    100% { opacity: 0; }
+  }
+}
+
+/* ===== v18: Rate history (Settings → Earnings) ===== */
+.sp-rh { display: flex; flex-direction: column; gap: var(--sp-2); }
+.sp-rh-head { display: flex; flex-direction: column; gap: var(--gap-stack); }
+.sp-rh-row { display: flex; align-items: center; gap: var(--sp-2); border: 1px solid var(--border); border-radius: 12px; padding: var(--sp-3) var(--sp-4); background: var(--bg-elevated); }
+.sp-rh-row.future { border: 1.5px dashed var(--green-ink); }
+.sp-rh-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--gap-stack); }
+.sp-rh-rate { font-weight: 600; font-size: var(--fs-md); color: var(--text); }
+.sp-rh-rate em { font-style: normal; font-size: var(--fs-xs); font-weight: 500; color: var(--text-3); }
+.sp-rh-sub { font-size: var(--fs-xs); font-weight: 500; color: var(--text-3); }
+.sp-rh-pill { flex: none; font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.01em; border-radius: 999px; padding: 2.5px var(--sp-2); background: var(--bg-sunken); color: var(--text-3); }
+.sp-rh-pill.soon { background: var(--green-wash); color: var(--green-ink); }
+.sp-rh-del { flex: none; border: 0; background: transparent; color: var(--text-3); cursor: pointer; padding: var(--sp-1); border-radius: 8px; display: flex; align-items: center; }
+.sp-rh-del:hover { color: var(--danger, #DC2626); background: var(--bg-elevated-2); }
+.sp-rh-add { align-self: flex-start; border: 1.5px dashed var(--green-ink); color: var(--green-ink); background: transparent; border-radius: 10px; padding: var(--sp-2) var(--sp-3); font-weight: 600; font-size: var(--fs-sm); cursor: pointer; font-family: inherit; }
+.sp-rh-form { display: flex; flex-direction: column; gap: var(--sp-2); border: 1px solid var(--border); border-radius: 12px; padding: var(--sp-3) var(--sp-4); background: var(--bg-elevated-2); }
+.sp-rh-frow { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-2); }
+.sp-rh-flabel { font-size: var(--fs-xs); font-weight: 600; color: var(--text-2); }
+.sp-rh-fdate { border: 1px solid var(--border); background: var(--bg-elevated); color: var(--text); border-radius: 9px; padding: var(--sp-2) var(--sp-2); font-family: inherit; font-size: var(--fs-sm); }
+[data-theme="dark"] .sp-rh-fdate { color-scheme: dark; }
+.sp-rh-frate { flex: 1; max-width: 150px; }
+.sp-rh-factions { display: flex; justify-content: flex-end; gap: var(--sp-2); }
+.sp-rh-cancel { border: 1px solid var(--border); background: transparent; color: var(--text-2); border-radius: 9px; padding: var(--sp-2) var(--sp-3); font-size: var(--fs-sm); font-weight: 600; cursor: pointer; font-family: inherit; }
+.sp-rh-apply { padding: var(--sp-2) var(--sp-3); font-size: var(--fs-sm); }
+.sp-rh-truth { display: flex; flex-wrap: wrap; gap: var(--sp-2); padding-top: 2px; }
+.sp-rh-chip { font-size: var(--fs-2xs); font-weight: 500; color: var(--text-2); border: 1px solid var(--border); border-radius: 999px; padding: var(--sp-1) var(--sp-2); background: var(--bg); }
+.sp-rh-chip.hi { color: var(--green-ink); border-color: var(--green-ink); background: var(--green-wash); }
+
+/* ===== v18: collapsible folds (Settings + Month summary) ===== */
+.dp-fold { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-2); width: 100%; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 12px; padding: var(--sp-3) var(--sp-4); cursor: pointer; font-family: inherit; text-align: left; }
+.dp-fold-main { display: flex; flex-direction: column; gap: var(--gap-stack); min-width: 0; }
+.dp-fold-title { font-size: var(--fs-sm); font-weight: 600; color: var(--text); }
+.dp-fold-sum { font-size: var(--fs-xs); font-weight: 500; color: var(--text-3); }
+.dp-fold-chev { flex: none; color: var(--text-3); font-size: var(--fs-xs); transition: transform .16s ease; }
+.dp-fold-chev.open { transform: rotate(90deg); }
+.dp-fold-body { margin-top: var(--sp-2); }
+/* v24 §6: expanded fold bodies sit inside the fold's own box — no double border */
+.sp-card.dp-fold-body { border: 0; box-shadow: none; background: transparent; padding: var(--sp-2) 2px 0; }
+.dp-fold-body .sp-notes { margin-top: var(--sp-2); }
+.summary-top .dp-fold { margin-top: var(--sp-2); }
+
+/* ===== v18: Appearance picker (Light · Dark · Glass) ===== */
+/* v24.1 — padded composition for the appearance card (tiles + flavor row) */
+.sp-appear-card { padding: var(--sp-4); display: flex; flex-direction: column; gap: var(--sp-3); }
+.app-tiles { display: flex; gap: var(--sp-2); }
+.app-tile { flex: 1; display: flex; flex-direction: column; align-items: center; gap: var(--sp-2); padding: var(--sp-3) var(--sp-2) var(--sp-2); border-radius: 12px; border: 1.5px solid var(--border); background: var(--bg-elevated); color: var(--text-2); font-family: inherit; font-size: var(--fs-xs); font-weight: 600; cursor: pointer; }
+.app-tile.on { border-color: var(--green-ink); color: var(--green-ink); background: var(--green-wash); }
+.app-sw { width: 100%; height: 26px; border-radius: 7px; border: 1px solid var(--border); }
+.app-sw.sw-light { background: linear-gradient(180deg, #FFFFFF 55%, #F2F8F4 100%); }
+.app-sw.sw-dark { background: linear-gradient(180deg, #0C1425 55%, #080C16 100%); }
+.app-sw.sw-glass { background: radial-gradient(120% 90% at 85% -10%, rgba(34,222,94,.4), transparent 55%), radial-gradient(130% 100% at -10% 110%, rgba(30,64,110,.6), transparent 60%), #080C16; border-color: rgba(255,255,255,.28); }
+.app-flavor { display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap; }
+.app-flavor-lbl { font-size: var(--fs-xs); font-weight: 600; color: var(--text-3); }
+.app-flavor-btn { border: 1px solid var(--border); background: transparent; color: var(--text-2); border-radius: 999px; padding: var(--sp-2) var(--sp-3); font-size: var(--fs-xs); font-weight: 600; cursor: pointer; font-family: inherit; }
+.app-flavor-btn.on { border-color: var(--green-ink); color: var(--green-ink); background: var(--green-wash); }
+.app-flavor-note { font-size: var(--fs-2xs); color: var(--text-3); }
+
+/* ===== v18: GLASS appearance (opt-in) — frosted surfaces =====
+   Standard Light/Dark are untouched. Everything below applies only when
+   data-glass="on" AND the browser supports backdrop-filter; otherwise
+   glass mode renders as the standard theme (safe fallback). */
+@supports ((backdrop-filter: blur(4px)) or (-webkit-backdrop-filter: blur(4px))) {
+
+  /* canvas — glass needs something to blur */
+  [data-glass="on"][data-theme="dark"] .phone-frame {
+    background: radial-gradient(120% 90% at 88% -12%, rgba(22,163,74,.20), transparent 55%),
+                radial-gradient(130% 100% at -12% 112%, rgba(19,42,74,.55), transparent 62%),
+                #080C16;
+  }
+  [data-glass="on"][data-theme="light"] .phone-frame {
+    background: radial-gradient(95% 75% at 92% -6%, rgba(21,128,61,.09), transparent 60%),
+                radial-gradient(95% 85% at -6% 108%, rgba(59,130,246,.08), transparent 58%),
+                #FFFFFF;
+  }
+
+  /* header */
+  [data-glass="on"][data-theme="dark"] .header { background: rgba(8,12,22,.62); -webkit-backdrop-filter: blur(16px) saturate(150%); backdrop-filter: blur(16px) saturate(150%); border-bottom: 1px solid rgba(255,255,255,.08); }
+  [data-glass="on"][data-theme="light"] .header { background: rgba(255,255,255,.62); -webkit-backdrop-filter: blur(16px) saturate(150%); backdrop-filter: blur(16px) saturate(150%); border-bottom: 1px solid rgba(11,27,50,.07); }
+
+  /* hero panel */
+  [data-glass="on"][data-theme="dark"] .summary-top { background: rgba(13,21,40,.52); -webkit-backdrop-filter: blur(18px) saturate(150%); backdrop-filter: blur(18px) saturate(150%); border-color: rgba(255,255,255,.10); box-shadow: 0 18px 40px rgba(2,6,16,.45); }
+  [data-glass="on"][data-theme="light"] .summary-top { background: rgba(255,255,255,.55); -webkit-backdrop-filter: blur(16px) saturate(140%); backdrop-filter: blur(16px) saturate(140%); border-color: rgba(255,255,255,.85); box-shadow: 0 12px 30px rgba(11,27,50,.10), inset 0 0 0 1px rgba(226,229,233,.9); }
+
+  /* details/settings folds */
+  [data-glass="on"][data-theme="dark"] .dp-fold { background: rgba(255,255,255,.055); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border-color: rgba(255,255,255,.09); }
+  [data-glass="on"][data-theme="light"] .dp-fold { background: rgba(255,255,255,.55); -webkit-backdrop-filter: blur(9px); backdrop-filter: blur(9px); border-color: rgba(226,229,233,.8); }
+
+  /* calendar cells — light blur only, cheap on the GPU; stamps stay solid */
+  [data-glass="on"][data-theme="dark"] .cell { background: rgba(255,255,255,.05); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,.07); }
+  [data-glass="on"][data-theme="dark"] .cell.is-weekend { background: rgba(22,163,74,.12); border-color: rgba(74,222,128,.16); }
+  [data-glass="on"][data-theme="light"] .cell { background: rgba(255,255,255,.52); -webkit-backdrop-filter: blur(5px); backdrop-filter: blur(5px); border: 1px solid rgba(226,229,233,.75); }
+  [data-glass="on"][data-theme="light"] .cell.is-weekend { background: rgba(21,128,61,.07); border-color: rgba(21,128,61,.14); }
+
+  /* future chips */
+  [data-glass="on"][data-theme="dark"] .future-chip { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); }
+  [data-glass="on"][data-theme="light"] .future-chip { background: rgba(255,255,255,.5); border: 1px solid rgba(226,229,233,.8); }
+
+  /* celebration card — navy glass in both flavors */
+  [data-glass="on"] .dp-toast { background: rgba(11,27,50,.58); -webkit-backdrop-filter: blur(20px) saturate(160%); backdrop-filter: blur(20px) saturate(160%); border: 1px solid rgba(255,255,255,.16); }
+
+  /* modal sheets + menus */
+  [data-glass="on"][data-theme="dark"] .modal { background: rgba(13,21,40,.66); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); border-color: rgba(255,255,255,.10); }
+  [data-glass="on"][data-theme="light"] .modal { background: rgba(255,255,255,.66); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); border-color: rgba(255,255,255,.9); box-shadow: 0 18px 44px rgba(11,27,50,.16); }
+  [data-glass="on"][data-theme="dark"] .hamburger-dropdown { background: rgba(13,21,40,.72); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); border-color: rgba(255,255,255,.10); }
+  [data-glass="on"][data-theme="light"] .hamburger-dropdown { background: rgba(255,255,255,.72); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); border-color: rgba(226,229,233,.9); }
+  [data-glass="on"][data-theme="dark"] .share-dropdown { background: rgba(13,21,40,.72); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); border-color: rgba(255,255,255,.10); }
+  [data-glass="on"][data-theme="light"] .share-dropdown { background: rgba(255,255,255,.72); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); border-color: rgba(226,229,233,.9); }
+
+  /* settings cards */
+  [data-glass="on"][data-theme="dark"] .sp-card { background: rgba(13,21,40,.5); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); border-color: rgba(255,255,255,.09); }
+  [data-glass="on"][data-theme="light"] .sp-card { background: rgba(255,255,255,.55); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
+  [data-glass="on"][data-theme="dark"] .sp-rh-row { background: rgba(255,255,255,.045); }
+  [data-glass="on"][data-theme="light"] .sp-rh-row { background: rgba(255,255,255,.5); }
+}
+
+/* ===== v18: "Choose theme" inline picker (hamburger menu) ===== */
+.hamburger-item .hamburger-chev { margin-left: auto; font-size: var(--fs-xs); color: var(--text-3); transition: transform 0.15s ease; }
+.hamburger-item .hamburger-chev.open { transform: rotate(90deg); }
+/* v22: always mounted, expands/collapses smoothly (grid-rows transition) */
+.theme-picker { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 260ms cubic-bezier(0.22,1,0.36,1); }
+.theme-picker.open { grid-template-rows: 1fr; }
+.theme-picker-inner { overflow: hidden; min-height: 0; }
+.theme-picker-visual { display: flex; flex-direction: column; gap: var(--sp-1); padding: var(--sp-2); background: var(--bg-elevated-2); border-radius: 10px; }
+.theme-opt { display: flex; align-items: center; gap: var(--sp-2); width: 100%; border: 0; background: transparent; color: var(--text-2); font-family: inherit; font-size: var(--fs-xs); font-weight: 500; padding: var(--sp-2) var(--sp-2); border-radius: 8px; cursor: pointer; text-align: left; transition: background 0.13s, color 0.13s; }
+.theme-opt:hover { background: var(--bg-cell-hover); color: var(--text); }
+.theme-opt.on { color: var(--green-ink); background: var(--green-wash); font-weight: 700; }
+.theme-sw { width: 20px; height: 20px; border-radius: 6px; border: 1px solid var(--border); flex: none; }
+.theme-sw.sw-light { background: linear-gradient(180deg, #FFFFFF 55%, #F2F8F4 100%); }
+.theme-sw.sw-dark { background: linear-gradient(180deg, #0C1425 55%, #080C16 100%); }
+.theme-sw.sw-glass-dark { background: radial-gradient(120% 90% at 85% -10%, rgba(34,222,94,.45), transparent 55%), radial-gradient(130% 100% at -10% 110%, rgba(30,64,110,.65), transparent 60%), #080C16; border-color: rgba(255,255,255,.3); }
+.theme-sw.sw-glass-light { background: radial-gradient(95% 75% at 92% -6%, rgba(21,128,61,.14), transparent 60%), linear-gradient(180deg, #FFFFFF, #F2F8F4); }
+.theme-check { margin-left: auto; color: var(--green-ink); font-weight: 800; }
+
+/* ===== v18-C: Export my data (Settings → Your data) ===== */
+.sp-export { padding: var(--sp-4); display: flex; flex-direction: column; gap: var(--sp-3); }
+.sp-export-head { display: flex; flex-direction: column; gap: var(--gap-stack); }
+.sp-export-title { font-size: var(--fs-sm); font-weight: 600; letter-spacing: -0.01em; color: var(--text); }
+.sp-export-sub { font-size: var(--fs-xs); font-weight: 500; color: var(--text-3); }
+.sp-export-row { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
+.sp-export-btn { flex: 1 1 140px; display: inline-flex; align-items: center; justify-content: center; gap: var(--sp-2); border-radius: 10px; padding: var(--sp-2) var(--sp-2); font-family: inherit; font-size: var(--fs-xs); font-weight: 600; cursor: pointer; border: 1px solid transparent; transition: filter 0.13s ease, background 0.13s ease, color 0.13s ease; }
+.sp-export-btn.primary { background: var(--green-ink); color: var(--bg); }
