+/* v24.1: ≤382px viewports can't fit 7 chips + 8px gaps (needs 314px content) — tighten the gaps so all 7 days stay on one row */
+@media (max-width: 382px) { .sp-rem-days { gap: var(--sp-1); } }
+.sp-rem-day {
+  /* Phase 17: the tap token in BOTH directions. They were 36px wide and ~30px
+     tall — seven small targets in one row, which is exactly the shape a thumb
+     misses. Each chip now takes its share of the row and wraps if the phone is too
+     narrow for seven of them; a wrapped row is usable, a 30px row is not. */
+  flex: 1 1 0; /* equal shares — one row of 7 wherever it fits */
+  min-width: var(--tap);
+  min-height: var(--tap);
+  padding: var(--sp-2) var(--sp-1);
