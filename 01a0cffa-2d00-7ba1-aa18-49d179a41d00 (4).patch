+}
+.msb-action:hover { background: var(--daypay-navy); border-color: var(--daypay-navy); color: #ffffff; }
+[data-theme="dark"] .msb-action:hover { background: #EDF1F7; border-color: #EDF1F7; color: var(--daypay-navy); }
+
+.final-salary-banner {
+  margin: var(--sp-4) var(--sp-4) 0; padding: var(--sp-5) var(--sp-5) var(--sp-4); background: var(--bg-elevated);
