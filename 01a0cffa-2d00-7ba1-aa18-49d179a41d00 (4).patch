+/* DayPay — the workplace name (§20).
+ *
+ * What was wrong: `employers.business_name` had a column, a writer in the data
+ * layer (`updateBusinessName`) and three readers — the worker's own header, the
+ * leave prompt and the site kiosk's door screen — and nothing that ever called the
+ * writer. So all three fell back, and an employer's own product called their
+ * business "My team" and "Your site" to the people who work there. The audit's
+ * table row 20 is the whole story: "exists in the data layer and is called from
+ * nowhere".
+ *
+ * This is the screen that calls it. It is a component rather than a block inside
+ * `src/App.jsx` for one reason that matters here: a save is a claim about what
+ * reaches the database, and this way the claim can be driven in a real DOM with
+ * the data layer the harness already stands in for — typing, pressing Save, and
+ * reading what the mock was asked to write.
+ *
+ * The name reaches four surfaces, and this component is only the first:
+ *   · the settings row and the field below it — here;
+ *   · the worker's own screen, where `EmployeeView` prints it instead of "My team";
+ *   · the site kiosk's header, where it replaces "Your site";
+ *   · and the payslip's provenance line, which says WORKPLACE rather than a
+ *     personal tally when the worker is on somebody's books.
+ *
+ * Copyright © 2026 Akaninyene. All rights reserved.
+ */
+
+import { useEffect, useId, useState } from 'react'
+import { updateBusinessName } from '../lib/employer'
+
+/* The briefcase, drawn once. A workplace is a place of work, not a briefcase —
+   but every other mark on this settings page is a 19px line icon, and a map pin
+   would read as a location, which is the one thing this app promises never to do
+   with anybody's position. */
+function BriefcaseMark() {
+  return (
+    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor"
+      strokeWidth="1.7" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+      <rect x="2.5" y="7" width="19" height="13" rx="2.5" />
+      <path d="M8.5 7V5.4A1.9 1.9 0 0 1 10.4 3.5h3.2A1.9 1.9 0 0 1 15.5 5.4V7" />
+      <path d="M2.5 12.5h19" />
+    </svg>
+  )
+}
+
+/* ── the row in the settings list ─────────────────────────────────────────────
+   Drawn only for an employer — `workplaceVisible()` in employerLogic.js is the
+   rule, and `src/App.jsx` holds it. The summary says what the name IS, so an
+   employer who has never named the place can see that from the list. */
+export function WorkplaceRow({ name, onOpen }) {
+  const named = (name || '').trim()
+  return (
+    <button type="button" className="sp-cat-card" onClick={onOpen}>
+      <span className="sp-cat-ico"><BriefcaseMark /></span>
+      <span className="sp-cat-body">
+        <span className="sp-cat-line">
+          <span className="sp-cat-name">Workplace</span>
+          <span className="sp-cat-sum">{named || 'Not named yet'}</span>
+        </span>
+        <span className="sp-cat-desc">The name your workers see.</span>
+      </span>
+    </button>
+  )
+}
+
+/* ── the page ──────────────────────────────────────────────────────────────── */
+export default function Workplace({ name, onSaved }) {
+  const stored = (name || '').trim()
+  const [draft, setDraft] = useState(stored)
+  const [saving, setSaving] = useState(false)
+  const [said, setSaid] = useState('')
+  const [err, setErr] = useState('')
+  const fieldId = useId()
+
+  /* The field follows the stored name. It matters after a save on another device
+     (the roles read comes back with a new name) and after a failed save, where the
+     field must not keep a value the database never agreed to. */
+  useEffect(() => { setDraft(stored) }, [stored])
+
+  async function save() {
+    const next = draft.trim()
+    if (!next || saving) return
+    setSaving(true); setErr(''); setSaid('')
+    try {
+      await updateBusinessName(next)
+      setSaid('Saved. Your workers will see this name.')
+      await onSaved?.(next)
+    } catch (e) {
+      setErr(e?.hint
+        ? `${e?.message || 'Could not save that.'} — ${e.hint}`
+        : (e?.message || 'Could not save your workplace name.'))
+    } finally { setSaving(false) }
+  }
+
+  return (
+    <>
+      <div className="sp-card sp-profile">
+        <span className="sp-avatar sp-avatar-ghost"><BriefcaseMark /></span>
+        <div className="sp-profile-main">
+          <label className="sr-only" htmlFor={fieldId}>Workplace name</label>
+          <input
+            id={fieldId}
+            className="sp-name-input"
+            value={draft}
+            onChange={e => { setDraft(e.target.value); setSaid('') }}
+            placeholder="e.g. Eddimore Farms"
+            maxLength={60}
+            autoComplete="organization"
+          />
+          <span className="sp-email">Shown to your workers and on the site kiosk</span>
+        </div>
+        <button className="sp-save-name" onClick={save} disabled={saving || !draft.trim()}>
+          {saving ? 'Saving…' : 'Save'}
+        </button>
+      </div>
+
+      {/* The words carry the meaning; the colour only says which of the two it is.
+          Both are announced: a save that worked and a save that did not are two
+          different facts, and neither should be found by looking harder. */}
+      {err && <p className="sp-wp-note is-err" role="alert">{err}</p>}
+      {said && <p className="sp-wp-note is-ok" role="status">{said}</p>}
+
+      <p className="sp-hint">
+        Your workplace name is the name a worker reads on their own screen, and the name on
+        the site kiosk at the door. Nothing about a day, a rate or a payslip changes with it.
+      </p>
+    </>
+  )
+}
diff --git a/src/employer/employer.css b/src/employer/employer.css
new file mode 100644
index 0000000..6f96a7e
--- /dev/null
+++ b/src/employer/employer.css
@@ -0,0 +1,2657 @@
+/* DayPay Employer Version — employer workspace.
+   Uses the app's existing theme tokens, so it follows Light / Dark / Glass
+   automatically without duplicating any colours. */
+
+.ew {
+  display: flex;
+  flex-direction: column;
+  gap: var(--sp-4);
+  padding-bottom: 40px;
+}
+
+/* The workspace while it is still loading has no bottom bar to clear, and giving
+   it that 40px anyway would make a phone scroll a skeleton (Phase 15). */
+.ew-is-waiting { padding-bottom: 0; }
+
+/* ── The page grid: one left edge for the whole app (the brief's §6) ──────────
+   The app has ONE left edge, and it is 16px in from the frame. That is where the
+   header's logo sits (`.header`, `var(--sp-3) var(--sp-4)`), and where the
+   tracker's own pages put their content (`.summary-card`, `.year-totals`,
+   `var(--sp-4) var(--sp-4) 0`). Rows and cards carry the same 16px inside their
+   own padding, so the text within them lines up with the logo without a second
+   number anywhere.
+
+   The workspace was the one surface missing it: unlike every other screen, its
+   blocks sit directly on `.ew`, which had no side padding at all. So a page title
+   began at the glass while the row that repeated the same word began at 16px —
+   two left edges on one screen.
+
+   Only the blocks that sit DIRECTLY on a page are listed. A block already inside
+   a card, a sheet, a list or a person row is inset by its container, and the
+   `:not()` is what stops it being inset twice. `:is()` is used rather than
+   `:where()` so this wins over the single-class rules it is correcting — a
+   `.ew-today-head` that already declares its own vertical padding. */
+.ew :is(.ew-head, .dp-sec, .ew-glance, .ew-today-head, .ew-dash-block-title,
+        .ew-dash-money, .ew-dash-note, .ew-screen-note, .ew-dash-foot,
+        .ew-att-foot, .ew-more-foot, .ew-find):not(
+  .ew-card *, .ew-sheet *, .ew-bill-row *, .dp-list *, .ew-person *,
+  .dp-notice *, .ew-prof *, .ew-screen-info *, .ew-owe *, .ew-codebox *,
+  .ew-corr-card *, .ew-corr-row *, .ew-dayrow *) {
+  padding-inline: var(--gap-page);
+}
+
+/* ── The wide-screen wrappers (Phase 15) ──────────────────────────────────────
+   Three wrappers exist only so the layout can have columns above 1280px. Below
+   that they are `display: contents` — no box, no margin, no gap of their own — so
+   the phone screens are laid out exactly as they were before the wrappers were
+   added. That is the whole reason the desktop work could be done without moving a
+   single pixel of the layout the screen checks were written against. */
+.ew-dash-col,
+.ew-att-side,
+.ew-att-main { display: contents; }
+
+/* ── Section headers ─────────────────────────────────────────────────────── */
+
+.ew-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--sp-3);
+  margin-top: var(--sp-1);
+  /* The one gap under a page header (20px). Margins collapse, so a following
+     block with a bigger top margin still wins — this is a floor, not a sum. */
+  margin-bottom: var(--gap-head);
+  flex-wrap: wrap;
+}
+
+/* Without min-width:0 a long roster summary can push the Add button off a
+   narrow phone screen. The button is non-shrinkable so it always stays put. */
+/* The page header's title and its description. Same rule as the list row's text
+   stack: a column flex with an explicit gap, because these were block elements
+   with a 4px margin and no line height of their own — close, but not a system. */
+.ew-head-text {
+  flex: 1 1 auto;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: var(--gap-stack);
+}
+
+.ew-head > .ew-btn {
+  flex: 0 0 auto;
+  margin-left: auto;
+}
+
+.ew-title {
+  margin: 0;
+  /* A page title is 22px, the middle of the brief's 20–24 band (it was 19). The
+     line height is the title role's 1.25, so a title that wraps stays a title. */
+  font-size: var(--fs-page);
+  font-weight: var(--fw-title);
+  line-height: var(--lh-title);
+  letter-spacing: -0.02em;
+  color: var(--text);
+}
+
+/* A description that belongs to a title. Where the two live inside a stack
+   (`.ew-head-text`), the container's gap owns the space and this margin is zero;
+   where a title and its description are the only two children of a card, the
+   margin still gives them the same 4px. Either way the two never touch — which is
+   the thing the brief asked for, in one rule rather than in nine. */
+.ew-sub {
+  margin: var(--gap-stack) 0 0;
+  font-size: var(--fs-body);
+  line-height: var(--lh-row);
+  color: var(--text-3);
+}
+
+.ew-head-text > .ew-sub { margin-top: 0; }
+
+/* ── Cards ───────────────────────────────────────────────────────────────── */
+
+.ew-card {
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  padding: var(--sp-4);
+}
+
+.ew-card + .ew-card { margin-top: var(--sp-2); }
+
+/* ── Buttons ─────────────────────────────────────────────────────────────── */
+
+.ew-btn {
+  font: inherit;
+  font-size: var(--fs-sm);
+  font-weight: var(--fw-value);
+  min-height: var(--tap);
+  /* One box for every button in the product: the label is centred in it, and an
+     icon that comes with a label is a step of the scale away from it — never
+     touching, which is what "+ Add" and an inline SVG used to risk. */
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--sp-2);
+  border-radius: 10px;
+  border: 1px solid transparent;
+  padding: var(--sp-2) var(--sp-4);
+  cursor: pointer;
+  white-space: nowrap;
+  transition: filter .15s ease, background .15s ease;
+}
+
+.ew-btn:active { transform: translateY(0.5px); }
+.ew-btn:disabled { opacity: .5; cursor: default; }
+
+.ew-btn-primary { background: var(--daypay-green); color: #fff; }
+.ew-btn-primary:hover:not(:disabled) { filter: brightness(1.08); }
+
+.ew-btn-ghost {
+  background: transparent;
+  color: var(--text-2);
+  border-color: var(--border-strong);
+}
+.ew-btn-ghost:hover:not(:disabled) { background: var(--bg-cell-hover); }
+
+.ew-btn-danger { background: transparent; color: var(--danger); border-color: var(--border-strong); }
+.ew-btn-sm { font-size: var(--fs-xs); padding: var(--sp-2) var(--sp-3); min-height: var(--tap); }
+
+/* ── Employee rows ───────────────────────────────────────────────────────── */
+
+.ew-person {
+  display: flex;
+  align-items: center;
+  gap: var(--sp-3);
+  padding: var(--pad-row-y) var(--pad-row-x);
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+}
+
+.ew-person + .ew-person { margin-top: var(--sp-2); }
+
+/* Inside the shared list container a contractor row drops the card it would
+   otherwise be — border, radius, background — and takes the same hairline divider
+   the roster's rows have. On its own (the rate panel's header) `.ew-person` keeps
+   the card. Phase 16. */
+.ew-list .ew-person { border: 0; border-radius: 0; background: none; }
+.ew-list .ew-person + .ew-person { margin-top: 0; border-top: 1px solid var(--border-light); }
+
+.ew-avatar {
+  flex: 0 0 auto;
+  width: 42px; height: 42px;
+  border-radius: 50%;
+  display: flex; align-items: center; justify-content: center;
+  background: var(--daypay-green-light);
+  color: var(--daypay-green);
+  font-weight: 600;
+  font-size: var(--fs-sm);
+  letter-spacing: .02em;
+}
+
+/* The roster row's name and the line of facts under it: a stack, like every other
+   title-and-description pair in the product. */
+.ew-person-body {
+  flex: 1 1 auto;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: var(--gap-stack);
+}
+
+.ew-name {
+  font-size: var(--fs-row);
+  font-weight: var(--fw-value);
+  line-height: var(--lh-row);
+  color: var(--text);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.ew-meta {
+  font-size: var(--fs-body);
+  line-height: var(--lh-row);
+  color: var(--text-3);
+  display: flex;
+  align-items: center;
+  gap: var(--sp-2);
+  flex-wrap: wrap;
+}
+
+.ew-rate {
+  font-size: var(--fs-sm);
+  font-weight: 700;
+  color: var(--daypay-green);
+  font-variant-numeric: tabular-nums;
+}
+
+/* The rate is the number an employer scans a row for, so it stands one ramp
+   step above the 13px meta it sits in — in tabular figures, so a column of
+   amounts still lines up. "No rate set" moves with it: a card whose figure
+   changed size when the rate was missing would jump as rates are entered. */
+.ew-rate-none { font-size: var(--fs-sm); color: var(--amber); font-weight: 700; }
+
+.ew-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--sp-1);
+  font-size: var(--fs-label);
+  font-weight: 600;
+  padding: 2.5px var(--sp-2);
+  border-radius: 999px;
+  background: var(--bg-sunken);
+  color: var(--text-3);
+  border: 1px solid var(--border-light);
+}
+
+.ew-chip-live { background: var(--daypay-green-light); color: var(--daypay-green); border-color: transparent; }
+.ew-chip-warn { background: var(--amber-wash); color: var(--amber); border-color: transparent; }
+
+/* §4 — "Not registered" is a fact about a LOGIN, not a fault and not a state to
+   watch: the worker is on the roster and is paid. It used to be a plain chip,
+   which is still a badge — the same pill, the same 12px/600, as the green
+   "Registered" chip beside it, told apart by colour alone. That is exactly the
+   distinction that goes first in sunlight and for a colour-blind reader. Quiet,
+   unpilled type reads as information; the green chip keeps the badge role for
+   the state that is genuinely worth flagging. */
+.ew-chip-quiet {
+  background: none;
+  border-color: transparent;
+  padding-left: 0;
+  color: var(--text-3);
+  font-weight: 500;
+}
+
+.ew-person-actions { flex: 0 0 auto; display: flex; gap: var(--sp-2); }
+
+/* ── The roster list ────────────────────────────────────────────────────────
+   One container with hairline dividers, not a card per person. A roster of
+   three should read as a list; separate cards made every row look like its own
+   screen, and on a phone the gaps alone pushed the third person below the fold.
+   The row is two lines: who the person is, then what they cost and what you can
+   do about it. */
+
+.ew-list {
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  overflow: hidden;
+}
+
+.ew-row { padding: var(--pad-row-y) var(--pad-row-x); }
+.ew-row + .ew-row { border-top: 1px solid var(--border-light); }
+
+.ew-row-top { display: flex; align-items: flex-start; gap: var(--sp-3); }
+.ew-row-text { flex: 1 1 auto; min-width: 0; }
+
+.ew-row-name {
+  font-size: var(--fs-md);
+  font-weight: 600;
+  color: var(--text);
+  letter-spacing: -0.01em;
+}
+
+/* A description under a row's title: the same stack gap as everywhere else, and
+   not the 1px that did nothing before. */
+.ew-row-sub {
+  margin-top: var(--gap-stack);
+  font-size: var(--fs-xs);
+  color: var(--text-3);
+}
+
+/* The chip grows to 12px inside a row. Its 11px default is fine as a spare
+   badge in a dense table; on the roster it is the answer to "can they sign
+   in?", which is a sentence, not a tag. */
+.ew-row .ew-chip { font-size: var(--fs-label); flex: 0 0 auto; }
+
+.ew-row-foot {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--sp-3);
+  margin-top: var(--sp-2);
+  /* Sits under the text column, clear of the 42px avatar above it. */
+  padding-left: 54px;
+}
+
+.ew-row-actions { flex: 0 0 auto; display: flex; align-items: center; gap: var(--sp-1); }
+.ew-row-note { font-size: var(--fs-xs); color: var(--text-3); }
+
+@media (max-width: 420px) {
+  /* At this width the rate and the actions cannot share a line without the
+     rate losing. They stack, and the space the avatar was using is given back
+     to them. */
+  .ew-row-foot { padding-left: 0; flex-wrap: wrap; }
+}
+
+/* The overflow trigger. A 16px glyph in a 44px target, so it is a thumb press
+   and not a sniper shot. */
+/* Phase 6 turned the caps off for the roster's panels with an override here.
+   Phase 9 moved the shared .ew-label style itself, so the override is gone: a
+   leftover exception is how one screen drifts from the rest. The marker class
+   .ew-roster-panel stays — the panels are still grouped and still need to be
+   addressable. */
+
+.ew-more {
+  padding: var(--sp-2);
+  /* 44 wide but 35 tall before this: a control a thumb can miss */
+  min-width: var(--tap);
+  min-height: var(--tap);
+  justify-content: center;
+  color: var(--text-2);
+}
+
+/* The overflow itself. Inline, under its own row: a floating menu on a phone
+   covers the row that explains what it is for. */
+.ew-menu {
+  margin-top: var(--sp-2);
+  padding: var(--sp-1);
+  background: var(--bg-sunken);
+  border: 1px solid var(--border-light);
+  border-radius: 12px;
+  display: flex;
+  flex-direction: column;
+}
+
+.ew-menu-field {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--sp-2);
+  padding: var(--sp-2) var(--sp-3);
+}
+
+.ew-menu-label { font-size: var(--fs-xs); font-weight: 600; color: var(--text-3); }
+
+/* The contractor select lives here now, not on the row — where its 116px cap
+   clipped the rate and the status beside it. */
+.ew-menu-select { max-width: none; flex: 1 1 auto; min-width: 0; min-height: var(--tap); }
+
+.ew-menu-item {
+  width: 100%;
+  min-height: var(--tap);
+  padding: var(--sp-2) var(--sp-3);
+  border: 0;
+  border-radius: 9px;
+  background: none;
+  font: inherit;
+  font-size: var(--fs-sm);
+  font-weight: 500;
+  color: var(--text);
+  text-align: left;
+  cursor: pointer;
+}
+.ew-menu-item:hover { background: var(--bg-cell-hover); }
+.ew-menu-item.is-danger { color: var(--danger); font-weight: 600; }
+
+/* "Are you sure", in the row rather than in a browser dialog. */
+.ew-confirm { padding: var(--sp-2) var(--sp-3) var(--sp-3); }
+.ew-confirm-text {
+  margin: 0 0 var(--sp-2);
+  font-size: var(--fs-sm);
+  line-height: var(--lh-body);
+  color: var(--text-2);
+}
+.ew-confirm-row { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
+
+/* A quiet text button: housekeeping that must not compete with Add. */
+.ew-text-btn {
+  align-self: flex-start;
+  min-height: var(--tap);
+  padding: var(--sp-1) 0;
+  background: none;
+  border: 0;
+  font: inherit;
+  font-size: var(--fs-sm);
+  font-weight: 600;
+  color: var(--text-3);
+  cursor: pointer;
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+.ew-text-btn:hover { color: var(--text); }
+
+/* Phase 8 — kiosk and contractors are destinations of their own now (More →
+   Site kiosk, More → Contractors), so the compact "tool row" styling that held
+   them at the foot of the roster was removed with them. The replacement is the
+   screen header every other employer screen uses: .ew-head + .ew-title +
+   .ew-sub, with .ew-screen-info / .ew-screen-note for what hangs below it. */
+
+/* The outline button a worker with no login gets — invite them, which is the
+   one thing that changes their situation. */
+.ew-btn-accent {
+  background: transparent;
+  color: var(--green-ink);
+  border-color: var(--green-ink);
+}
+.ew-btn-accent:hover:not(:disabled) { background: var(--green-wash); }
+
+.ew-icon-btn {
+  flex: 0 0 auto;
+  width: var(--tap); height: var(--tap);
+  display: grid; place-items: center;
+  background: none;
+  border: 1px solid transparent;
+  border-radius: 10px;
+  color: var(--text-3);
+  cursor: pointer;
+}
+.ew-icon-btn:hover { background: var(--bg-sunken); color: var(--text); }
+
+/* Five controls share this row — a contractor select and four buttons — and it
+   was `flex: 0 0 auto`, so it never gave way; the name beside it is
+   `flex: 1 1 auto; min-width: 0` and collapsed to nothing instead. Measured
+   rather than guessed: the four buttons are ~270px of text and padding at
+   --fs-xs, the four gaps 32px, the select ~150px — about 450px of row, so the
+   card needs roughly 560px of viewport to hold that beside an avatar and a
+   name. Below 600px it takes its own full-width line, where it can wrap among
+   itself. Nothing is hidden: all five controls stay visible and reachable. */
+@media (max-width: 600px) {
+  .ew-person { flex-wrap: wrap; }
+  .ew-person-actions { flex: 1 1 100%; flex-wrap: wrap; }
+}
+
+/* ── Form ────────────────────────────────────────────────────────────────── */
+
+/* A form is a sequence of fields; a field is a label, an input, and whatever the
+   field has to say. Both gaps are steps of the scale, so a label never touches its
+   input and a helper never touches the field above it. */
+.ew-form { display: flex; flex-direction: column; gap: var(--sp-4); }
+
+.ew-field { display: flex; flex-direction: column; gap: var(--sp-2); }
+
+.ew-label {
+  font-size: var(--fs-xs);
+  font-weight: 600;
+  color: var(--text-3);
+  text-transform: none;
+  letter-spacing: 0.01em;
+}
+
+.ew-input {
+  font: inherit;
+  font-size: var(--fs-md);
+  padding: var(--sp-3) var(--sp-3);
+  border-radius: 10px;
+  border: 1px solid var(--border-strong);
+  background: var(--bg-sunken);
+  color: var(--text);
+  width: 100%;
+}
+
+.ew-input:focus { outline: 2px solid var(--daypay-green); outline-offset: -1px; background: var(--bg-elevated); }
+
+.ew-hint { font-size: var(--fs-xs); color: var(--text-4); }
+
+/* The FORM row — a horizontal pair of fields that share the width. It used to
+   be called `.ew-row`, which is also the name of the roster's list row, so the
+   two layouts were fighting over one class: the list row inherited `display:
+   flex` and every child was squeezed to an equal share, and both form rows
+   silently gained the list row's padding. One name, one meaning. */
+.ew-formrow { display: flex; gap: var(--sp-2); }
+.ew-formrow > * { flex: 1 1 0; min-width: 0; }
+
+.ew-actions { display: flex; gap: var(--sp-2); justify-content: flex-end; margin-top: var(--sp-1); }
+
+/* ── Messages ────────────────────────────────────────────────────────────── */
+
+/* A message is read at the same left edge as the card above it, and its first and
+   last line get the same 12px of air (the brief's §8). */
+.ew-msg {
+  border-radius: 11px;
+  padding: var(--sp-3) var(--pad-row-x);
+  font-size: var(--fs-sm);
+  line-height: var(--lh-body);
+}
+
+.ew-msg-error { background: #FEE2E2; color: #7F1D1D; border: 1px solid #FCA5A5; }
+.ew-msg-ok    { background: var(--daypay-green-light); color: var(--daypay-green); border: 1px solid #86EFAC; }
+.ew-msg-warn  { background: var(--amber-wash); color: var(--amber); border: 1px solid #FCD34D; }
+.ew-msg-hint { display: block; margin-top: var(--sp-1); opacity: .85; font-size: var(--fs-xs); }
+
+/* ── Empty state ─────────────────────────────────────────────────────────── */
+
+.ew-empty {
+  text-align: center;
+  padding: var(--sp-6) 20px;
+  color: var(--text-3);
+  border: 1px dashed var(--border-strong);
+  border-radius: 14px;
+  background: var(--bg-sunken);
+}
+
+.ew-empty-title { font-size: var(--fs-md); font-weight: 700; color: var(--text-2); margin-bottom: var(--sp-1); }
+.ew-empty-body { font-size: var(--fs-sm); line-height: var(--lh-body); max-width: 34ch; margin: 0 auto; }
+
+
+/* ── Rate history ────────────────────────────────────────────────────────── */
+
+.ew-rates { margin-top: var(--sp-2); border-top: 1px solid var(--border-light); padding-top: var(--sp-2); }
+
+.ew-rate-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--sp-2);
+  font-size: var(--fs-sm);
+  padding: var(--sp-1) 0;
+}
+
+.ew-rate-row + .ew-rate-row { border-top: 1px dashed var(--border-light); }
+.ew-rate-when { color: var(--text-3); }
+.ew-rate-amt { font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums; }
+
+/* ── Summary strip ───────────────────────────────────────────────────────── */
+
+.ew-summary {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
+  gap: var(--sp-2);
+}
+
+.ew-stat {
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 13px;
+  padding: var(--sp-3);
+}
+
+.ew-stat-label { font-size: var(--fs-label); font-weight: 600; text-transform: none; letter-spacing: 0.01em; color: var(--text-3); }
+.ew-stat-value { font-size: var(--fs-lg); font-weight: 700; color: var(--text); margin-top: var(--sp-1); font-variant-numeric: tabular-nums; }
+.ew-stat-money .ew-stat-value { color: var(--daypay-green); }
+
+/* ── Invite code ─────────────────────────────────────────────────────────── */
+
+.ew-invite {
+  display: flex;
+  align-items: center;
+  gap: var(--sp-2);
+  font-family: var(--font-mono);
+  font-size: var(--fs-md);
+  font-weight: 600;
+  letter-spacing: .12em;
+  color: var(--daypay-navy);
+  background: var(--bg-sunken);
+  border: 1px dashed var(--border-strong);
+  border-radius: 9px;
+  padding: var(--sp-2) var(--sp-3);
+  user-select: all;
+}
+
+/* ── Sub-tabs inside the Staff view ──────────────────────────────────────── */
+
+.ew-subtabs {
+  display: flex;
+  gap: var(--sp-1);
+  background: var(--bg-sunken);
+  border: 1px solid var(--border);
+  border-radius: 11px;
+  padding: var(--sp-1);
+  /* Five one-word tabs do not fit across 380px. They grow to share a wide
+     screen and scroll sideways when they cannot — a bar you can push, rather
+     than labels squeezed until they wrap mid-word. */
+  overflow-x: auto;
+  scrollbar-width: none;
+  -ms-overflow-style: none;
+}
+.ew-subtabs::-webkit-scrollbar { display: none; }
+
+.ew-subtab {
+  flex: 1 0 auto;
+  white-space: nowrap;
+  min-height: var(--tap);
+  font: inherit;
+  font-size: var(--fs-sm);
+  font-weight: 600;
+  padding: var(--sp-2) var(--sp-2);
+  border: 0;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--text-3);
+  cursor: pointer;
+}
+
+.ew-subtab.active { background: var(--bg-elevated); color: var(--text); box-shadow: 0 1px 2px rgba(0,0,0,.06); }
+
+/* ── Date stepper ────────────────────────────────────────────────────────── */
+
+.ew-datebar {
+  display: flex;
+  align-items: center;
+  gap: var(--sp-2);
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  padding: var(--sp-2);
+}
+
+.ew-datebar-step {
+  /* 42px was two short of the thumb rule, and this is a one-handed stepper: it is
+     the size of the token now (Phase 17). */
+  flex: 0 0 auto;
+  width: var(--tap); height: var(--tap);
+  font-size: var(--fs-xl);
+  line-height: 1;
+  border: 1px solid var(--border-strong);
+  border-radius: 10px;
+  background: var(--bg-sunken);
+  color: var(--text-2);
+  cursor: pointer;
+}
+
+.ew-datebar-step:disabled { opacity: .45; cursor: default; }
+
+.ew-datebar-mid { flex: 1 1 auto; text-align: center; min-width: 0; }
+
+.ew-datebar-day {
+  font-size: var(--fs-md);
+  font-weight: 600;
+  color: var(--text);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.ew-datebar-today {
+  font: inherit;
+  font-size: var(--fs-xs);
+  font-weight: 600;
+  color: var(--daypay-green);
+  background: none;
+  border: 0;
+  padding: 2px 0 0;
+  cursor: pointer;
+  text-decoration: underline;
+}
+
+
+/* ── Day rows ────────────────────────────────────────────────────────────── */
+
+.ew-dayrow {
+  display: flex;
+  align-items: flex-start;
+  gap: var(--sp-3);
+  padding: var(--sp-3) var(--sp-3);
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+}
+
+.ew-dayrow + .ew-dayrow { margin-top: var(--sp-2); }
+.ew-dayrow.is-marked { border-color: var(--daypay-green); background: var(--daypay-green-light); }
+
+.ew-dayrow-body { flex: 1 1 auto; min-width: 0; }
+
+.ew-muted { color: var(--text-4); font-size: var(--fs-xs); }
+
+.ew-kinds { display: flex; gap: var(--sp-1); flex-wrap: wrap; margin-top: var(--sp-2); }
+
+.ew-kindchip {
+  font: inherit;
+  font-size: var(--fs-xs);
+  font-weight: 600;
+  padding: var(--sp-1) var(--sp-2);
+  border-radius: 999px;
+  border: 1px solid var(--border-strong);
+  background: var(--bg-elevated);
+  color: var(--text-3);
+  cursor: pointer;
+}
+
+.ew-kindchip.active { background: var(--daypay-navy); color: #fff; border-color: var(--daypay-navy); }
+.ew-kindchip:disabled { opacity: .5; cursor: default; }
+
+
+
+/* ── Month bar (summary) ─────────────────────────────────────────────────── */
+
+.ew-monthbar {
+  display: flex;
+  align-items: center;
+  gap: var(--sp-2);
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  padding: var(--sp-2);
+}
+
+/* ── The headline figure ─────────────────────────────────────────────────── */
+
+.ew-owe {
+  background: var(--daypay-navy);
+  border-radius: 16px;
+  padding: var(--sp-4) var(--sp-4);
+  color: #fff;
+}
+
+.ew-owe-label { font-size: var(--fs-xs); font-weight: 600; text-transform: none; letter-spacing: 0.01em; opacity: .72; }
+
+.ew-owe-figure {
+  font-size: 34px;
+  font-weight: 800;
+  letter-spacing: -0.02em;
+  margin-top: var(--sp-1);
+  font-variant-numeric: tabular-nums;
+  color: #4ADE80;
+  line-height: var(--lh-tight);
+  word-break: break-word;
+}
+
+.ew-owe-sub { font-size: var(--fs-sm); opacity: .8; margin-top: var(--sp-2); }
+
+.ew-owe-flags { display: flex; gap: var(--sp-2); flex-wrap: wrap; margin-top: var(--sp-2); }
+.ew-owe-flags .ew-chip { background: rgba(255,255,255,.16); color: #FDE68A; border-color: transparent; }
+
+/* ── Payroll rows ────────────────────────────────────────────────────────── */
+
+.ew-pay {
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  overflow: hidden;
+}
+
+.ew-pay + .ew-pay { margin-top: var(--sp-2); }
+
+.ew-pay-head {
+  display: flex;
+  align-items: center;
+  gap: var(--sp-3);
+  width: 100%;
+  padding: var(--sp-3) var(--sp-3);
+  background: none;
+  border: 0;
+  font: inherit;
+  text-align: left;
+  cursor: pointer;
+  color: inherit;
+}
+
+.ew-pay-body { flex: 1 1 auto; min-width: 0; }
+
+.ew-pay-amount { flex: 0 0 auto; display: flex; align-items: center; gap: var(--sp-2); }
+
+.ew-pay-figure {
+  font-size: var(--fs-md);
+  font-weight: 600;
+  color: var(--daypay-green);
+  font-variant-numeric: tabular-nums;
+}
+
+.ew-pay-chev { color: var(--text-4); font-size: var(--fs-xs); }
+
+.ew-pay-detail {
+  border-top: 1px dashed var(--border-light);
+  padding: var(--sp-3) var(--sp-3) var(--sp-3);
+  background: var(--bg-sunken);
+}
+
+.ew-pay-line {
+  display: flex;
+  justify-content: space-between;
+  gap: var(--sp-2);
+  font-size: var(--fs-sm);
+  color: var(--text-2);
+  padding: var(--sp-1) 0;
+}
+
+.ew-pay-actions { display: flex; gap: var(--sp-2); flex-wrap: wrap; margin-top: var(--sp-2); }
+
+/* ── Disputed days ───────────────────────────────────────────────────────── */
+
+.ew-disputed { margin: var(--sp-2) 0 0 var(--sp-3); padding-left: var(--sp-3); border-left: 2px solid var(--amber); }
+
+.ew-disputed-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--sp-2);
+  font-size: var(--fs-xs);
+  color: var(--text-3);
+  padding: var(--sp-1) 0;
+}
+
+/* ── Month-end actions ───────────────────────────────────────────────────── */
+
+.ew-monthend { display: flex; flex-direction: column; gap: var(--sp-2); margin-top: var(--sp-4); }
+
+.ew-confirm-actions { display: flex; gap: var(--sp-2); justify-content: flex-end; margin-top: var(--sp-2); }
+
+/* ── Employee view ───────────────────────────────────────────────────────── */
+
+.ew-code {
+  font-family: var(--font-mono);
+  font-size: var(--fs-lg);
+  font-weight: 600;
+  letter-spacing: .22em;
+  text-align: center;
+  text-transform: uppercase;
+}
+
+.ew-foldhead {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--sp-2);
+  width: 100%;
+  background: none;
+  border: 0;
+  font: inherit;
+  font-size: var(--fs-sm);
+  font-weight: 700;
+  color: var(--text-2);
+  padding: 0;
+  cursor: pointer;
+  text-align: left;
+}
+
+.ew-leave { display: flex; justify-content: center; margin-top: var(--sp-2); }
+
+/* ── Invite code in the roster ───────────────────────────────────────────── */
+
+.ew-invite-wrap { margin-top: var(--sp-2); border-top: 1px solid var(--border-light); padding-top: var(--sp-2); }
+
+.ew-invite-row { display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap; }
+
+.ew-invite-code {
+  font-family: var(--font-mono);
+  font-size: var(--fs-lg);
+  font-weight: 600;
+  letter-spacing: .18em;
+  color: var(--daypay-navy);
+  background: var(--bg-sunken);
+  border: 1px dashed var(--border-strong);
+  border-radius: 9px;
+  padding: var(--sp-2) var(--sp-3);
+  user-select: all;
+}
+
+.ew-invite-used { font-size: var(--fs-xs); color: var(--text-3); }
+
+/* ── Dashboard ───────────────────────────────────────────────────────────── */
+
+.ew-dash { display: flex; flex-direction: column; gap: var(--sp-2); }
+
+.ew-board-head {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: var(--sp-2);
+}
+
+.ew-board-label {
+  font-size: var(--fs-label);
+  font-weight: 600;
+  text-transform: none;
+  letter-spacing: 0.01em;
+  color: var(--text-3);
+}
+
+.ew-board-date {
+  font-size: var(--fs-page);
+  font-weight: var(--fw-title);
+  line-height: var(--lh-title);
+  color: var(--text);
+  margin-top: var(--gap-stack);
+  letter-spacing: -.01em;
+}
+
+.ew-stat-good .ew-stat-value { color: var(--daypay-green); }
+.ew-stat-warn .ew-stat-value { color: var(--amber); }
+
+.ew-dash-money {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--sp-2);
+  margin-top: var(--sp-3);
+  padding-top: var(--sp-3);
+  border-top: 1px solid var(--border);
+}
+
+.ew-dash-money-label { font-size: var(--fs-xs); color: var(--text-3); }
+.ew-dash-money-value {
+  font-size: var(--fs-lg);
+  font-weight: 700;
+  color: var(--daypay-green);
+  font-variant-numeric: tabular-nums;
+}
+
+/* ── The missing-by-name list ────────────────────────────────────────────── */
+
+.ew-dash-block { margin-top: var(--sp-3); }
+
+.ew-dash-block-title {
+  display: flex;
+  align-items: center;
+  gap: var(--sp-2);
+  font-size: var(--fs-xs);
+  font-weight: 600;
+  color: var(--text-2);
+  margin-bottom: var(--sp-2);
+}
+
+.ew-dash-count {
+  min-width: 20px;
+  padding: 1px var(--sp-2);
+  border-radius: 99px;
+  background: var(--amber-wash);
+  color: var(--amber);
+  font-size: var(--fs-xs);
+  font-weight: 600;
+  text-align: center;
+}
+
+.ew-mini-list {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
+  gap: var(--sp-2);
+}
+
+.ew-mini {
+  display: flex;
+  align-items: center;
+  gap: var(--sp-2);
+  min-width: 0;
+  padding: var(--sp-2) var(--sp-2);
+  background: var(--bg-sunken);
+  border: 1px solid var(--border);
+  border-radius: 11px;
+}
+
+.ew-avatar-sm {
+  width: 26px;
+  height: 26px;
+  font-size: var(--fs-label);
+  border-radius: 9px;
+}
+
+.ew-mini-body { min-width: 0; flex: 1 1 auto; }
+
+.ew-mini-name {
+  font-size: var(--fs-sm);
+  font-weight: 600;
+  color: var(--text);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.ew-mini-sub {
+  font-size: var(--fs-xs);
+  color: var(--text-4);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+/* ── Notes, chips, footers ───────────────────────────────────────────────── */
+
+.ew-dash-note {
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-3);
+}
+
+.ew-dash-done { color: var(--daypay-green); font-weight: 600; }
+
+.ew-dash-chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--sp-2);
+  margin-top: var(--sp-2);
+}
+
+.ew-dash-foot {
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-4);
+  margin: var(--sp-3) 0 0;
+  padding-top: var(--sp-2);
+  border-top: 1px solid var(--border);
+}
+
+/* An inline link that reads as part of a sentence, not a button. */
+.ew-linkbtn {
+  margin-left: var(--sp-1);
+  padding: 0;
+  background: none;
+  border: 0;
+  font: inherit;
+  font-weight: 700;
+  color: var(--daypay-green);
+  cursor: pointer;
+}
+.ew-linkbtn:hover { text-decoration: underline; }
+
+@media (max-width: 420px) {
+  .ew-mini-list { grid-template-columns: 1fr; }
+}
+
+/* A one-line explanation at the top of a pane that is not the daily routine. */
+.ew-pane-note {
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-4);
+  margin: 0 0 var(--sp-3);
+  padding: var(--sp-2) var(--gap-page);
+  background: var(--bg-sunken);
+  border: 1px solid var(--border);
+  border-radius: 11px;
+}
+
+/* Four stats in a row is a lopsided 3+1 on a narrow phone. Two by two. */
+@media (max-width: 420px) {
+  .ew-dash .ew-summary { grid-template-columns: repeat(2, 1fr); }
+}
+
+/* ── Contractors ─────────────────────────────────────────────────────────── */
+
+.ew-contractors { margin-top: var(--sp-3); }
+
+.ew-contractor-row {
+  display: flex;
+  align-items: center;
+  gap: var(--sp-2);
+  width: 100%;
+  padding: var(--sp-2) var(--sp-3);
+  background: var(--bg-sunken);
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  text-align: left;
+  cursor: pointer;
+  font: inherit;
+  color: inherit;
+}
+.ew-contractor-row + .ew-contractor-row { margin-top: var(--sp-2); }
+.ew-contractor-row:hover { background: var(--bg-cell-hover); }
+
+.ew-contractor-body { flex: 1 1 auto; min-width: 0; }
+
+.ew-contractor-nums {
+  display: flex;
+  align-items: baseline;
+  gap: var(--sp-1);
+  flex: 0 0 auto;
+  font-variant-numeric: tabular-nums;
+}
+
+.ew-contractor-present { font-size: var(--fs-md); font-weight: 600; color: var(--daypay-green); }
+.ew-contractor-sep { font-size: var(--fs-sm); color: var(--text-4); }
+.ew-contractor-expected { font-size: var(--fs-sm); font-weight: 600; color: var(--text-3); }
+.ew-contractor-cap {
+  font-size: var(--fs-label);
+  font-weight: 600;
+  text-transform: none;
+  letter-spacing: 0.01em;
+  color: var(--text-4);
+  margin-left: var(--sp-1);
+}
+
+/* ── Contractor detail ───────────────────────────────────────────────────── */
+
+.ew-contractor { display: flex; flex-direction: column; gap: var(--sp-2); }
+
+.ew-section-label {
+  font-size: var(--fs-label);
+  font-weight: 600;
+  text-transform: none;
+  letter-spacing: 0.01em;
+  color: var(--text-3);
+  margin-top: var(--sp-1);
+}
+
+/* ── Worker card ─────────────────────────────────────────────────────────── */
+
+.ew-worker {
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 13px;
+  padding: var(--sp-3);
+}
+.ew-worker.is-present { border-color: var(--daypay-green); }
+
+.ew-worker-head { display: flex; align-items: center; gap: var(--sp-2); }
+.ew-worker-body { flex: 1 1 auto; min-width: 0; }
+
+.ew-worker-today {
+  display: flex;
+  align-items: center;
+  gap: var(--sp-2);
+  margin-top: var(--sp-2);
+  padding-top: var(--sp-2);
+  border-top: 1px solid var(--border);
+  font-size: var(--fs-xs);
+  color: var(--text-3);
+}
+
+.ew-worker-figures {
+  display: flex;
+  gap: var(--sp-4);
+  margin-top: var(--sp-2);
+  padding-top: var(--sp-2);
+  border-top: 1px solid var(--border);
+}
+
+.ew-worker-figure { display: flex; flex-direction: column; gap: var(--gap-stack); }
+
+.ew-worker-num {
+  font-size: var(--fs-lg);
+  font-weight: 700;
+  color: var(--text);
+  font-variant-numeric: tabular-nums;
+  line-height: var(--lh-tight);
+}
+.ew-worker-num-quiet { color: var(--text-3); }
+
+.ew-worker-cap {
+  font-size: var(--fs-label);
+  font-weight: 600;
+  text-transform: none;
+  letter-spacing: 0.01em;
+  color: var(--text-4);
+}
+
+/* ── Selects ─────────────────────────────────────────────────────────────── */
+
+.ew-select {
+  padding: var(--sp-2) var(--sp-2);
+  background: var(--bg-elevated);
+  border: 1px solid var(--border-strong);
+  border-radius: 9px;
+  font: inherit;
+  font-size: var(--fs-sm);
+  color: var(--text);
+  max-width: 100%;
+}
+.ew-select:focus { outline: 2px solid var(--daypay-green); outline-offset: -1px; }
+.ew-select:disabled { opacity: .5; }
+
+.ew-select-sm {
+  font-size: var(--fs-xs);
+  padding: var(--sp-2) var(--sp-2);
+  max-width: 116px;
+}
+
+/* A filename or identifier quoted inside a sentence. */
+.ew-code-inline {
+  font-family: var(--font-mono);
+  font-size: var(--fs-xs);
+  padding: 1px var(--sp-1);
+  border-radius: 5px;
+  background: var(--bg-cell-hover);
+  color: var(--text-2);
+  word-break: break-all;
+}
+
+/* ── Attendance: the employer's daily code ───────────────────────────────── */
+
+.ew-btn-secondary {
+  background: var(--bg-cell-hover);
+  color: var(--text);
+  border-color: var(--border-strong);
+}
+.ew-btn-secondary:hover:not(:disabled) { filter: brightness(.97); }
+
+.ew-att-pick {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--sp-2);
+  margin-top: var(--sp-2);
+}
+
+/* The code exists to be read out loud across a site or copied onto a board.
+   It is the one place in this app where big and plain is the whole design. */
+.ew-codebox {
+  margin-top: var(--sp-3);
+  padding: var(--sp-4) var(--sp-3);
+  background: var(--bg-sunken);
+  border: 1px dashed var(--border-strong);
+  border-radius: 13px;
+  text-align: center;
+}
+
+.ew-code-label {
+  font-size: var(--fs-label);
+  font-weight: 600;
+  text-transform: none;
+  letter-spacing: 0.01em;
+  color: var(--text-3);
+}
+
+.ew-code-big {
+  font-family: var(--font-mono);
+  font-size: 42px;
+  font-weight: 700;
+  letter-spacing: .18em;
+  line-height: var(--lh-tight);
+  color: var(--daypay-green);
+  margin: var(--sp-2) 0 var(--sp-1);
+  font-variant-numeric: tabular-nums;
+  /* The letter-spacing pushes the last digit off-centre; nudge it back. */
+  text-indent: .18em;
+}
+
+.ew-code-sub {
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-4);
+  max-width: 32ch;
+  margin: 0 auto;
+}
+
+.ew-att-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--sp-2);
+  margin-top: var(--sp-3);
+}
+
+/* ── Attendance: the worker checking in ──────────────────────────────────── */
+
+.ew-checkin-q {
+  font-size: var(--fs-md);
+  font-weight: 600;
+  color: var(--text);
+  letter-spacing: -.01em;
+}
+
+.ew-checkin-sub {
+  font-size: var(--fs-sm);
+  line-height: var(--lh-body);
+  color: var(--text-3);
+  margin: 0;
+}
+
+.ew-code-entry {
+  display: flex;
+  gap: var(--sp-2);
+  margin-top: var(--sp-3);
+  align-items: stretch;
+}
+
+.ew-code-input {
+  flex: 1 1 auto;
+  min-width: 0;
+  padding: var(--sp-3) var(--sp-3);
+  background: var(--bg-sunken);
+  border: 1px solid var(--border-strong);
+  border-radius: 11px;
+  font-family: var(--font-mono);
+  font-size: var(--fs-xl);
+  font-weight: 700;
+  letter-spacing: .22em;
+  text-align: center;
+  color: var(--text);
+  font-variant-numeric: tabular-nums;
+}
+.ew-code-input::placeholder { color: var(--text-4); letter-spacing: .22em; }
+.ew-code-input:focus { outline: 2px solid var(--daypay-green); outline-offset: -1px; }
+.ew-code-input:disabled { opacity: .6; }
+
+/* A wrong code is an ordinary event, not a crash. It reads as a sentence. */
+.ew-checkin-refusal {
+  display: flex;
+  align-items: flex-start;
+  gap: var(--sp-2);
+  margin-top: var(--sp-3);
+  padding: var(--sp-2) var(--sp-3);
+  background: var(--amber-wash);
+  border: 1px solid var(--amber);
+  border-radius: 11px;
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-2);
+}
+
+.ew-checkin-x { color: var(--amber); font-weight: 800; flex: 0 0 auto; }
+
+/* ── Attendance: success ─────────────────────────────────────────────────── */
+
+.ew-checkin-done { text-align: center; }
+
+.ew-checkin-tick {
+  width: 44px;
+  height: 44px;
+  margin: 2px auto 9px;
+  border-radius: 50%;
+  background: var(--daypay-green-light);
+  color: var(--daypay-green);
+  font-size: var(--fs-xl);
+  font-weight: 700;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.ew-checkin-title { font-size: var(--fs-lg); font-weight: 700; color: var(--text); }
+.ew-checkin-note {
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-4);
+  margin: var(--sp-2) 0 0;
+}
+
+@media (max-width: 420px) {
+  .ew-code-big { font-size: 36px; }
+  .ew-code-entry { flex-direction: column; }
+  .ew-code-entry .ew-btn { width: 100%; }
+}
+
+/* ── Crash screen ────────────────────────────────────────────────────────── */
+
+/* Shown when one pane throws during render. Blank would be worse: the
+   employer cannot tell a crash from a network problem from a broken login. */
+
+.ew-crash { border-color: var(--danger); }
+
+.ew-crash-title {
+  font-size: var(--fs-md);
+  font-weight: 700;
+  color: var(--text);
+}
+
+.ew-crash-body {
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-3);
+  margin: var(--sp-2) 0 0;
+}
+
+.ew-crash-detail {
+  margin: var(--sp-3) 0 0;
+  padding: var(--sp-2) var(--sp-3);
+  background: var(--bg-sunken);
+  border: 1px solid var(--border);
+  border-radius: 9px;
+  font-family: var(--font-mono);
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-2);
+  white-space: pre-wrap;
+  word-break: break-word;
+}
+
+.ew-crash-hint {
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-4);
+  margin: var(--sp-3) 0 0;
+}
+
+/* ── Phase 6: corrections, the worker's calendar, overtime, audit ─────────── */
+/*
+ * Everything below uses the tokens above and nothing else, so the dark theme
+ * keeps working without a second set of rules. The grid deliberately matches
+ * the worker's own calendar: two people looking at the same month should not
+ * have to learn two layouts.
+ */
+
+/* The month grid, shared by the worker's screen and the employer's. */
+.ew-mgrid {
+  display: flex;
+  flex-direction: column;
+  gap: var(--sp-1);
+  margin: var(--sp-3) 0 var(--sp-1);
+}
+
+.ew-mgrid-head,
+.ew-mgrid-week {
+  display: grid;
+  grid-template-columns: repeat(7, 1fr);
+  gap: var(--sp-1);
+}
+
+.ew-mgrid-dow {
+  text-align: center;
+  font-size: var(--fs-label);
+  letter-spacing: 0.01em;
+  text-transform: none;
+  color: var(--text-4);
+  padding-bottom: 2px;
+}
+
+.ew-mgrid-cell {
+  position: relative;
+  aspect-ratio: 1 / 1;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border: 1px solid var(--border-light);
+  border-radius: 8px;
+  background: var(--bg-elevated-2);
+  color: var(--text-3);
+  font: inherit;
+  font-size: var(--fs-xs);
+  cursor: pointer;
+  transition: background .12s ease, border-color .12s ease;
+}
+
+.ew-mgrid-cell.is-blank {
+  background: transparent;
+  border-color: transparent;
+  cursor: default;
+}
+
+.ew-mgrid-cell.is-marked {
+  background: var(--bg-elevated);
+  border-color: var(--border-strong);
+  color: var(--text);
+  font-weight: 600;
+}
+
+/* Settled days are solid; claims are dashed. One glance tells an employer
+   whether what they are looking at has been confirmed. */
+.ew-mgrid-cell.is-confirmed {
+  background: var(--daypay-navy);
+  border-color: var(--daypay-navy);
+  color: #fff;
+}
+
+.ew-mgrid-cell.is-unconfirmed {
+  border-style: dashed;
+  border-color: var(--amber);
+  color: var(--amber);
+}
+
+.ew-mgrid-cell.is-disputed {
+  border-style: dashed;
+  border-color: var(--danger);
+  color: var(--danger);
+}
+
+.ew-mgrid-cell.is-overtime { box-shadow: inset 0 -3px 0 var(--amber); }
+.ew-mgrid-cell.is-weekend  { box-shadow: inset 0 -3px 0 var(--daypay-green); }
+.ew-mgrid-cell.is-holiday  { box-shadow: inset 0 -3px 0 var(--stamp-ot-bg); }
+.ew-mgrid-cell.is-leave    { box-shadow: inset 0 -3px 0 var(--text-4); }
+
+.ew-mgrid-cell:hover:not(.is-blank) { background: var(--bg-cell-hover); }
+.ew-mgrid-cell.is-confirmed:hover { background: var(--daypay-navy-light); }
+
+/* A correction is waiting on this day. The dot, not a border, so it cannot be
+   confused with the status the border already carries. */
+.ew-mgrid-dot {
+  position: absolute;
+  top: 5px;
+  right: 5px;
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: var(--amber);
+}
+
+.ew-mgrid-cell.is-confirmed .ew-mgrid-dot { background: #FDE68A; }
+
+.ew-mgrid-day { pointer-events: none; }
+
+/* ── The worker's request form ───────────────────────────────────────────── */
+
+.ew-corr-tools { display: flex; gap: var(--sp-2); margin: var(--sp-3) 0 var(--sp-1); }
+
+.ew-corr-form { margin-top: var(--sp-3); }
+
+.ew-choice-list { display: flex; flex-direction: column; gap: var(--sp-2); margin-top: var(--sp-2); }
+
+.ew-choice {
+  display: flex;
+  flex-direction: column;
+  gap: var(--gap-stack);
+  text-align: left;
+  padding: var(--sp-2) var(--sp-3);
+  border: 1px solid var(--border-strong);
+  border-radius: 9px;
+  background: var(--bg-elevated);
+  color: var(--text);
+  font: inherit;
+  cursor: pointer;
+}
+
+.ew-choice.is-chosen {
+  border-color: var(--daypay-navy);
+  background: var(--bg-cell-hover);
+}
+
+.ew-choice-label { font-size: var(--fs-sm); font-weight: 500; }
+.ew-choice-hint { font-size: var(--fs-xs); color: var(--text-3); line-height: var(--lh-snug); }
+
+.ew-datestep { display: flex; align-items: center; gap: var(--sp-2); }
+.ew-inline-fields { display: grid; grid-template-columns: auto 1fr; gap: var(--sp-2) var(--sp-2); align-items: center; margin-top: var(--sp-2); }
+
+.ew-corr-actions { display: flex; flex-wrap: wrap; gap: var(--sp-2); align-items: center; margin-top: var(--sp-3); }
+
+/* ── Requests, as read by either party ───────────────────────────────────── */
+
+.ew-corr-row,
+.ew-corr-card {
+  border: 1px solid var(--border-light);
+  border-left: 3px solid var(--border-strong);
+  border-radius: 9px;
+  padding: var(--sp-2) var(--sp-3);
+  margin-top: var(--sp-2);
+  background: var(--bg-elevated);
+}
+
+.ew-corr-card.status-open { border-left-color: var(--amber); }
+.ew-corr-card.status-approved { border-left-color: var(--daypay-green); }
+.ew-corr-card.status-rejected { border-left-color: var(--danger); }
+
+.ew-corr-row-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--sp-2);
+}
+
+.ew-corr-msg { font-size: var(--fs-xs); line-height: var(--lh-body); color: var(--text-2); margin: var(--sp-2) 0 0; }
+.ew-corr-effect { font-size: var(--fs-xs); line-height: var(--lh-body); color: var(--text-3); margin: var(--sp-2) 0 0; }
+.ew-corr-decision { font-size: var(--fs-xs); line-height: var(--lh-body); color: var(--text-2); margin: var(--sp-2) 0 0; }
+.ew-corr-decision-label {
+  display: block;
+  font-size: var(--fs-label);
+  letter-spacing: 0.01em;
+  text-transform: none;
+  color: var(--text-4);
+}
+.ew-corrections-meta { font-size: var(--fs-xs); color: var(--text-3); margin-top: var(--sp-1); }
+
+.ew-dayrow.is-asked { border-left: 3px solid var(--amber); }
+.ew-dayrow-source { font-size: var(--fs-label); color: var(--text-4); margin-top: var(--sp-1); }
+.ew-dayrow-actions { display: flex; flex-direction: column; align-items: flex-end; gap: var(--sp-1); }
+
+/* ── Worker detail ───────────────────────────────────────────────────────── */
+
+.ew-worker-view { display: flex; flex-direction: column; gap: var(--sp-3); }
+
+.ew-worker-btn {
+  width: 100%;
+  text-align: left;
+  font: inherit;
+  color: inherit;
+  cursor: pointer;
+  position: relative;
+}
+
+.ew-worker-btn:hover { background: var(--bg-cell-hover); }
+
+.ew-worker-open {
+  position: absolute;
+  right: 12px;
+  bottom: 10px;
+  font-size: var(--fs-label);
+  color: var(--text-4);
+}
+
+.ew-sheet {
+  border: 1px solid var(--daypay-navy);
+  border-radius: 12px;
+  padding: var(--sp-4) var(--pad-row-x);
+  background: var(--bg-elevated);
+}
+
+.ew-sheet-head {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: var(--sp-2);
+}
+
+.ew-sheet-figures { display: flex; gap: var(--sp-4); margin: var(--sp-2) 0 var(--sp-2); flex-wrap: wrap; }
+.ew-sheet-meta { display: flex; flex-wrap: wrap; gap: var(--sp-2); align-items: center; margin-bottom: var(--sp-2); }
+.ew-sheet-actions { display: flex; flex-wrap: wrap; gap: var(--sp-2); align-items: center; margin-top: var(--sp-3); }
+
+/* Overtime assignment: four taps, one row changed, clearly reversible. */
+.ew-kind-row { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-1); }
+
+.ew-kind-btn {
+  padding: var(--sp-2) var(--sp-3);
+  border: 1px solid var(--border-strong);
+  border-radius: 999px;
+  background: var(--bg-elevated);
+  color: var(--text-2);
+  font: inherit;
+  font-size: var(--fs-xs);
+  cursor: pointer;
+}
+
+.ew-kind-btn.is-on {
+  background: var(--daypay-navy);
+  border-color: var(--daypay-navy);
+  color: #fff;
+  font-weight: 600;
+}
+
+.ew-kind-btn:disabled { opacity: .55; cursor: default; }
+
+/* ── Audit trail ─────────────────────────────────────────────────────────── */
+
+.ew-audit { display: flex; flex-direction: column; }
+
+.ew-audit-row {
+  display: grid;
+  grid-template-columns: 118px 1fr;
+  gap: var(--sp-1) var(--sp-2);
+  padding: var(--sp-2) 0;
+  border-bottom: 1px solid var(--border-light);
+  font-size: var(--fs-xs);
+}
+
+.ew-audit-row:last-child { border-bottom: 0; }
+.ew-audit-when { color: var(--text-4); font-variant-numeric: tabular-nums; }
+.ew-audit-what { color: var(--text); font-weight: 600; }
+.ew-audit-why { grid-column: 2; color: var(--text-3); font-size: var(--fs-xs); }
+
+.ew-audit-row.tone-create .ew-audit-what { color: var(--daypay-green); }
+.ew-audit-row.tone-good   .ew-audit-what { color: var(--daypay-green); }
+.ew-audit-row.tone-warn   .ew-audit-what { color: var(--amber); }
+.ew-audit-row.tone-amend  .ew-audit-what { color: var(--text); }
+
+@media (max-width: 420px) {
+  .ew-audit-row { grid-template-columns: 1fr; }
+  .ew-audit-why { grid-column: 1; }
+  .ew-mgrid-cell { font-size: var(--fs-xs); border-radius: 7px; }
+}
+
+/* ── Phase 7 — billing ───────────────────────────────────────────────────────
+   Two shapes only: a contractor row you can bill, and the document that comes
+   out of it. The document is deliberately the calmer of the two — it is the
+   thing that gets printed and handed to somebody. */
+
+.ew-bill-row {
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  /* A card is a card: the same insets as every other one. */
+  padding: var(--pad-row-y) var(--pad-row-x);
+}
+
+.ew-bill-row + .ew-bill-row { margin-top: var(--sp-2); }
+
+.ew-bill-head {
+  display: flex;
+  align-items: flex-start;
+  gap: var(--sp-3);
+}
+
+.ew-bill-body { flex: 1 1 auto; min-width: 0; }
+
+.ew-bill-amount {
+  flex: 0 0 auto;
+  font-size: var(--fs-md);
+  font-weight: 700;
+  color: var(--daypay-green);
+  font-variant-numeric: tabular-nums;
+  text-align: right;
+}
+
+.ew-bill-flags {
+  display: flex;
+  gap: var(--sp-2);
+  flex-wrap: wrap;
+  margin-top: var(--sp-2);
+}
+
+.ew-bill-actions {
+  display: flex;
+  gap: var(--sp-2);
+  flex-wrap: wrap;
+  align-items: center;
+  margin-top: var(--sp-3);
+}
+
+.ew-bill-note {
+  margin: 0;
+  flex: 1 1 100%;
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-3);
+}
+
+/* ── An issued document ── */
+
+.ew-inv {
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  padding: var(--sp-3);
+}
+
+.ew-inv + .ew-inv { margin-top: var(--sp-2); }
+
+/* A voided invoice must never be mistakeable for a live one at a glance. */
+.ew-inv-void {
+  border-style: dashed;
+  background: var(--bg-sunken);
+}
+
+.ew-inv-void .ew-bill-amount {
+  color: var(--text-4);
+  text-decoration: line-through;
+}
+
+.ew-inv-head {
+  display: flex;
+  align-items: flex-start;
+  gap: var(--sp-3);
+}
+
+.ew-inv-body { flex: 1 1 auto; min-width: 0; }
+
+.ew-inv-number {
+  display: flex;
+  align-items: center;
+  gap: var(--sp-2);
+  flex-wrap: wrap;
+  font-size: var(--fs-md);
+  font-weight: 600;
+  letter-spacing: -0.01em;
+  color: var(--text);
+  font-variant-numeric: tabular-nums;
+}
+
+.ew-inv-void-note {
+  margin: var(--sp-2) 0 0;
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--danger);
+}
+
+.ew-inv-actions {
+  display: flex;
+  gap: var(--sp-2);
+  flex-wrap: wrap;
+  margin-top: var(--sp-3);
+}
+
+/* On a phone the four columns still fit; anything tighter scrolls rather than
+   squashing the amounts into two lines. */
+.ew-inv-table-wrap {
+  margin-top: var(--sp-3);
+  overflow-x: auto;
+  -webkit-overflow-scrolling: touch;
+}
+
+.ew-inv-table {
+  width: 100%;
+  min-width: 300px;
+  border-collapse: collapse;
+  font-size: var(--fs-xs);
+}
+
+.ew-inv-table th {
+  text-align: left;
+  font-size: var(--fs-label);
+  text-transform: none;
+  letter-spacing: 0.01em;
+  color: var(--text-4);
+  padding: 0 var(--sp-2) var(--sp-1) 0;
+  border-bottom: 1px solid var(--border-light);
+}
+
+.ew-inv-table td {
+  padding: var(--sp-2) var(--sp-2) var(--sp-2) 0;
+  border-bottom: 1px solid var(--border-light);
+  color: var(--text-2);
+  vertical-align: top;
+}
+
+.ew-inv-table th:not(:first-child),
+.ew-inv-table td:not(:first-child) {
+  text-align: right;
+  white-space: nowrap;
+  font-variant-numeric: tabular-nums;
+}
+
+.ew-inv-table tfoot td {
+  border-bottom: 0;
+  border-top: 1.5px solid var(--border-strong);
+  font-weight: 700;
+  color: var(--text);
+}
+
+.ew-inv-job {
+  display: block;
+  font-size: var(--fs-meta);
+  line-height: var(--lh-row);
+  color: var(--text-4);
+  margin-top: var(--gap-stack);
+}
+
+.ew-inv-money { color: var(--text); font-weight: 600; }
+
+/* ── Voiding ── */
+
+.ew-void-form { padding: var(--sp-4); }
+
+.ew-void-label {
+  display: block;
+  margin: var(--sp-3) 0 var(--sp-1);
+  font-size: var(--fs-xs);
+  font-weight: 500;
+  color: var(--text-2);
+}
+
+.ew-void-input {
+  width: 100%;
+  box-sizing: border-box;
+  padding: var(--sp-2) var(--sp-3);
+  border: 1px solid var(--border-strong);
+  border-radius: 10px;
+  background: var(--bg-elevated);
+  color: var(--text);
+  font: inherit;
+  font-size: var(--fs-sm);
+}
+
+.ew-void-input:focus {
+  outline: 2px solid var(--daypay-green);
+  outline-offset: 1px;
+}
+
+.ew-void-actions {
+  display: flex;
+  gap: var(--sp-2);
+  flex-wrap: wrap;
+  margin-top: var(--sp-3);
+}
+
+@media (max-width: 420px) {
+  .ew-bill-amount { font-size: var(--fs-md); }
+  .ew-inv-number { font-size: var(--fs-sm); }
+}
+
+/* ── Phase 11: the personal attendance PIN ──────────────────────────────────
+   The PIN is shown once and then never again, so its one appearance has to be
+   unmissable: large, monospaced, and set apart from the card around it. This
+   is the same reasoning as the site code in the attendance panel — a number
+   somebody has to read off a screen and write down or say out loud is a
+   typographic job, not a data job. */
+.ew-pin-fresh {
+  margin-top: var(--sp-2);
+  padding: var(--sp-3);
+  border-radius: 12px;
+  background: var(--bg-sunken, #F7F8FA);
+  border: 1px solid var(--border);
+}
+
+.ew-pin-caption {
+  margin: 0 0 var(--sp-2);
+  font-size: var(--fs-label, 11px);
+  font-weight: 600;
+  letter-spacing: 0.01em;
+  text-transform: none;
+  color: var(--text-3);
+}
+
+.ew-pin-value {
+  font-family: var(--font-mono);
+  font-size: 34px;
+  font-weight: 700;
+  letter-spacing: .26em;
+  line-height: var(--lh-tight);
+  color: var(--text);
+  /* The tracking pushes the last digit right by one gap; pull it back so the
+     number sits optically centred rather than visibly off to the left. */
+  margin-left: -.26em;
+  padding: 2px 0 var(--sp-2);
+  user-select: all;
+}
+
+.ew-pin-warn {
+  margin: 0 0 var(--sp-2);
+  font-size: var(--fs-xs);
+  font-weight: 500;
+  line-height: var(--lh-body);
+  color: var(--text-3);
+}
+
+@media (max-width: 420px) {
+  .ew-pin-value { font-size: 28px; }
+}
+/* The "give them a PIN" opt-in on the add-worker form. Its own class so the
+   label can hold a sentence of explanation without the checkbox drifting away
+   from the words it belongs to — the existing .ew-label is uppercase and
+   micro-sized, which is right for a field name and wrong for a promise. */
+.ew-check {
+  display: flex;
+  gap: var(--sp-2);
+  align-items: flex-start;
+  margin-top: var(--sp-3);
+  cursor: pointer;
+  font-size: var(--fs-sm);
+  font-weight: 500;
+  color: var(--text);
+  line-height: var(--lh-body);
+}
+
+.ew-check input {
+  flex: none;
+  margin-top: 2px;
+  width: 16px;
+  height: 16px;
+  accent-color: var(--daypay-green);
+}
+
+.ew-check-sub {
+  display: block;
+  margin-top: var(--sp-1);
+  font-size: var(--fs-xs);
+  font-weight: 500;
+  color: var(--text-3);
+  line-height: var(--lh-body);
+}
+
+/* ── Phase 12: the machine at the worksite ──────────────────────────────────
+   One row per kiosk: what it is called, whether it is linked, and one button
+   that stops it. Laid out like a person row in the roster rather than like a
+   card, because it is the same kind of thing — a thing on this site that has a
+   status and an action. */
+.ew-device {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: var(--sp-3);
+  padding: var(--sp-3) 0;
+  border-top: 1px solid var(--border-light);
+  margin-top: var(--sp-2);
+}
+
+.ew-device:first-of-type { border-top: 0; }
+
+.ew-device-body { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: var(--gap-stack); }
+
+.ew-device-name {
+  display: flex;
+  align-items: center;
+  gap: var(--sp-2);
+  flex-wrap: wrap;
+  font-size: var(--fs-sm);
+  font-weight: 600;
+  color: var(--text);
+}
+
+.ew-device-hint {
+  margin-top: var(--sp-1);
+  font-size: var(--fs-xs);
+  font-weight: 500;
+  color: var(--text-3);
+  line-height: var(--lh-body);
+}
+
+/* ── Today (Phase 4) ─────────────────────────────────────────────────────────
+   The command centre's hero. It is not a card: the figure is the page, and a
+   border around it would say "one more thing on a list" rather than "this is
+   what you came for" (§7 — fewer cards, more sections). */
+.ew-today-head { padding: var(--sp-4) 0 var(--sp-2); }
+
+.ew-today-date {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--sp-3);
+  margin-bottom: var(--sp-3);
+  font-size: var(--fs-sm);
+  color: var(--text-3);
+}
+
+.ew-today-money {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--sp-3);
+  margin-top: var(--sp-4);
+}
+
+.ew-today-money-label { font-size: var(--fs-xs); color: var(--text-3); }
+
+.ew-today-money-value {
+  font-size: var(--fs-2xl);
+  font-weight: var(--fw-hero);
+  color: var(--text);
+  letter-spacing: -0.02em;
+  font-variant-numeric: tabular-nums;
+}
+
+/* The screen's one filled button, full width where a thumb reaches it. */
+.ew-today-cta { width: 100%; margin-top: var(--sp-4); }
+
+.ew-today-amount {
+  font-size: var(--fs-sm);
+  font-weight: var(--fw-value);
+  color: var(--text-2);
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+}
+
+.ew-today-amount.is-money { color: var(--text); }
+
+/* ── Attendance (Phase 5) ────────────────────────────────────────────────────
+   One screen, three ranges, and one list of people per day. The rows are
+   dividers inside a single container rather than a card each: twenty workers on
+   a phone were twenty bordered cards, and the page read as a pile rather than a
+   day. Every colour here is a token, so both themes are decisions already made. */
+.ew-att { display: flex; flex-direction: column; gap: var(--sp-3); }
+
+.ew-att-note {
+  margin: 0;
+  font-size: var(--fs-sm);
+  line-height: var(--lh-body);
+  color: var(--text-3);
+}
+
+.ew-att-day-note { font-size: var(--fs-body); line-height: var(--lh-row); color: var(--text-3); margin-top: var(--gap-stack); }
+
+/* ── the week, and the month ──────────────────────────────────────────────── */
+
+.ew-att-week,
+.ew-att-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: var(--sp-1); }
+
+.ew-att-wd {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 1px;
+  min-height: var(--tap);
+  padding: var(--sp-1) 0;
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  background: var(--bg-elevated);
+  color: var(--text-2);
+  font: inherit;
+  cursor: pointer;
+}
+
+.ew-att-wd-dow { font-size: var(--fs-label); color: var(--text-3); }
+.ew-att-wd-day { font-size: var(--fs-sm); font-weight: var(--fw-value); }
+.ew-att-wd-n { font-size: var(--fs-label); font-weight: var(--fw-value); color: var(--green-ink); }
+
+/* Today is a ring, the selected day is filled: two different facts, told apart
+   by more than colour — one is a border, one is the whole cell. */
+.ew-att-wd.is-today,
+.ew-att-cell.is-today { border-color: var(--green-ink); }
+
+.ew-att-wd.is-sel,
+.ew-att-cell.is-sel {
+  background: var(--daypay-navy);
+  border-color: var(--daypay-navy);
+  color: #fff;
+}
+.ew-att-wd.is-sel .ew-att-wd-dow,
+.ew-att-wd.is-sel .ew-att-wd-n,
+.ew-att-cell.is-sel .ew-att-cell-n { color: #fff; }
+
+.ew-att-month-head {
+  display: grid;
+  grid-template-columns: repeat(7, 1fr);
+  gap: var(--sp-1);
+  margin-bottom: var(--sp-1);
+  font-size: var(--fs-label);
+  color: var(--text-4);
+  text-align: center;
+}
+
+.ew-att-cell {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 1px;
+  min-height: var(--tap);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  background: var(--bg-elevated);
+  color: var(--text-2);
+  font: inherit;
+  font-size: var(--fs-sm);
+  font-weight: var(--fw-value);
+  cursor: pointer;
+}
+
+.ew-att-cell.is-gap { border-color: transparent; background: none; }
+.ew-att-cell-n { font-size: var(--fs-label); font-weight: var(--fw-value); color: var(--green-ink); }
+
+/* ── one person, one day ──────────────────────────────────────────────────── */
+
+.ew-att-row {
+  display: flex;
+  align-items: flex-start;
+  gap: var(--sp-3);
+  min-height: var(--tap);
+  padding: var(--pad-row-y) var(--pad-row-x);
+}
+.ew-att-row + .ew-att-row { border-top: 1px solid var(--border-light); }
+.ew-att-row.is-marked { background: var(--green-wash); }
+
+/* The same text stack as the list row — the name and the line under it were a pair
+   of inline <span>s here too, separated by a 1px margin that did nothing. */
+.ew-att-body {
+  flex: 1 1 auto;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: var(--gap-stack);
+}
+.ew-att-name { font-size: var(--fs-row); font-weight: var(--fw-value); line-height: var(--lh-row); color: var(--text); }
+.ew-att-sub { font-size: var(--fs-body); font-weight: var(--fw-body); line-height: var(--lh-row); color: var(--text-3); }
+
+.ew-att-meta {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: var(--sp-2);
+  margin-top: var(--sp-2);
+}
+
+.ew-att-amount {
+  font-size: var(--fs-sm);
+  font-weight: var(--fw-value);
+  color: var(--text-2);
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+}
+.ew-att-amount.is-money { color: var(--text); }
+
+.ew-att-kinds { display: flex; gap: var(--sp-1); flex-wrap: wrap; margin-top: var(--sp-2); }
+
+/* The one control that writes a day. Neutral once the day is recorded, because
+   the button then offers the opposite act — green means "working", and taking a
+   day back is not that. */
+.ew-att-mark {
+  flex: 0 0 auto;
+  min-height: var(--tap);
+  min-width: 76px;
+  padding: 0 var(--sp-3);
+  border-radius: var(--radius);
+  border: 1px solid var(--green-ink);
+  background: transparent;
+  color: var(--green-ink);
+  font: inherit;
+  font-size: var(--fs-sm);
+  font-weight: var(--fw-value);
+  cursor: pointer;
+}
+.ew-att-mark.is-on { border-color: var(--border-strong); color: var(--text-2); }
+.ew-att-mark:disabled { opacity: .5; cursor: default; }
+
+/* What just happened, said once. It holds its line even when empty, so the list
+   does not jump when a mark lands. */
+.ew-att-said {
+  min-height: 18px;
+  margin: 0;
+  font-size: var(--fs-sm);
+  color: var(--green-ink);
+}
+
+.ew-att-foot {
+  margin: var(--sp-3) 0 0;
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-4);
+}
+
+
+/* ── Phase 6 — People: finding a person, and opening one ─────────────────────
+
+   The roster used to be a list you could only read. It is a list you can search
+   now, and every row is a door onto that worker's own screen. Three pieces:
+
+     · `.ew-find` — the search box and the filter above the list. The filter is
+       the app's one segmented control (index.css:269), not a new kind of toggle,
+       and it is the same three words the row's status chip uses, so the filter
+       and the chip cannot describe different people;
+     · `.ew-row-open` — the upper half of a row, as a button. It is reset to look
+       exactly like the div it replaced, and it keeps the 44px minimum target;
+     · `.ew-row-go` — the chevron, which is what makes a row read as a door.
+
+   Nothing here carries meaning by colour alone, and nothing here is off the type
+   ramp. */
+
+.ew-find {
+  display: flex;
+  flex-direction: column;
+  gap: var(--sp-2);
+  margin-bottom: var(--sp-3);
+}
+
+.ew-find-input { width: 100%; }
+
+/* The control is full width, so each label gets a third of a phone. 13px is what
+   keeps "Not registered" on one line on a 360px screen. */
+.ew-find-filter button { font-size: var(--fs-xs); }
+
+.ew-find-count {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--sp-3);
+  font-size: var(--fs-xs);
+  color: var(--text-3);
+}
+
+/* A button that has to look like the div it replaced: the row's own padding is
+   on `.ew-row`, and the avatar/text/chip line inside it is now the target. */
+.ew-row-open {
+  width: 100%;
+  min-height: var(--tap);
+  margin: 0;
+  padding: 0;
+  background: none;
+  border: 0;
+  border-radius: 10px;
+  text-align: left;
+  font: inherit;
+  color: inherit;
+  cursor: pointer;
+}
+
+.ew-row-open:hover .ew-row-name { text-decoration: underline; }
+
+.ew-row-go {
+  flex: 0 0 auto;
+  align-self: center;
+  font-size: var(--fs-xl);
+  line-height: 1;
+  color: var(--text-4);
+}
+
+/* ── Phase 6 — the roster's two numbers, as one line of context ───────────── */
+
+.ew-glance {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: var(--sp-2);
+  margin: 0 0 var(--sp-3);
+  font-size: var(--fs-sm);
+  color: var(--text-3);
+}
+
+.ew-glance strong { font-weight: var(--fw-value); color: var(--text); }
+.ew-glance-sep { color: var(--text-4); }
+/* Not the only signal — the line says "with no rate yet" in words. */
+.ew-glance-warn strong { color: var(--amber); }
+
+/* ── Phase 7 — the worker profile: one person, in one place ──────────────────
+
+   This screen used to open with four stat cards, a card per section and a
+   paragraph telling the employer to go somewhere else to record a day. It opens
+   with the person now, then what they earn, then what the month is worth — and
+   the figures are read off the stored rows, never recomputed here.
+
+   Three ideas, and nothing else:
+
+     · `.ew-prof*` — who this is. The name is the heading, the trade and the
+       contractor are one line, and the account state is a chip plus ONE sentence
+       in words. "Not registered" is a fact about a login: a worker without an
+       account still has a job, still has days and is still paid for them.
+     · `.ew-prof-pay*` — the month's money as one figure with the facts that made
+       it underneath. Not four cards: a card is a thing to read before the thing
+       you came for, and all four numbers here answer one question.
+     · `.ew-mgrid*` / `.ew-sheet*` / `.ew-corr*` — the calendar, the day sheet and
+       the corrections queue, kept exactly as they were; they are the screen's
+       substance and Phase 7 moved nothing about them except where the sheet
+       appears. */
+
+.ew-prof {
+  display: flex;
+  flex-direction: column;
+  gap: var(--sp-3);
+  padding: var(--sp-4);
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+}
+
+.ew-prof-who { display: flex; align-items: center; gap: var(--sp-3); }
+/* A worker's name and the line under it — the same text stack as a list row, and
+   the last place where a pair of inline-ish children were held apart by a 2px
+   margin. The guard in tests/design.test.js found this one after the fix above. */
+.ew-prof-body {
+  flex: 1 1 auto;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: var(--gap-stack);
+}
+
+.ew-prof-sub {
+  font-size: var(--fs-body);
+  line-height: var(--lh-row);
+  color: var(--text-3);
+  overflow-wrap: anywhere;
+}
+
+.ew-prof-chips { display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap; }
+
+.ew-prof-hint {
+  margin: 0;
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-4);
+}
+
+/* ── what the month is worth ───────────────────────────────────────────────── */
+
+.ew-prof-pay {
+  display: flex;
+  flex-direction: column;
+  gap: var(--sp-3);
+}
+
+.ew-prof-hero {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  padding: var(--sp-4);
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+}
+
+.ew-prof-hero-label { font-size: var(--fs-xs); color: var(--text-3); }
+
+.ew-prof-hero-sum {
+  font-size: var(--fs-2xl);
+  font-weight: var(--fw-hero);
+  color: var(--text);
+  letter-spacing: -0.02em;
+  font-variant-numeric: tabular-nums;
+}
+
+/* The facts behind the figure. A definition list rather than cards: they are one
+   thought, and they are read left to right on a phone. */
+.ew-prof-facts {
+  margin: 0;
+  padding: 0 var(--sp-4);
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  overflow: hidden;
+}
+
+.ew-prof-fact {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: var(--sp-3);
+  padding: var(--sp-3) 0;
+}
+
+.ew-prof-fact + .ew-prof-fact { border-top: 1px solid var(--border-light); }
+
+.ew-prof-fact dt {
+  font-size: var(--fs-sm);
+  color: var(--text-2);
+}
+
+/* The explanation sits under the label, so the number keeps the right edge to
+   itself and a long sentence cannot push it off the line. */
+.ew-prof-fact-note {
+  display: block;
+  margin-top: var(--gap-stack);
+  font-size: var(--fs-xs);
+  color: var(--text-4);
+}
+
+.ew-prof-fact dd {
+  margin: 0;
+  flex: 0 0 auto;
+  font-size: var(--fs-lg);
+  font-weight: var(--fw-value);
+  color: var(--text);
+  font-variant-numeric: tabular-nums;
+}
+
+/* Money that is not confirmed yet is not settled money — and the note beside it
+   says so in words, so the amber is agreement rather than the message. */
+.ew-prof-fact dd.is-warn { color: var(--amber); }
+
+.ew-prof-rate {
+  margin: 0;
+  font-size: var(--fs-sm);
+  color: var(--text-2);
+}
+
+.ew-prof-rate-label {
+  display: block;
+  font-size: var(--fs-xs);
+  color: var(--text-4);
+}
+
+.ew-prof-rate.is-missing { color: var(--amber); line-height: var(--lh-body); }
+
+.ew-prof-corr, .ew-prof-error { margin: 0; }
+
+/* ============================================================
+   Phase 8 · a More destination is a screen
+   ------------------------------------------------------------
+   The four screens under More used to open as a row at the foot of
+   the roster: an icon, a title and an action, with no name of its
+   own and nowhere to say what it is for. Each one is a destination
+   now, so each one needs the same three things at the top — its own
+   name, one sentence of job, and its one action — which is .ew-head,
+   already used by Today, Attendance and People.
+
+   Kept to the jobs those screens actually have. The old .ew-tool*
+   block — the compact row that held them at the foot of the roster —
+   went with them; a usage scan found no renderer left.
+   ============================================================ */
+
+.ew-screen > .ew-dash-note:first-of-type {
+  margin-top: var(--sp-2);
+}
+
+/* Who is under each contractor, on the contractor's own row. A name is not a
+   control here, so it reads as text: quieter than the name above it, and set on
+   its own line so a long list wraps inside the row rather than pushing it wide. */
+.ew-contractor-who {
+  margin: var(--sp-1) 0 0;
+  font-size: var(--fs-xs);
+  color: var(--text-3);
+  line-height: var(--lh-body);
+  overflow-wrap: anywhere;
+}
+
+/* The kiosk's "what is this" panel, and its two standing notes. These used to
+   hang off the roster row; they belong to the screen now and are spaced from it. */
+.ew-screen-info {
+  margin-top: var(--sp-3);
+  padding: var(--sp-3) var(--sp-4);
+  background: var(--bg-sunken);
+  border: 1px solid var(--border-light);
+  border-radius: var(--radius);
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-2);
+}
+
+.ew-screen-note {
+  margin: var(--sp-3) 0 0;
+  font-size: var(--fs-xs);
+  line-height: var(--lh-body);
+  color: var(--text-3);
+}
+
+/* ── Phase 9 — polish ────────────────────────────────────────────────────────
+   The last pass over screens that already exist. Nothing here changes what the
+   app records; it is the difference between a screen that works and a screen
+   that reads as finished.
+
+   Two pieces:
+
+     · `.ew-form-title` / `.ew-form-lede` / `.ew-tick` — the add-a-worker step
+       says what it does before it asks for anything. The tick is a confirmation
+       with words beside it, never a colour on its own (§26).
+     · a `:focus-visible` rule for the controls index.css misses. */
+
+.ew-form-title {
+  display: flex;
+  align-items: center;
+  gap: var(--sp-2);
+  margin: 0 0 var(--sp-2);
+  font-size: var(--fs-lg);
+  font-weight: var(--fw-value);
+  letter-spacing: -0.01em;
+  color: var(--text);
+}
+
+/* A tick is a second signal, not the signal: it sits beside the sentence that
+   says the same thing in words. */
+.ew-tick {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex: 0 0 auto;
+  width: 22px;
+  height: 22px;
+  border-radius: 50%;
+  background: var(--green-wash);
+  color: var(--green-ink);
+  font-size: var(--fs-xs);
+  line-height: 1;
+}
+
+.ew-form-lede {
+  margin: 0 0 var(--sp-3);
+  font-size: var(--fs-sm);
+  color: var(--text-3);
+  line-height: var(--lh-body);
+}
+
+select:focus-visible,
+textarea:focus-visible {
+  outline: 2px solid var(--daypay-green);
+  outline-offset: 2px;
+  border-radius: 6px;
+}
+
+/* ══ Desktop (Phase 15) ═══════════════════════════════════════════════════════
+
+   The phone layout is the media query's `else`: nothing above this line is
+   rewritten, and at 1024px the workspace stops being a 480px column in a
+   decorative frame and becomes a window — a rail down the left, and one measured
+   column of content beside it. The audit's finding was blunt: on a 27-inch
+   monitor DayPay was a phone in a box, and the widest breakpoint anywhere in this
+   file was 600px. */
+
+@media (min-width: 1024px) {
+  .ew {
+    /* The rail is fixed to the window, so the pane simply gets out of its way. */
+    padding-left: var(--rail);
+    padding-right: var(--sp-5);
+    padding-bottom: var(--sp-6);
+  }
+
+  /* One column of content, capped and centred in what is left. A 1600px line of
+     text is unreadable and a figure at the far end of one is worse: the cap is
+     what makes the width usable rather than merely large. */
+  .ew > :not(.dp-tabbar) {
+    width: 100%;
+    max-width: var(--content-max);
+    margin-inline: auto;
+  }
+
+  /* Sentences stop at a reading measure. Rows, lists and tables do not. */
+  .ew p { max-width: 78ch; }
+
+  /* ── The navigation, off the bottom of the phone and onto the left ──────────
+     Same element, same four links, same address behind each one, same
+     `aria-current` — only where the marker is drawn changes. */
+  .ew > .dp-tabbar {
+    position: fixed;
+    top: var(--header-h);      /* under the sticky bar, not over it */
+    bottom: 0;
+    left: 0;
+    width: var(--rail);
+    flex-direction: column;
+    align-items: stretch;
+    justify-content: flex-start;
+    gap: var(--sp-1);   /* the phone bar's item gap, so the rail is the same bar */
+    /* The surface is the page's own colour rather than a panel's, so the rail and
+       the bar above it can never show a seam — the bar is translucent, and it sits
+       over exactly what the rest of the page is made of. If the bar is ever taller
+       than --header-h, the rail's first item simply hides behind it for a few
+       pixels; there is no number here that can come between the two. */
+    padding: var(--sp-3);
+    background: var(--bg);
+    border-top: 0;
+    border-right: 1px solid var(--border-light);
+    z-index: 5;                /* below the header's 10 */
+  }
+
+  .ew > .dp-tabbar .dp-tab {
+    flex: 0 0 auto;            /* no longer an equal share of the screen's width */
+    flex-direction: row;
+    justify-content: flex-start;
+    gap: var(--sp-3);
+    padding: 0 var(--sp-3);
+    border-radius: 10px;
+  }
+
+  /* The active marker turns ninety degrees. It is still the same fact, and it is
+     still carried by position and weight rather than by colour alone. */
+  .ew > .dp-tabbar .dp-tab-rule { width: 3px; height: 20px; max-width: none; }
+
+  .ew > .dp-tabbar .dp-tab-label { font-size: var(--fs-sm); }
+
+  /* The calendar is a control, not the page. Seven columns stretched across a
+     metre of desk is all cells and no day. */
+  .ew-att-week,
+  .ew-att-month { max-width: 640px; }
+
+  /* Four groups of two, two columns. The foot line spans both. */
+  .ew-more-pane {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    column-gap: var(--sp-5);
+    align-items: start;
+  }
+
+  .ew-more-pane > .ew-more-foot { grid-column: 1 / -1; }
+}
+
+/* ── Wide: the screens with two jobs (Phase 15) ───────────────────────────────
+   At 1024 there is room for a rail and a column, not for two columns without
+   squeezing each of them back to phone width. From 1280 there is. */
+
+@media (min-width: 1280px) {
+  /* Today: the day and what it needs on the left, what it adds up to and the
+     setup behind it on the right. */
+  .ew-dash {
+    display: grid;
+    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
+    gap: var(--sp-4) var(--sp-5);
+    align-items: start;
+  }
+
+  .ew-dash-col { display: flex; flex-direction: column; gap: var(--sp-2); }
+
+  /* The skeleton is one block: it belongs to both columns. */
+  .ew-dash > .dp-loading { grid-column: 1 / -1; }
+
+  /* Attendance: the calendar on the left — where a day is chosen — and the people
+     on that day on the right, where the day is recorded. The calendar stays put
+     while the roster scrolls, because it is the control for what is beside it. */
+  .ew-att-split {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
+    gap: var(--sp-3) var(--sp-5);
+    align-items: start;
+  }
+
+  .ew-att > .ew-title,
+  .ew-att > .ew-att-note,
+  .ew-att > .ew-att-foot { grid-column: 1 / -1; }
+
+  .ew-att-side {
+    grid-column: 1;
+    position: sticky;
+    top: calc(var(--header-h) + var(--sp-4));
+  }
+
+  .ew-att-main { grid-column: 2; }
+
+  .ew-att-side,
+  .ew-att-main { display: flex; flex-direction: column; gap: var(--sp-3); }
+}
diff --git a/src/fonts.css b/src/fonts.css
new file mode 100644
index 0000000..49bd525
--- /dev/null
+++ b/src/fonts.css
@@ -0,0 +1,103 @@
+/* Self-hosted typefaces — v25.
+ *
+ * These two families used to be fetched from fonts.googleapis.com at runtime,
+ * and the service worker deliberately skips those hosts (it must not try to
+ * cache a CDN). So the font files were never stored on the device, and offline
+ * — a promise this app makes, and a fact of life on a worksite — every screen
+ * silently fell back to a different typeface. Manrope's proportions vanished,
+ * and Geist Mono's figure columns stopped aligning, which is why money looked
+ * ragged on a bad connection and fine on wifi.
+ *
+ * They now ship inside the app and are cached by the service worker with it.
+ * No third-party request, no flash of a fallback on a cold load, and the same
+ * typography on every device and every network.
+ *
+ * ── The naira sign ───────────────────────────────────────────────────────────
+ * Neither Manrope nor Geist Mono contains ₦ (U+20A6) in any weight, and neither
+ * does the upstream Google release. Every ₦ in this app was therefore drawn by
+ * the device's fallback font: a different typeface, at a different weight,
+ * beside figures set in Geist Mono — on the most repeated glyph in a money app.
+ *
+ * The glyph is now built into each of the ten files, from that weight's own N,
+ * so the diagonal, the stems and the joins are genuinely Manrope and Geist Mono
+ * rather than a graft. Bar thickness is 9.5% of the cap height (measured from a
+ * reference design, where the naira bars are about 8% while the stems are ~15%
+ * — copying the stem closed the counters at heavy weights); bar centres sit at
+ * cap-height/2 ± 0.0907·cap. The builder is scripts/build-naira.py, the proof is
+ * tests/design.test.js, and the geometry is recorded there rather than here.
+ *
+ * Licensed OFL-1.1. © the Manrope and Geist Mono authors; modifications (the
+ * added U+20A6) released under the same licence.
+ */
+
+@font-face {
+  font-family: 'Manrope';
+  font-style: normal;
+  font-weight: 400;
+  font-display: swap;
+  src: url('/fonts/manrope-400.woff2') format('woff2');
+}
+@font-face {
+  font-family: 'Manrope';
+  font-style: normal;
+  font-weight: 500;
+  font-display: swap;
+  src: url('/fonts/manrope-500.woff2') format('woff2');
+}
+@font-face {
+  font-family: 'Manrope';
+  font-style: normal;
+  font-weight: 600;
+  font-display: swap;
+  src: url('/fonts/manrope-600.woff2') format('woff2');
+}
+@font-face {
+  font-family: 'Manrope';
+  font-style: normal;
+  font-weight: 700;
+  font-display: swap;
+  src: url('/fonts/manrope-700.woff2') format('woff2');
+}
+@font-face {
+  font-family: 'Manrope';
+  font-style: normal;
+  font-weight: 800;
+  font-display: swap;
+  src: url('/fonts/manrope-800.woff2') format('woff2');
+}
+
+@font-face {
+  font-family: 'Geist Mono';
+  font-style: normal;
+  font-weight: 400;
+  font-display: swap;
+  src: url('/fonts/geist-mono-400.woff2') format('woff2');
+}
+@font-face {
+  font-family: 'Geist Mono';
+  font-style: normal;
+  font-weight: 500;
+  font-display: swap;
+  src: url('/fonts/geist-mono-500.woff2') format('woff2');
+}
+@font-face {
+  font-family: 'Geist Mono';
+  font-style: normal;
+  font-weight: 600;
+  font-display: swap;
+  src: url('/fonts/geist-mono-600.woff2') format('woff2');
+}
+@font-face {
+  font-family: 'Geist Mono';
+  font-style: normal;
+  font-weight: 700;
+  font-display: swap;
+  src: url('/fonts/geist-mono-700.woff2') format('woff2');
+}
+@font-face {
+  font-family: 'Geist Mono';
+  font-style: normal;
+  font-weight: 800;
+  font-display: swap;
+  src: url('/fonts/geist-mono-800.woff2') format('woff2');
+}
diff --git a/src/index.css b/src/index.css
new file mode 100644
index 0000000..1f67aaa
--- /dev/null
+++ b/src/index.css
@@ -0,0 +1,2265 @@
+@import './fonts.css';
+
+/* DayPay — Know what your work is worth.
+   Copyright © 2026 Akaninyene. All rights reserved.
+   Unauthorized copying, modification, or distribution is prohibited. */
+
+/* ============================================================
+   DayPay — PRECISION FUTURISM (visual redesign)
+   Pure UI/UX transformation. No logic, data, auth, routes,
+   calculations or behaviour changed. All original selectors kept.
+   ============================================================ */
+
+:root {
+  --daypay-navy: #0B1B32;
+  --daypay-green: #15803D;
+  --daypay-navy-light: #132a4a;
+  --daypay-green-light: #EAF6EF;
+  --daypay-green-dark: #15803d;
+
+  /* Precision Futurism — warm paper light theme */
+  --bg: #FFFFFF;
+  --bg-elevated: #FFFFFF;
+  --bg-elevated-2: #F7F8FA;
+  --bg-cell: #FFFFFF;
+  --bg-cell-hover: #F0F7F2;
+  --bg-worked: #FFFFFF;
+  --bg-sunken: #F7F8FA;
+  --border: #E2E5E9;
+  --border-strong: #C9CED6;
+  --border-light: #EEF0F3;
+  --text: var(--daypay-navy);
+  --text-2: #3D4A63;
+  /* v25 — secondary ink raised above WCAG AA. Both failed it before (2.58:1
+     and 2.74:1 against a 4.5:1 requirement) while being the colour of every
+     hint, caption and metadata line — 44 uses as text, at the smallest sizes
+     in the app, read outdoors. Ratios are re-measured by tests/design.test.js. */
+  --text-3: #54606F; /* 6.40:1 on white, 6.03:1 on sunken */
+  --text-4: #68727F; /* 4.88:1 on white, 4.59:1 on sunken */
+  --stamp-ok-bg: var(--daypay-navy);
+  --stamp-ok-text: #ffffff;
+  --stamp-2x-bg: var(--daypay-green);
+  --stamp-2x-text: #ffffff;
+  --stamp-ot-bg: #B45309;
+  --stamp-ot-text: #ffffff;
+  --accent: var(--daypay-navy);
+  --danger: #B91C1C;
+  --amber: #B45309;
+  --amber-wash: #FBF2E6;
+  --green-ink: #15803D;
+  --green-wash: #EAF6EF;
+  --shadow-sm: 0 1px 2px rgba(11,27,50,0.05);
+  --shadow-md: 0 6px 20px rgba(11,27,50,0.08);
+  --shadow-lg: 0 16px 44px rgba(11,27,50,0.14);
+  --radius: 12px;
+  --radius-lg: 16px;
+  --radius-xl: 20px;
+  /* v25 — design tokens · type scale, retuned for daylight and one hand.
+     Body is 15px (was 13), secondary 13px (was 11.5), micro 11px (was 10).
+     Nothing sits below 11px: this is read outdoors, on a phone, often in a
+     queue. Nothing sits above 46px except the splash. The ramp has eight
+     steps and every size in the app comes from one of them — a half-pixel
+     scale is not a scale, it is an accident. */
+  --fs-2xs: 11px;   /* micro labels, badges, captions, footer — the floor */
+  --fs-label: 12px; /* section labels (uppercase anchors) */
+  --fs-xs: 13px;    /* secondary text, hints, metadata, utility buttons */
+  --fs-sm: 15px;    /* primary body, rows, main-action buttons */
+  --fs-md: 16px;    /* inputs, emphasised body — 16px is also the size that
+                       stops iOS zooming the whole page on focus */
+  --fs-lg: 19px;    /* page & modal titles */
+  --fs-xl: 22px;    /* stat values */
+  --fs-2xl: 26px;   /* main headings, card hero values */
+  --fs-hero-sm: clamp(30px, 8.5vw, 36px); /* sub-hero (final-salary banner) */
+  --fs-hero: clamp(38px, 11vw, 46px); /* earnings hero */
+  --fs-display: 34px; /* splash/brand display only */
+
+  /* v25 — line-height by ROLE, so leading stops being set by hand */
+  --lh-tight: 1.15;  /* headings, big figures */
+  --lh-snug: 1.35;   /* compact rows, buttons, chips */
+  --lh-body: 1.5;    /* paragraphs, help text */
+
+  /* v25 — weight policy. Four roles, and nothing else:
+       400 prose · 500 body and rows · 600 values and names · 700 titles
+     · 800 reserved for the hero figure and the splash.
+     Before this, the stylesheets used 700/800 163 times against 69 mediums,
+     which is how a screen ends up shouting: when everything is bold, nothing
+     is emphasised, and small bold text is harder to read than regular. */
+  --fw-body: 500;
+  --fw-value: 600;
+  --fw-title: 700;
+  --fw-hero: 800;
+
+  /* v25 — one place that defines the two families and their fallbacks.
+     There were nine spellings of these across the stylesheets, most of them
+     falling back to a bare `monospace` or `sans-serif`. */
+  --font-sans: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
+  --font-mono: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+
+  /* v25 — every tappable thing clears this */
+  --tap: 44px;
+
+  /* v24 — tracking + 8pt spacing rhythm */
+  --ls-label: 0.06em; /* section-label tracking (micro labels use 0.08em) */
+  --sp-1: 4px; --sp-2: 8px; --sp-3: 12px; --sp-4: 16px; --sp-5: 24px; --sp-6: 32px;
+
+  /* ── v26 — THE TYPE + RHYTHM SYSTEM ───────────────────────────────────────
+     One place that says what a page title, a section heading, a row title and a
+     description ARE, and how far apart things sit. Before this the type was
+     right and the RHYTHM was improvised: `margin-top: 1px` on a <span> that was
+     still inline — so the margin did nothing and the description ran into its
+     own title ("ContractorsWho each worker answers to") — and stack gaps of 1px
+     and 2px in nine different containers.
+
+     Sizes are ALIASES of the existing ramp, not a second scale: one ramp, named
+     for the job it does, so no screen has to choose a number again. */
+
+  /* Type roles — the brief's table, and the only sizes a shared component uses. */
+  --fs-page: var(--fs-xl);     /* 22px — page titles        (brief 20–24) */
+  --fs-section: var(--fs-xs);  /* 13px — section headings   (brief 13–15) */
+  --fs-row: var(--fs-sm);      /* 15px — card & row titles  (brief 15–16) */
+  --fs-body: var(--fs-xs);     /* 13px — supporting text    (brief 13–14) */
+  --fs-nav: var(--fs-label);   /* 12px — navigation labels  (brief 12–14) */
+  --fs-meta: var(--fs-2xs);    /* 11px — small metadata     (brief 11–12) */
+  --lh-title: 1.25;            /* page titles — tighter than body, as headings are */
+  --lh-row: 1.4;               /* section headings, row titles, nav, metadata */
+
+  /* Rhythm — named by what it separates, so a gap cannot be chosen by taste.
+     4 / 8 / 12 / 16 / 20 / 24 / 32 is the whole scale; nothing else. */
+  --gap-stack: var(--sp-1);    /* title → its description (brief 4–6px) */
+  --gap-head: var(--sp-4h);    /* under a page header     (brief 16–20px) */
+  --gap-section: var(--sp-5);  /* between two sections    (brief 24–32px) */
+  --gap-page: var(--sp-4);     /* the one horizontal page padding (brief 16–20px) */
+  --pad-row-y: var(--sp-4);    /* a list row, vertical    (brief 14–16px) */
+  --pad-row-x: var(--sp-4);    /* a list row, horizontal  (brief 16–18px) */
+
+  /* ── Wide screens (Phase 15) ────────────────────────────────────────────────
+     Three numbers the desktop layout is built from, so the rail, the shell and
+     every pane cannot disagree about them. Nothing outside a `min-width` query
+     reads them: the phone layout is unaware they exist. */
+  --rail: 200px;          /* the side navigation, from 1024px up */
+  --content-max: 1080px;  /* the widest a column of content is ever allowed */
+  --header-h: calc(var(--tap) + var(--sp-3) * 2);
+  /* The header's real height, in the design system's own terms: the tallest thing
+     in the bar is the 44px menu button, inside 12px of padding. It is written as a
+     sum and not as 68px so it follows the tap floor and the spacing scale rather
+     than a number somebody measured once. The rail begins below it, and the sticky
+     column on Attendance clears it. */
+  --slip-navy: var(--daypay-navy);
+  --slip-paper: #FFFFFF;
+}
+
+[data-theme="dark"] {
+  --daypay-green: #16A34A; /* dark theme keeps its original green */
+  --bg: #080C16;
+  --bg-elevated: #0D1528;
+  --bg-elevated-2: #111B32;
+  --bg-cell: #0C1425;
+  --bg-cell-hover: #12203A;
+  --bg-worked: #0C1425;
+  --bg-sunken: #060A13;
+  --border: #1C2942;
+  --border-strong: #2B3C5C;
+  --border-light: #141F36;
+  --text: #EDF1F7;
+  --text-2: #A6B1C6;
+  --text-3: #8D9AB3; /* 6.41:1 on a card, 6.89:1 on the page */
+  --text-4: #75819A; /* 4.64:1 on a card, 4.99:1 on the page — was 2.74:1 */
+  --stamp-ok-bg: #f1f5f9;
+  --stamp-ok-text: var(--daypay-navy);
+  --stamp-2x-bg: var(--daypay-green);
+  --stamp-2x-text: #ffffff;
+  --stamp-ot-bg: #f59e0b;
+  --stamp-ot-text: #ffffff;
+  --accent: #f1f5f9;
+  --danger: #F87171;
+  --amber: #FBBF24;
+  --amber-wash: #221A08;
+  --green-ink: #4ADE80;
+  --green-wash: #0C1F14;
+  --shadow-sm: 0 1px 3px rgba(0,0,0,0.35);
+  --shadow-md: 0 6px 24px rgba(0,0,0,0.4);
+  --shadow-lg: 0 16px 48px rgba(0,0,0,0.5);
+  --slip-navy: #DCE4F2;
+  --slip-paper: #0C1425;
+}
+
+/* ---------- base ---------- */
+* { box-sizing: border-box; }
+html, body {
+  margin: 0; padding: 0;
+  background: var(--bg);
+  color: var(--text);
+  font-family: var(--font-sans);
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+  line-height: var(--lh-body);
+  min-height: 100%;
+  transition: background 0.25s, color 0.25s;
+}
+body { min-height: 100dvh; display: flex; justify-content: center; background: var(--bg); }
+#root { width: 100%; display: flex; justify-content: center; }
+::selection { background: var(--daypay-green-light); color: var(--daypay-navy); }
+[data-theme="dark"] ::selection { background: #14532D; color: #EDF1F7; }
+
+/* Manrope throughout — tabular numerals for instrument-grade numbers */
+.mono, .date-num, .summary-amount, .yt-amount, .yt-num, .fsb-amount,
+.mr-amount, .mr-days, .ab-amount, .yt-sub, .fsb-details, .field-input {
+  font-family: var(--font-sans);
+  font-variant-numeric: tabular-nums;
+  font-feature-settings: "tnum" 1;
+}
+
+button { font-family: var(--font-sans); }
+button:focus-visible, a:focus-visible, input:focus-visible {
+  outline: 2px solid var(--daypay-green);
+  outline-offset: 2px;
+  border-radius: 6px;
+}
+.cell:focus-visible { outline-offset: -2px; }
+
+.app-root { width: 100%; min-height: 100dvh; display: flex; justify-content: center; padding: 0; }
+.phone-frame {
+  width: 100%; max-width: 480px; min-height: 100dvh;
+  background: var(--bg);
+  border-left: 1px solid var(--border);
+  border-right: 1px solid var(--border);
+  display: flex; flex-direction: column; position: relative;
+}
+@media (min-width: 768px) {
+  .app-root { padding: 28px var(--sp-4) 40px; align-items: flex-start; }
+  .phone-frame {
+    min-height: auto; border: 1px solid var(--border);
+    border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-lg);
+  }
+}
+
+/* ── Desktop: the same app, laid out for a wide screen (Phase 15) ─────────────
+   Additive on purpose. Everything above is the phone layout that the screen
+   checks were built on, and at 1024px and up none of it is rewritten — the shell
+   simply stops being a 480px column inside a decorative border and becomes a
+   window: a sticky bar across the top, a navigation rail down the left, and the
+   content on a measured column beside it.
+
+   Before this the entire desktop experience was `max-width: 480px` centred on a
+   27-inch monitor with a 1px border around it (§27 of the brief). */
+@media (min-width: 1024px) {
+  .app-root { padding: 0; align-items: stretch; }
+
+  .phone-frame {
+    max-width: none; min-height: 100dvh;
+    border: 0; border-radius: 0; box-shadow: none;
+    /* The rail is `position: fixed` inside this box, and a clipping ancestor is
+       how a fixed child gets cut off at the bottom of a short screen. There are
+       no rounded corners here for the clip to protect, so the frame stops being
+       one and the rail is free to run the full height of the window. */
+    overflow: visible;
+  }
+
+  /* On a wide screen the header is a bar, not a strip inside a phone: the mark
+     sits at the very left, above where the rail begins. */
+  .header { padding-inline: var(--sp-5); }
+
+  /* Every frame that is NOT the employer's workspace keeps the phone-shaped column
+     it has always had: the personal tracker and the worker's own screens are
+     one-handed, personal screens, and a 480px column centred on a desk is a better
+     answer for them than 1600px of stretched phone. Only the workspace — the one
+     frame with a rail and a workforce in it — becomes a window.
+
+     `:has()` is the whole test, and it fails safe: a browser without it gives the
+     frame the wide shell, where the content is still capped by the measure below
+     rather than running the width of the monitor. */
+  .phone-frame:not(:has(.ew)) {
+    max-width: 480px;
+    border-left: 1px solid var(--border);
+    border-right: 1px solid var(--border);
+    border-top: 0; border-bottom: 0;
+    border-radius: 0; box-shadow: none;
+  }
+
+  /* The reading column for those screens, so a line of text is a line of text even
+     if the frame above is as wide as the window (the no-`:has()` case). */
+  .view-wrap > :not(.ew) { width: 100%; max-width: 720px; margin-inline: auto; }
+
+  /* Settings is the same frame class, and it stays a panel: a page you opened
+     over the app rather than a window of its own. Wider — six categories beside
+     each other need the room — and inset top and bottom so it reads as a layer.
+     Declared after the rule above, which it ties on specificity. */
+  .phone-frame.sp-page {
+    max-width: 820px;
+    top: var(--sp-5); bottom: var(--sp-5);
+    border: 1px solid var(--border); border-radius: var(--radius-xl);
+    overflow: hidden; box-shadow: var(--shadow-lg);
+  }
+
+  /* Six categories in one column of a 820px panel is a list of strangers. Two
+     columns, with the account card above them both. */
+  .sp-cats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-3); align-items: start; }
+  .sp-cats > .sp-prof-card { grid-column: 1 / -1; }
+  /* §39: a group label inside the two-column list spans the row it explains. */
+  .sp-cats > .sp-section-label { grid-column: 1 / -1; }
+}
+
+/* view-enter: v22 — the keyed .view-wrap in App.jsx runs viewIn on every
+   Month/Year switch (one source of truth; ux-motion no longer re-triggers it) */
+
+/* value-change emphasis for hero figures (class toggled by ux-motion.js) */
+.dp-bump { animation: dpBump 0.38s cubic-bezier(0.16,1,0.3,1); transform-origin: left center; }
+@keyframes dpBump {
+  0% { transform: scale(1); }
+  35% { transform: scale(1.035); }
+  100% { transform: scale(1); }
+}
+
+/* ============================================================
+   1. HEADER — lighter, premium, quiet
+   ============================================================ */
+.header {
+  display: flex; align-items: center; justify-content: space-between;
+  padding: var(--sp-3) var(--sp-4);
+  border-bottom: 1px solid var(--border-light);
+  position: sticky; top: 0; z-index: 10;
+  background: rgba(255,255,255,0.88);
+  backdrop-filter: blur(14px);
+  -webkit-backdrop-filter: blur(14px);
+}
+[data-theme="dark"] .header { background: rgba(8,12,22,0.88); }
+.header-left { display: flex; align-items: center; gap: var(--sp-2); min-width: 0; }
+/* brand lockup — refined stacked squares + wordmark */
+.hdr-lockup { display: flex; align-items: center; gap: var(--sp-2); min-width: 0; }
+.hdr-mark { display: block; flex: none; }
+.wordmark { font-size: var(--fs-lg); font-weight: 700; letter-spacing: -0.02em; line-height: 1; white-space: nowrap; }
+.wm-day { color: var(--text); }
+.wm-pay { color: var(--daypay-green); }
+
+/* sync state — typographic, not a pill */
+.sync-badge {
+  font-family: var(--font-sans); font-size: var(--fs-2xs); font-weight: 600;
+  letter-spacing: 0.01em;
+  padding: 0; margin-left: 2px; background: none; border: 0;
+  display: inline-flex; align-items: center; gap: var(--sp-2); white-space: nowrap;
+}
+.sync-badge::before {
+  content: ''; width: 6px; height: 6px; border-radius: 50%; flex: none;
+}
+.sync-badge.syncing { color: var(--text-3); }
+.sync-badge.syncing::before { background: var(--text-3); animation: syncPulse 1.1s ease-in-out infinite; }
+.sync-badge.synced { color: var(--green-ink); }
+.sync-badge.synced::before { background: var(--daypay-green); box-shadow: 0 0 0 3px var(--green-wash); }
+.sync-badge.error { color: var(--danger); }
+.sync-badge.error::before { background: var(--danger); box-shadow: 0 0 0 3px rgba(220,38,38,0.12); }
+@keyframes syncPulse { 0%,100% { opacity: 0.35; } 50% { opacity: 1; } }
+
+/* header buttons — quiet ghosts */
+/* v25 — every control clears 44px. A 38px target is a mis-tap waiting to
+   happen on a phone held in one hand, which is how this app is used. */
+.icon-btn {
+  width: var(--tap); height: var(--tap); border-radius: 10px;
+  border: 1px solid transparent; background: transparent;
+  color: var(--text-2); display: grid; place-items: center;
+  cursor: pointer; transition: background 0.18s, color 0.18s, border-color 0.18s, transform 0.12s;
+  box-shadow: none;
+}
+.icon-btn:hover { background: var(--bg-elevated); color: var(--text); border-color: var(--border); }
+.icon-btn.small { width: 32px; height: 32px; position: relative; }
+.icon-btn.small::after { content: ""; position: absolute; inset: -6px; }
+.icon-btn.settings-btn { background: transparent; border-color: transparent; color: var(--text-2); }
+.icon-btn.settings-btn:hover { background: var(--bg-elevated); color: var(--text); border-color: var(--border); }
+
+.theme-toggle {
+  /* 38px wide keeps the header's rhythm; the target is the full 44px, which is
+     what a thumb actually has to hit (Phase 17). */
+  width: 38px; min-height: var(--tap); border-radius: 10px; position: relative;
+  border: 1px solid transparent; background: transparent;
+  color: var(--text-2); display: grid; place-items: center;
+  cursor: pointer; transition: background 0.18s, color 0.18s, border-color 0.18s;
+}
+.theme-toggle:hover { background: var(--bg-elevated); color: var(--text); border-color: var(--border); }
+/* The drawn box stays 38px so the header keeps its rhythm; the tap area is 44.
+   A pseudo-element is part of the button, so every pixel of it presses the
+   button — the same trick `.icon-btn.small` uses (Phase 17). */
+.theme-toggle::after { content: ""; position: absolute; inset: -3px; }
+
+/* ---------- Month / Year switch ---------- */
+.seg-wrap { padding: var(--sp-4) var(--sp-4) 0; }
+.segmented {
+  display: flex; background: var(--bg-elevated);
+  border: 1px solid var(--border); border-radius: 12px;
+  padding: var(--sp-1); gap: var(--sp-1); box-shadow: none;
+}
+.segmented button {
+  flex: 1; min-height: var(--tap); border-radius: 9px; border: 0;
+  background: transparent; color: var(--text-3);
+  font-size: var(--fs-sm); font-weight: 500;
+  cursor: pointer; transition: all 0.18s;
+}
+.segmented button.active {
+  background: var(--daypay-navy); color: #ffffff; font-weight: 600;
+  box-shadow: 0 2px 8px rgba(11,27,50,0.2);
+  letter-spacing: 0.01em;
+}
+[data-theme="dark"] .segmented button.active { background: #EDF1F7; color: var(--daypay-navy); box-shadow: none; }
+.segmented button:hover:not(.active) { color: var(--text); background: var(--bg-elevated-2); }
+
+/* ---------- month nav ---------- */
+.month-nav { display: flex; align-items: center; justify-content: space-between; padding: var(--sp-4) var(--sp-4) var(--sp-3); }
+.nav-btn {
+  width: var(--tap); height: var(--tap); border-radius: 10px;
+  border: 1px solid transparent; background: transparent;
+  color: var(--text-3); display: grid; place-items: center;
+  cursor: pointer; transition: all 0.15s;
+}
+.nav-btn:hover:not(:disabled) { border-color: var(--border); color: var(--text); background: var(--bg-elevated); }
+.nav-btn:disabled { cursor: not-allowed; opacity: 0.3; }
+
+.month-title { display: flex; flex-direction: column; align-items: center; gap: var(--sp-1); }
+.month-name {
+  font-size: var(--fs-2xl); font-weight: 700;
+  letter-spacing: -0.03em; color: var(--text);
+}
+.year-name {
+  font-size: var(--fs-2xs); letter-spacing: 0.01em;
+  color: var(--text-3); font-weight: 600; display: flex; align-items: center; gap: var(--sp-2);
+}
+
+.status-dot { width: 6px; height: 6px; border-radius: 50%; display: inline-block; flex: none; }
+.status-dot.active { background: var(--daypay-green); box-shadow: 0 0 0 3px var(--green-wash); }
+.status-dot.locked { background: var(--text-3); }
+.status-dot.future { background: transparent; border: 1.5px solid var(--border-strong); width: 5px; height: 5px; }
+.status-dot.before_start { background: transparent; border: 1.5px solid var(--border); width: 5px; height: 5px; }
+
+/* ============================================================
+   2 + 4. MONTH CALENDAR + DAYPAY WORK MARKERS
+   One slip = one day. Two peeking slips = double pay.
+   ============================================================ */
+.weekdays { display: grid; grid-template-columns: repeat(7, 1fr); padding: 0 var(--sp-2); margin-bottom: var(--sp-2); }
+.weekdays div {
+  height: 26px; display: grid; place-items: center;
+  font-size: var(--fs-2xs); font-weight: 600;
+  letter-spacing: 0.01em; color: var(--text-3);
+}
+.weekdays .weekend-label { color: var(--text-4); }
+
+.calendar-grid {
+  display: grid; grid-template-columns: repeat(7, 1fr);
+  gap: 1px; background: var(--border-light);
+  border-top: 1px solid var(--border-light);
+  border-bottom: 1px solid var(--border-light);
+  padding: 1px 0;
+}
+.cell {
+  aspect-ratio: 0.92; background: var(--bg-cell); border: 0;
+  position: relative; display: flex; align-items: flex-start; justify-content: flex-start;
+  padding: var(--sp-2); cursor: pointer; transition: background 0.14s, transform 0.1s;
+  user-select: none; -webkit-tap-highlight-color: transparent;
+}
+.cell.empty { background: var(--bg); cursor: default; }
+.cell:hover:not(.empty):not(.locked-cell):not(:disabled) { background: var(--bg-cell-hover); }
+.cell.is-weekend { background: #F2F8F4; }
+[data-theme="dark"] .cell.is-weekend { background: #0B1220; }
+.cell.worked { background: var(--bg-cell) !important; }
+.cell.is-today { box-shadow: inset 0 0 0 1.5px var(--daypay-navy); }
+[data-theme="dark"] .cell.is-today { box-shadow: inset 0 0 0 1.5px #7C8AA5; }
+
+.date-num {
+  font-size: var(--fs-sm); font-weight: 500; color: var(--text-2);
+  line-height: 1; z-index: 1;
+}
+.cell.is-weekend .date-num { color: var(--text-4); font-weight: 500; }
+.cell.worked .date-num { color: var(--text); font-weight: 700; }
+.cell.is-weekend.worked .date-num { color: var(--green-ink); }
+
+/* overtime: restrained amber edge, not a full wash */
+.cell.is-overtime { background: var(--bg-cell) !important; box-shadow: inset 2.5px 0 0 var(--amber); }
+.cell.is-overtime.is-today { box-shadow: inset 2.5px 0 0 var(--amber), inset 0 0 0 1.5px var(--daypay-navy); }
+[data-theme="dark"] .cell.is-overtime.is-today { box-shadow: inset 2.5px 0 0 var(--amber), inset 0 0 0 1.5px #7C8AA5; }
+
+/* public holiday (unworked): faint wash + amber numeral */
+.cell.is-holiday { background: var(--amber-wash) !important; }
+.cell.is-holiday .date-num { color: var(--amber); font-weight: 700; }
+
+/* today / holiday micro dots — offset when both apply */
+.today-dot {
+  position: absolute; bottom: 7px; left: 50%; transform: translateX(-50%);
+  width: 5px; height: 5px; background: var(--daypay-navy); border-radius: 50%;
+}
+[data-theme="dark"] .today-dot { background: #DCE4F2; }
+.holiday-dot {
+  position: absolute; bottom: 7px; left: 50%; transform: translateX(-50%);
+  width: 5px; height: 5px; background: var(--amber); border-radius: 50%;
+}
+.cell.is-holiday .today-dot { left: calc(50% + 6px); }
+.cell.is-today .holiday-dot { left: calc(50% - 6px); }
+
+/* ----- the Peeking Slip markers ----- */
+.stamp {
+  position: absolute; bottom: 5px; left: 50%;
+  transform: translateX(-50%);
+  width: 28px; height: 19px;
+  font-size: 0; line-height: 0; /* text hidden visually, kept for AT */
+  padding: 0; border: 0; background: none; box-shadow: none;
+  pointer-events: none;
+  animation: slipSettle 0.28s cubic-bezier(0.16,1,0.3,1);
+}
+@keyframes slipSettle {
+  from { opacity: 0; transform: translateX(-50%) translateY(5px) scale(0.72); }
+  to { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
+}
+.stamp::before, .stamp::after {
+  content: ''; position: absolute; border-radius: 4px;
+}
+/* regular day — one navy slip (outline) */
+.stamp-ok::before {
+  width: 13px; height: 13px; left: 50%; top: 50%;
+  transform: translate(-50%,-50%);
+  border: 2px solid var(--slip-navy);
+  background: var(--slip-paper);
+}
+/* weekend 2× — the Peeking Slip: green slip behind, navy slip front */
+.stamp-2x::before {
+  width: 12px; height: 12px; left: calc(50% - 8.5px); top: 1px;
+  background: var(--daypay-green);
+  border: 2px solid var(--daypay-green);
+}
+.stamp-2x::after {
+  width: 12px; height: 12px; left: calc(50% - 3.5px); top: 6px;
+  background: var(--slip-paper);
+  border: 2px solid var(--slip-navy);
+}
+/* overtime — amber outline slip */
+.stamp-ot::before {
+  width: 13px; height: 13px; left: 50%; top: 50%;
+  transform: translate(-50%,-50%);
+  border: 2px solid var(--amber);
+  background: var(--slip-paper);
+}
+/* holiday worked — solid amber slip */
+.stamp-hol::before {
+  width: 13px; height: 13px; left: 50%; top: 50%;
+  transform: translate(-50%,-50%);
+  background: var(--amber);
+  border: 2px solid var(--amber);
+}
+
+/* locked month cells */
+.locked-grid { opacity: 1; }
+.cell.locked-cell { cursor: not-allowed !important; }
+.cell.locked-cell:not(.worked) { opacity: 0.5; background: var(--bg) !important; }
+.cell.locked-cell:not(.worked) .date-num { color: var(--text-4); }
+.cell.locked-cell.worked { background: var(--bg-elevated-2) !important; }
+.cell.locked-cell.worked .date-num { color: var(--text-3); }
+.locked-overlay { position: absolute; top: 5px; right: 5px; font-size: var(--fs-2xs); opacity: 0.45; color: var(--text-3); }
+
+/* edit affordance — quiet until needed */
+.edit-corner {
+  position: absolute; top: 4px; right: 4px; width: 20px; height: 20px; border-radius: 6px;
+  background: var(--bg-elevated); border: 1px solid var(--border); display: grid; place-items: center;
+  color: var(--text-3); cursor: pointer; box-shadow: var(--shadow-sm); z-index: 3;
+  transition: all 0.15s;
+}
+.edit-corner:hover { background: var(--daypay-navy); border-color: var(--daypay-navy); color: #ffffff; }
+[data-theme="dark"] .edit-corner:hover { background: #EDF1F7; border-color: #EDF1F7; color: var(--daypay-navy); }
+
+/* ============================================================
+   3 + 7. EARNINGS HERO + SEGMENTED PROGRESSION
+   ============================================================ */
+.summary-card {
+  margin: 0; background: transparent;
+  border: 0; border-radius: 0;
+  padding: var(--sp-4) var(--sp-4) 0; box-shadow: none;
+}
+/* the hero panel */
+.summary-top {
+  position: relative;
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  padding: var(--sp-5) var(--sp-5) var(--sp-4);
+  display: flex; flex-direction: column;
+  box-shadow: var(--shadow-sm);
+  overflow: hidden;
+}
+/* dynamic month label, mirrored from .month-name by ux-motion.js */
+.summary-top::before {
+  content: attr(data-month);
+  display: block;
+  font-size: var(--fs-2xs); font-weight: 600;
+  letter-spacing: 0.01em;
+  color: var(--text-3);
+  margin-bottom: var(--sp-2);
+}
+.summary-top[data-month]::before { content: attr(data-month) " earnings"; }
+/* decorative peeking-slip echo — pure motif, no data */
+.summary-top::after {
+  content: '';
+  position: absolute; top: 20px; right: 20px;
+  width: 13px; height: 13px; border-radius: 4px;
+  background: var(--bg-elevated);
+  border: 2.5px solid var(--daypay-navy);
+  box-shadow: 5px 5px 0 0 var(--daypay-green);
+  opacity: 0.9; pointer-events: none;
+}
+[data-theme="dark"] .summary-top::after { border-color: #DCE4F2; box-shadow: 5px 5px 0 0 var(--daypay-green); }
+
+.summary-amount {
+  font-size: var(--fs-hero); font-weight: 800;
+  letter-spacing: -0.035em; line-height: var(--lh-tight); color: var(--green-ink);
+  display: flex; align-items: baseline; gap: var(--sp-2); flex-wrap: wrap;
+}
+.summary-sub { margin-top: var(--sp-2); font-size: var(--fs-sm); color: var(--text-3); font-weight: 500; }
+.cloud-hint { font-size: var(--fs-xs); color: var(--green-ink); font-weight: 600; }
+
+/* Status, in one shape (Phase 16).
+   These were a quiet dot with ALL-CAPS micro-text here, a filled pill in the
+   employer's workspace and another pill in Settings — three answers to "what state
+   is this in". They carry the employer chip's own measurements now: the same 12px,
+   the same weight, the same wash. The dot stays, because it is the one part of the
+   old treatment that carried meaning the words do not — a pulsing dot for something
+   live, a still one for something settled — and it is never colour alone. */
+.final-badge, .active-badge, .mr-final, .mr-active {
+  font-family: var(--font-sans); font-size: var(--fs-label); font-weight: 600;
+  letter-spacing: 0.01em;
+  margin: 0;
+  padding: 2.5px var(--sp-2); border-radius: 999px;
+  background: var(--bg-sunken); color: var(--text-3);
+  display: inline-flex; align-items: center; gap: var(--sp-1); white-space: nowrap;
+}
+.final-badge::before, .mr-final::before {
+  content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; flex: none;
+}
+.active-badge::before, .mr-active::before {
+  content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex: none;
+  animation: syncPulse 1.6s ease-in-out infinite;
+}
+.final-badge, .mr-final { color: var(--text-3); }
+.active-badge, .mr-active { color: var(--daypay-green); background: var(--daypay-green-light); }
+.locked-hint { border-style: solid !important; background: var(--bg-elevated) !important; }
+
+/* goal — sunken well with segmented slip progression */
+.goal-progress {
+  margin-top: var(--sp-4);
+  padding: var(--sp-4);
+  background: var(--bg);
+  border: 1px solid var(--border-light);
+  border-radius: var(--radius);
+}
+[data-theme="dark"] .goal-progress { background: var(--bg-sunken); }
+.goal-header {
+  display: flex; justify-content: space-between; align-items: baseline;
+  font-size: var(--fs-sm); font-weight: 600;
+  color: var(--text-2); margin-bottom: var(--sp-2);
+}
+.progress-bar {
+  height: 10px; background: var(--bg-sunken);
+  border: 1px solid var(--border-light);
+  border-radius: 20px; overflow: hidden;
+}
+[data-theme="dark"] .progress-bar { background: #060A13; }
+.progress-fill {
+  height: 100%; border-radius: 20px;
+  /* segmented: each worked day reads as one slip-like segment */
+  -webkit-mask-image: repeating-linear-gradient(90deg, #000 0 7px, transparent 7px 10px);
+  mask-image: repeating-linear-gradient(90deg, #000 0 7px, transparent 7px 10px);
+  transition: width 0.6s cubic-bezier(0.16,1,0.3,1);
+}
+.goal-hint {
+  margin-top: var(--sp-2); font-size: var(--fs-xs); color: var(--text-3); font-weight: 500;
+}
+
+/* Dark-theme legibility for app-owned inline colors (states preserved):
+   the app sets navy vs green inline by goal state — remap each for contrast */
+[data-theme="dark"] .progress-fill:not([style*="daypay-green"]) { background: #93A3C4 !important; }
+[data-theme="dark"] .goal-header .mono:not([style*="daypay-green"]) { color: #DCE4F2 !important; }
+[data-theme="dark"] .goal-header .mono[style*="daypay-green"] { color: #4ADE80 !important; }
+[data-theme="dark"] .year-name span[style] {
+  background: #DCE4F2 !important; border-color: #DCE4F2 !important; color: #0B1B32 !important;
+}
+
+/* extra-value insight — flat wash, no gradient */
+.ot-insights {
+  margin-top: var(--sp-3); padding: var(--sp-4);
+  background: var(--green-wash);
+  border: 1px solid var(--border-light); border-radius: var(--radius);
+}
+.ot-insight-title {
+  font-size: var(--fs-2xs); font-weight: 600;
+  letter-spacing: 0.01em;
+  color: var(--green-ink); margin-bottom: var(--sp-2);
+  display: flex; align-items: center;
+}
+.ot-insight-text {
+  font-size: var(--fs-sm); line-height: var(--lh-body);
+  color: var(--text-2); font-weight: 500;
+}
+.ot-insight-text strong { color: var(--text); }
+
+.summary-divider { height: 1px; background: var(--border-light); margin: var(--sp-4) 2px var(--sp-1); }
+.summary-rows { display: flex; flex-direction: column; }
+.summary-row {
+  display: flex; justify-content: space-between; align-items: center;
+  font-size: var(--fs-sm); color: var(--text-2); font-weight: 500;
+  padding: var(--sp-3) 2px; border-bottom: 1px solid var(--border-light);
+}
+.summary-row:last-child { border-bottom: 0; }
+.summary-row em {
+  font-style: normal; font-size: var(--fs-2xs); padding: 1px var(--sp-2); border-radius: 5px;
+  background: var(--bg-elevated-2); border: 1px solid var(--border); margin-left: var(--sp-2);
+  color: var(--text-3); font-weight: 600;
+}
+.summary-row .mono { font-size: var(--fs-sm); font-weight: 600; color: var(--text); }
+
+/* mini markers in breakdown rows — micro slips with labels */
+.mini-stamp {
+  font-size: var(--fs-2xs); font-weight: 600; letter-spacing: 0.05em;
+  padding: 2px var(--sp-2); border-radius: 5px; margin-left: var(--sp-2);
+  display: inline-flex; align-items: center; gap: var(--sp-1);
+}
+.mini-stamp::before { content: ''; width: 7px; height: 7px; border-radius: 2px; flex: none; }
+.mini-stamp.ok { background: var(--bg-elevated-2); color: var(--text-2); border: 1px solid var(--border); }
+.mini-stamp.ok::before { border: 1.5px solid var(--slip-navy); background: transparent; width: 5px; height: 5px; }
+.mini-stamp.x2 { background: var(--green-wash); color: var(--green-ink); border: 1px solid transparent; }
+.mini-stamp.x2::before { background: var(--daypay-green); box-shadow: 2.5px 2.5px 0 -0.5px var(--slip-navy); margin-right: 2px; }
+.mini-stamp.ot { background: var(--amber-wash); color: var(--amber); border: 1px solid transparent; }
+.mini-stamp.ot::before { border: 1.5px solid var(--amber); background: transparent; width: 5px; height: 5px; }
+.mini-stamp.hol { background: var(--amber-wash); color: var(--amber); border: 1px solid transparent; }
+.mini-stamp.hol::before { background: var(--amber); }
+
+.empty-hint {
+  margin-top: var(--sp-3); padding: var(--sp-3); background: transparent;
+  border: 1px dashed var(--border-strong); border-radius: var(--radius);
+  font-size: var(--fs-xs); color: var(--text-3); text-align: center; font-weight: 500;
+}
+
+/* ============================================================
+   5. STATUS STRIP + FINAL SALARY
+   ============================================================ */
+.month-status-banner {
+  display: flex; align-items: center; justify-content: space-between; gap: var(--sp-2);
+  margin: 0 var(--sp-4); padding: var(--sp-2) 0;
+  background: transparent; border: 0;
+  border-bottom: 1px solid var(--border-light);
+  border-radius: 0;
+  font-size: var(--fs-xs);
+}
+.month-status-banner.active { background: transparent; border-color: var(--border-light); color: var(--text-2); }
+.month-status-banner.locked { background: transparent; color: var(--text-2); }
+.month-status-banner.future { background: transparent; color: var(--text-3); }
+.msb-left { display: flex; align-items: center; gap: var(--sp-2); min-width: 0; }
