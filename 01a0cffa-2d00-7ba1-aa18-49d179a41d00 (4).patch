+// ══ 5. Empty, and the way out of it ════════════════════════════════════════
+{
+  let went = false
+  const { host, close } = await open({ employees: [], onOpenPeople: () => { went = true } })
+  ok('an empty roster says so', textOf(host).includes('No one to record yet'), textOf(host).trim().slice(0, 70))
