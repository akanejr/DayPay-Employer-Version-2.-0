+    !!host.querySelector('.ks-result.ks-already') && !host.querySelector('.ks-result.ks-refused'))
+
+  /* ── 7. refusals, and never a blank pane ───────────────────────────────── */
+
+  const REFUSALS = [
+    'That PIN is not correct.',
