+                        <p className="ew-confirm-text">
+                          Move {e.full_name} off the roster? Their days and pay are kept.
+                        </p>
+                        <div className="ew-confirm-row">
+                          <button
+                            type="button" className="ew-btn ew-btn-danger ew-btn-sm"
+                            disabled={busyId === e.id}
