+.sp-switch.on { background: var(--daypay-green); border-color: var(--daypay-green); }
+.sp-switch.on .sp-switch-knob { transform: translate(17px, -50%); border-color: var(--daypay-green); }
+
+/* Reminder body (shown when the switch is on) */
+.sp-rem-body {
