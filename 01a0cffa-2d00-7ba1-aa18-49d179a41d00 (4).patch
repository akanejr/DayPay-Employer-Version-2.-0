+    assert.notEqual(start, -1, `no @media (${query}) block`)
+    const open = css.indexOf('{', start)
+    let depth = 0
+    for (let i = open; i < css.length; i += 1) {
+      if (css[i] === '{') depth += 1
+      else if (css[i] === '}') {
+        depth -= 1
+        if (depth === 0) return css.slice(open + 1, i)
+      }
+    }
+    assert.fail(`@media (${query}) is not closed`)
+  }
