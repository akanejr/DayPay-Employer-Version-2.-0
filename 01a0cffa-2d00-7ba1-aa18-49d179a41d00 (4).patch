+.month-status-banner.active .msb-icon { color: var(--daypay-green); }
+.msb-label { font-weight: 600; font-size: var(--fs-2xs); letter-spacing: 0.01em;}
+.month-status-banner.active .msb-label { color: var(--green-ink); }
+.month-status-banner.locked .msb-label { color: var(--text-2); }
+.month-status-banner.future .msb-label { color: var(--text-3); }
+.msb-desc { font-size: var(--fs-xs); opacity: 0.75; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.msb-action {
