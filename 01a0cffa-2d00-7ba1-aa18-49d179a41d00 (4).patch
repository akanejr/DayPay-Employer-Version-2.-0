+  DEVICES.unshift(row)
+  return { ...row }
+}
+
+export const revokeDevice = async (id) => {
+  globalThis.__calls.push(['revokeDevice', id])
+  const row = DEVICES.find(d => d.id === id)
+  if (row) {
+    row.status = 'revoked'; row.link_code = null
