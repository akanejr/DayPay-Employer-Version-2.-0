+  position: relative; overflow: hidden; box-shadow: var(--shadow-sm);
+}
+.final-salary-banner::before {
+  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
+  background: linear-gradient(90deg, var(--daypay-navy) 0%, var(--daypay-navy) 55%, var(--daypay-green) 55%, var(--daypay-green) 100%);
+}
+[data-theme="dark"] .final-salary-banner::before {
+  background: linear-gradient(90deg, #DCE4F2 0%, #DCE4F2 55%, var(--daypay-green) 55%, var(--daypay-green) 100%);
+}
+.fsb-label { font-size: var(--fs-2xs); letter-spacing: 0.01em; color: var(--text-3); font-weight: 600; margin-bottom: var(--sp-2);}
+.fsb-amount { font-size: var(--fs-hero-sm); font-weight: 800; letter-spacing: -0.03em; color: var(--green-ink); line-height: var(--lh-tight); }
+.fsb-details { margin-top: var(--sp-2); font-size: var(--fs-xs); color: var(--text-3); font-weight: 500; }
+
+.info-banner {
+  margin: var(--sp-4) var(--sp-4) 0; padding: var(--sp-3) var(--sp-4); background: transparent;
+  border: 1px dashed var(--border-strong); border-radius: var(--radius);
+  font-size: var(--fs-xs); color: var(--text-3); text-align: center; font-weight: 500; line-height: var(--lh-body);
+}
+
+/* ============================================================
+   6. YEAR VIEW — hero + earnings timeline
+   ============================================================ */
+.year-totals {
+  margin: 0; background: transparent;
+  border: 0; border-radius: 0; padding: var(--sp-4) var(--sp-4) 0; box-shadow: none;
+}
+.yt-main {
+  position: relative;
+  background: var(--bg-elevated);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  padding: var(--sp-5) var(--sp-5) var(--sp-4);
+  display: flex; flex-direction: column;
+  box-shadow: var(--shadow-sm);
+  overflow: hidden;
+}
+.yt-main::before {
+  content: attr(data-year);
+  display: block;
+  font-size: var(--fs-2xs); font-weight: 600;
+  letter-spacing: 0.01em;
+  color: var(--text-3);
+  margin-bottom: var(--sp-2);
+}
+.yt-main::after {
+  content: '';
+  position: absolute; top: 20px; right: 20px;
+  width: 13px; height: 13px; border-radius: 4px;
+  background: var(--bg-elevated);
+  border: 2.5px solid var(--daypay-navy);
+  box-shadow: 5px 5px 0 0 var(--daypay-green);
+  opacity: 0.9; pointer-events: none;
+}
+[data-theme="dark"] .yt-main::after { border-color: #DCE4F2; box-shadow: 5px 5px 0 0 var(--daypay-green); }
+.yt-amount {
+  font-size: var(--fs-hero); font-weight: 800;
+  letter-spacing: -0.035em; color: var(--green-ink); line-height: var(--lh-tight);
+}
+.yt-label { margin-top: var(--sp-2); font-size: var(--fs-xs); color: var(--text-3); font-weight: 500; line-height: var(--lh-body); }
+.yt-sub {
+  margin-top: var(--sp-2); font-size: var(--fs-xs); color: var(--text-2);
+  background: none; padding: 0; border: 0; border-radius: 0; display: block; font-weight: 500;
+}
+
+/* stat trio — hairline columns, no boxes */
+.yt-grid {
+  display: grid; grid-template-columns: repeat(2, 1fr);
+  border-top: 1px solid var(--border-light);
+  padding-top: var(--sp-4); margin-top: var(--sp-4);
+}
+.yt-item { background: none; padding: 0 var(--sp-2) 0 var(--sp-4); border: 0; border-radius: 0; }
+.yt-item:first-child { padding-left: 0; }
+.yt-item + .yt-item { border-left: 1px solid var(--border-light); }
+.yt-num { font-size: var(--fs-xl); font-weight: 700; color: var(--text); letter-spacing: -0.02em; }
+.yt-cap { margin-top: var(--sp-1); font-size: var(--fs-2xs); letter-spacing: 0.01em; color: var(--text-3); font-weight: 600;}
+/* v24.3 — yearly tiles keep the settled microcopy under each caption */
+.yt-sub2 { margin-top: var(--gap-stack); font-size: var(--fs-meta); color: var(--text-4); font-weight: var(--fw-body); line-height: var(--lh-row); }
+/* v24.3 — yearly breakdown values: amount over actual/equiv counts */
+.yb-vals { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; }
+.summary-row .yb-sub { font-size: var(--fs-2xs); color: var(--text-3); font-weight: 500; }
+.ab-total-mid { color: var(--text-3); font-size: var(--fs-xs); font-weight: 500; }
+
+/* annual breakdown — quiet ledger rows */
+.annual-breakdown { margin-top: var(--sp-4); border-top: 1px solid var(--border-light); padding-top: var(--sp-4); }
+.ab-title { font-size: var(--fs-2xs); letter-spacing: 0.01em; color: var(--text-3); font-weight: 600; margin-bottom: var(--sp-2);}
+.ab-row {
+  display: grid; grid-template-columns: 40px 1fr 96px 92px; gap: var(--sp-2); align-items: center;
+  padding: var(--sp-3) 2px; border-bottom: 1px solid var(--border-light); font-size: var(--fs-sm);
+}
+.ab-row:last-of-type { border-bottom: 0; }
+.ab-month { font-weight: 600; color: var(--text-2); font-size: var(--fs-sm); letter-spacing: 0.02em; }
+.ab-days { color: var(--text-3); font-size: var(--fs-xs); font-weight: 500; }
+.ab-status { color: var(--text-4); }
+.ab-status.locked { color: var(--text-3); }
+.ab-status.active { color: var(--daypay-green); }
+.ab-status.future, .ab-status.before_start { color: var(--text-4); }
+.ab-amount { color: var(--green-ink); font-weight: 600; font-size: var(--fs-sm); text-align: right; }
+.ab-row.future .ab-amount, .ab-row.before_start .ab-amount { color: var(--text-4); font-weight: 500; }
+.ab-total {
+  display: flex; justify-content: space-between; align-items: baseline;
+  padding: var(--sp-3) 2px 0; margin-top: var(--sp-1); border-top: 1px solid var(--border);
+  font-weight: 600; font-size: var(--fs-sm); color: var(--text);
+}
+.ab-total .mono { color: var(--green-ink); font-size: var(--fs-md); }
+
+/* months timeline */
+.months-list {
+  margin: var(--sp-4) var(--sp-4) 0; border: 0; border-radius: 0;
+  display: flex; flex-direction: column; background: transparent;
+  overflow: visible; position: relative;
+  padding-left: var(--sp-1);
+}
+/* the timeline rail */
+.months-list::before {
+  content: ''; position: absolute; left: 12px; top: 44px; bottom: 22px; width: 1.5px;
+  background: var(--border);
+  border-radius: 2px;
+}
+.ml-header {
+  padding: 0 0 var(--sp-2) var(--sp-6); font-size: var(--fs-xs); color: var(--text-3);
+  background: none; border: 0; font-weight: 500; line-height: var(--lh-body);
+}
+.month-row {
+  position: relative;
+  display: flex; align-items: center; justify-content: space-between; gap: var(--sp-2);
+  padding: var(--sp-3) var(--sp-2) var(--sp-3) var(--sp-6);
+  background: transparent; border: 0; border-radius: 10px;
+  cursor: pointer; transition: background 0.14s; text-align: left; width: 100%;
+}
+.month-row:hover { background: var(--bg-elevated); }
+/* timeline node — state as typography + dot */
+.month-row::before {
+  content: ''; position: absolute; left: 8.5px; top: 50%; transform: translateY(-50%);
+  width: 8px; height: 8px; border-radius: 50%;
+  background: var(--bg); border: 1.5px solid var(--border-strong);
+}
+.month-row.locked::before { background: var(--daypay-navy); border-color: var(--daypay-navy); }
+[data-theme="dark"] .month-row.locked::before { background: #DCE4F2; border-color: #DCE4F2; }
+.month-row.active::before {
+  background: var(--daypay-green); border-color: var(--daypay-green);
+  box-shadow: 0 0 0 3.5px var(--green-wash);
+}
+.month-row.future::before, .month-row.before_start::before { background: var(--bg); border-color: var(--border-strong); }
+.mr-left { display: flex; align-items: center; gap: var(--sp-2); min-width: 0; }
+.mr-name { font-size: var(--fs-md); font-weight: 600; color: var(--text); width: 38px; letter-spacing: 0.01em; }
+.month-row.future .mr-name, .month-row.before_start .mr-name { color: var(--text-3); font-weight: 700; }
+.mr-status { display: grid; place-items: center; }
+.mr-status.locked { color: var(--text-3); }
+.mr-status.active { color: var(--daypay-green); }
+.mr-status.future, .mr-status.before_start { color: var(--text-4); }
+.mr-days { font-size: var(--fs-xs); color: var(--text-3); font-weight: 500; }
+.mr-right { display: flex; align-items: center; gap: var(--sp-2); }
+.mr-amount { font-size: var(--fs-sm); color: var(--green-ink); font-weight: 600; letter-spacing: -0.01em; }
+.month-row.future .mr-amount, .month-row.before_start .mr-amount { color: var(--text-4); font-weight: 500; }
+.mr-arrow { color: var(--text-4); display: grid; place-items: center; }
+.month-row:hover .mr-arrow { color: var(--text-2); }
+
+/* ---------- footer ---------- */
+.footer {
+  margin-top: auto; padding: var(--sp-5) var(--sp-4); display: flex; align-items: center; justify-content: center; gap: var(--sp-2);
+  font-family: var(--font-sans); font-size: var(--fs-2xs); color: var(--text-4);
+  letter-spacing: 0.01em; font-weight: 500; flex-wrap: wrap; text-align: center;
+}
+.footer-dot { width: 3px; height: 3px; background: var(--text-4); border-radius: 50%; }
+
+/* ============================================================
+   MODALS / FORMS / MENUS
+   ============================================================ */
+.modal-overlay {
+  position: fixed; inset: 0; background: rgba(11,27,50,0.42); backdrop-filter: blur(8px);
+  -webkit-backdrop-filter: blur(8px);
+  display: flex; align-items: flex-end; justify-content: center; z-index: 1000; padding: 0;
+  animation: overlayIn 0.2s ease;
+}
+@keyframes overlayIn { from { opacity: 0; } to { opacity: 1; } }
+@media (min-width: 600px) { .modal-overlay { align-items: center; padding: var(--sp-5); } }
+.modal {
+  width: 100%; max-width: 420px; background: var(--bg-elevated);
+  border: 1px solid var(--border); border-radius: 18px 18px 0 0;
+  overflow: hidden; box-shadow: var(--shadow-lg); animation: slideUp 0.26s cubic-bezier(0.16,1,0.3,1);
+}
+@media (min-width: 600px) { .modal { border-radius: 18px; } }
+@keyframes slideUp { from { transform: translateY(16px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
+.modal-header {
+  display: flex; align-items: center; justify-content: space-between;
+  padding: var(--sp-5) var(--sp-4) var(--sp-4); border-bottom: 1px solid var(--border-light);
+  font-size: var(--fs-lg); font-weight: 600; color: var(--text); letter-spacing: -0.02em;
+}
+.modal-body { padding: var(--sp-4); }
+.field-label {
+  font-size: var(--fs-label);
+  letter-spacing: 0.01em; color: var(--text-3); font-weight: 600; display: block; margin-bottom: var(--sp-2);
+}
+.field-wrap {
+  display: flex; align-items: center; background: var(--bg);
+  border: 1px solid var(--border); border-radius: var(--radius); padding: 0 var(--sp-4); height: 48px; gap: var(--sp-2);
+  transition: border-color 0.15s, box-shadow 0.15s;
+}
+.field-wrap:focus-within { border-color: var(--daypay-navy); box-shadow: 0 0 0 3px rgba(11,27,50,0.09); }
+[data-theme="dark"] .field-wrap:focus-within { border-color: #7C8AA5; box-shadow: 0 0 0 3px rgba(124,138,165,0.15); }
+.field-prefix { color: var(--text-3); font-size: var(--fs-md); font-weight: 600; }
+.field-input {
+  flex: 1; background: transparent; border: 0; outline: 0;
+  color: var(--text); font-size: var(--fs-md); font-weight: 600; min-width: 0;
+}
+.field-hint { margin: var(--sp-2) 2px 0; font-size: var(--fs-xs); line-height: var(--lh-body); color: var(--text-3); font-weight: 500; }
+.info-box { margin-top: var(--sp-4); background: var(--bg); border: 1px solid var(--border-light); border-radius: var(--radius); padding: var(--sp-4); display: flex; flex-direction: column; gap: var(--sp-2); }
+.info-row { display: flex; justify-content: space-between; align-items: center; font-size: var(--fs-sm); color: var(--text-2); font-weight: 500; }
+.info-row.sub { color: var(--text-3); font-size: var(--fs-xs); }
+.modal-actions { display: flex; gap: var(--sp-3); margin-top: var(--sp-4); }
+.btn-secondary, .btn-primary {
+  flex: 1; height: 46px; border-radius: var(--radius); border: 1px solid var(--border);
+  font-size: var(--fs-sm); font-weight: 600; cursor: pointer; transition: all 0.15s;
+}
+.btn-secondary { background: var(--bg-elevated); color: var(--text-2); }
+.btn-secondary:hover { border-color: var(--border-strong); color: var(--text); }
+.btn-primary { background: var(--daypay-navy); color: #ffffff; border-color: var(--daypay-navy); }
+.btn-primary:hover { background: var(--daypay-navy-light); }
+[data-theme="dark"] .btn-primary { background: #EDF1F7; border-color: #EDF1F7; color: var(--daypay-navy); }
+[data-theme="dark"] .btn-primary:hover { background: #ffffff; }
+.storage-info { margin-top: var(--sp-4); text-align: center; font-size: var(--fs-xs); color: var(--text-4); line-height: var(--lh-body); font-weight: 500; }
+
+/* overtime picker options */
+.ot-option {
+  display: flex; align-items: center; justify-content: space-between; width: 100%;
+  padding: var(--sp-3) var(--sp-4); border-radius: var(--radius); border: 1px solid var(--border);
+  background: var(--bg-elevated); color: var(--text-2);
+  font-size: var(--fs-sm); font-weight: 500; cursor: pointer; text-align: left;
+  transition: all 0.14s;
+}
+.ot-option:hover { border-color: var(--border-strong); }
+.ot-option.selected { background: var(--daypay-navy); color: #ffffff; border-color: var(--daypay-navy); }
+[data-theme="dark"] .ot-option.selected { background: #EDF1F7; color: var(--daypay-navy); border-color: #EDF1F7; }
+.ot-option.danger { background: rgba(220,38,38,0.06); border-color: rgba(220,38,38,0.25); color: var(--danger); }
+.ot-opt-left { display: flex; align-items: center; gap: var(--sp-2); }
+.daypay-tagline { font-weight: 500; font-size: var(--fs-sm); color: var(--text-3); }
+.daypay-earning { color: var(--green-ink); font-weight: 800; }
+
+/* ---------- banners / auth / cloud ---------- */
+.config-banner, .error-banner {
+  display: flex; align-items: center; justify-content: space-between;
+  padding: var(--sp-3) var(--sp-4); font-size: var(--fs-xs); font-weight: 500; gap: var(--sp-2);
+}
+.config-banner { background: #FDF6E3; border-bottom: 1px solid #F0E2B8; color: #92600A; }
+[data-theme="dark"] .config-banner { background: #1D1607; border-color: #3A2E10; color: #FBBF24; }
+.error-banner { background: #FDECEC; border-bottom: 1px solid #F5C6C6; color: #991b1b; }
+[data-theme="dark"] .error-banner { background: #220F0F; border-color: #4A1A1A; color: #F87171; }
+.error-banner button { background: transparent; border: 0; color: inherit; font-size: var(--fs-md); cursor: pointer; }
+.btn-cloud {
+  min-height: var(--tap); padding: 0 var(--sp-4); border-radius: 9px; border: 1px solid var(--daypay-navy);
+  background: var(--daypay-navy); color: #ffffff;
+  font-size: var(--fs-xs); font-weight: 600; cursor: pointer; transition: all 0.15s;
+}
+.btn-cloud:hover { background: var(--daypay-navy-light); }
+[data-theme="dark"] .btn-cloud { background: #EDF1F7; border-color: #EDF1F7; color: var(--daypay-navy); }
+.user-chip {
+  display: flex; align-items: center; gap: var(--sp-2); min-height: var(--tap); padding: 0 var(--sp-3);
+  background: transparent; border: 1px solid var(--border); border-radius: 9px; max-width: 132px;
+}
+.user-dot { width: 6px; height: 6px; background: var(--daypay-green); border-radius: 50%; flex: none; }
+.user-email { font-size: var(--fs-xs); font-weight: 500; color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.auth-error {
