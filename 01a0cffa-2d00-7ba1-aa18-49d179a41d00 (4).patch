+.sp-export-btn.ghost:hover { background: var(--bg-cell-hover); color: var(--text); }
+.sp-export .sp-hint { margin: 0; }
+
+/* ===== v19-A: quiet workdays — SR-only announcement (no visual footprint) ===== */
+.sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
+
+/* ===== v19-B: first-of-month recap — card is tappable (dismiss early) ===== */
+.dp-toast { cursor: pointer; }
+
+/* ===== v19-C: backup nudge — one quiet green banner in the card zone ===== */
+.dp-backup-nudge { position: fixed; top: calc(64px + env(safe-area-inset-top, 0px)); left: 50%; transform: translateX(-50%); width: min(calc(100vw - 24px), 456px); display: flex; align-items: center; gap: var(--sp-2); padding: var(--sp-3) var(--sp-4); border-radius: 15px; background: var(--green-wash); border: 1px solid var(--border); box-shadow: var(--shadow-sm); z-index: 9400; cursor: pointer; animation: dpNudgeLife 5500ms cubic-bezier(0.16,1,0.3,1) forwards; }
+.dp-nudge-dot { width: 8px; height: 8px; border-radius: 999px; background: var(--green-ink); flex: none; box-shadow: 0 0 0 3px rgba(74,222,128,.18); }
+.dp-nudge-text { font-family: var(--font-sans); font-size: var(--fs-xs); line-height: var(--lh-snug); color: var(--text-2); flex: 1; min-width: 0; margin: 0; }
+.dp-nudge-text b { color: var(--text); font-weight: 700; }
+.dp-nudge-btn { border: 0; border-radius: 9px; padding: var(--sp-2) var(--sp-3); font-family: var(--font-sans); font-weight: 600; font-size: var(--fs-xs); background: var(--green-ink); color: var(--bg); cursor: pointer; flex: none; }
+@keyframes dpNudgeLife {
+  0%   { opacity: 0; transform: translateX(-50%) translateY(-10px); }
+  8%   { opacity: 1; transform: translateX(-50%) translateY(0); }
+  90%  { opacity: 1; transform: translateX(-50%) translateY(0); }
+  100% { opacity: 0; transform: translateX(-50%) translateY(-8px); }
+}
+@media (prefers-reduced-motion: reduce) { .dp-backup-nudge { animation: none; } }
+[data-glass="on"] .dp-backup-nudge { -webkit-backdrop-filter: blur(20px) saturate(160%); backdrop-filter: blur(20px) saturate(160%); border: 1px solid rgba(255,255,255,.16); }
+[data-glass="on"][data-theme="dark"] .dp-backup-nudge { background: rgba(12,31,20,.5); }
+[data-glass="on"][data-theme="light"] .dp-backup-nudge { background: rgba(234,246,239,.6); }
+
+/* ===== v20: payday line — one quiet line under the hero ===== */
+.payday-line { display: block; background: none; border: 0; padding: 0; margin: var(--sp-2) 0 0; font-family: var(--font-sans); font-size: var(--fs-xs); line-height: var(--lh-snug); color: var(--text-3); text-align: left; cursor: pointer; }
+.payday-line b { color: var(--text); font-weight: 700; letter-spacing: -0.01em; }
+
+/* ===== v21: the press — one tactile response for everything clickable =====
+   Yield to 0.96 under the finger (cells 0.97, gentler), spring back with a
+   hint of overshoot. :not(#dp-press-skip) never matches an element — it lifts
+   specificity so this single transition + response wins over per-class rules.
+   One rule, everywhere — that consistency is the feel. */
+button { -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
+button:not(#dp-press-skip) {
+  transition: transform 220ms cubic-bezier(0.34,1.56,0.64,1), background 0.18s ease, color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, filter 0.13s ease, opacity 0.15s ease;
+}
+@media (hover: hover) and (pointer: fine) {
+  button:not(#dp-press-skip):hover:not(:disabled) { transform: translateY(-1px); }
+}
+button:not(#dp-press-skip):active:not(:disabled) { transform: scale(0.96); }
+.cell:not(#dp-press-skip):active:not(.empty):not(.locked-cell):not(:disabled) { transform: scale(0.97); }
+@media (prefers-reduced-motion: reduce) {
+  button:not(#dp-press-skip):active:not(:disabled), .cell:not(#dp-press-skip):active:not(.empty):not(.locked-cell):not(:disabled) { transform: none; opacity: 0.75; }
+  button:not(#dp-press-skip):hover:not(:disabled) { transform: none; }
+}
+
+/* ===== v22: panels that move — one motion language =====
+   Soft rise for views (keyed .view-wrap), cascade for menus,
+   full-page slide for Settings, reverse-out for everything.
+   ~300ms, one deceleration curve: cubic-bezier(0.22,1,0.36,1).
+   Closing elements get pointer-events:none so a dying menu can
+   never swallow the next tap. */
+
+/* 1 · Month/Year view switch — soft rise */
+.view-wrap { animation: viewIn 300ms cubic-bezier(0.22,1,0.36,1); }
+@keyframes viewIn {
+  from { opacity: 0; transform: translateY(14px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+/* 2 · Menus — cascade: container drops in fast, items ripple after */
+.dd-in { animation: ddIn 200ms ease; }
+.dd-out { animation: ddOut 220ms ease forwards; pointer-events: none; }
+@keyframes ddIn {
+  from { opacity: 0; transform: translateY(-8px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+@keyframes ddOut {
+  from { opacity: 1; transform: translateY(0); }
+  to { opacity: 0; transform: translateY(-8px); }
+}
+.dd-in .hamburger-user,
+.dd-in .hamburger-item {
+  animation: ddItemIn 340ms cubic-bezier(0.22,1,0.36,1) both;
+  animation-delay: calc(var(--i, 0) * 40ms);
+}
+.dd-in .share-option {
+  animation: ddItemIn 340ms cubic-bezier(0.22,1,0.36,1) both;
+  animation-delay: calc(var(--i, 0) * 40ms);
+}
+@keyframes ddItemIn {
+  from { opacity: 0; transform: translateY(-7px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+/* 3 · Modals — reverse out the way they came */
+.modal-overlay.mo-out { animation: overlayOut 200ms ease forwards; pointer-events: none; }
+@keyframes overlayOut { from { opacity: 1; } to { opacity: 0; } }
+.modal.m-out { animation: slideDown 260ms cubic-bezier(0.22,1,0.36,1) forwards; }
+@keyframes slideDown {
+  from { transform: translateY(0); opacity: 1; }
+  to { transform: translateY(16px); opacity: 0; }
+}
+
+/* 4 · Settings — full page slides back out */
+.sp-page.sp-out { animation: spFullOut 380ms cubic-bezier(0.22,1,0.36,1) forwards; pointer-events: none; }
+@keyframes spFullOut {
+  from { transform: translateX(0); }
+  to { transform: translateX(102%); }
+}
+
+/* 5 · Future chips block — enters with the same soft rise */
+.future-chips-block { animation: viewIn 260ms cubic-bezier(0.22,1,0.36,1); }
+
+/* reduced motion — views crossfade, nothing moves */
+@media (prefers-reduced-motion: reduce) {
+  .view-wrap { animation: dpViewRM 200ms ease; }
+  @keyframes dpViewRM { from { opacity: 0; } to { opacity: 1; } }
+  .theme-picker { transition: none; }
+}
