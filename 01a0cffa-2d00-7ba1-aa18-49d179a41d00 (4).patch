+      />
+    )
+  }
+
+  return (
+    <>
+        <div className="ew-head">
+          <div className="ew-head-text">
+            {/* "People", not "Staff" — and not "Roster" either: the tab that
+                opens this screen says People (§10), and a screen whose heading
